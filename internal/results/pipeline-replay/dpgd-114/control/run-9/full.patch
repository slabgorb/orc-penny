@@ -0,0 +1,242 @@
+//! Plugin manifest and kind types.
+
+use std::fmt;
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::PluginError;
+use crate::identity::PluginId;
+
+/// The six supported plugin kinds.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+#[non_exhaustive]
+pub enum PluginKind {
+    Connector,
+    Parser,
+    Enricher,
+    Dissector,
+    NotificationChannel,
+    ResponseAction,
+}
+
+impl fmt::Display for PluginKind {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Connector => write!(f, "connector"),
+            Self::Parser => write!(f, "parser"),
+            Self::Enricher => write!(f, "enricher"),
+            Self::Dissector => write!(f, "dissector"),
+            Self::NotificationChannel => write!(f, "notification_channel"),
+            Self::ResponseAction => write!(f, "response_action"),
+        }
+    }
+}
+
+/// Declarative plugin manifest with metadata, config schema, and permissions.
+///
+/// Fields are private to enforce invariants. Use getters or the builder.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PluginManifest {
+    schema_version: String,
+    id: PluginId,
+    name: String,
+    version: String,
+    description: String,
+    plugin_kind: PluginKind,
+    category: String,
+    #[serde(default)]
+    config_schema: serde_json::Value,
+    #[serde(default)]
+    permissions: Vec<String>,
+    #[serde(default)]
+    tags: Vec<String>,
+    #[serde(default)]
+    ocsf_classes: Vec<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    ocsf_version: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    signature: Option<String>,
+}
+
+impl PluginManifest {
+    /// Create a minimal manifest (for testing). Sets config_schema to null
+    /// so `validate_config` accepts any config.
+    pub fn new(id: PluginId, name: impl Into<String>, kind: PluginKind) -> Self {
+        Self {
+            schema_version: "1.0".into(),
+            id,
+            name: name.into(),
+            version: "0.1.0".into(),
+            description: String::new(),
+            plugin_kind: kind,
+            category: String::new(),
+            config_schema: serde_json::Value::Null,
+            permissions: Vec::new(),
+            tags: Vec::new(),
+            ocsf_classes: Vec::new(),
+            ocsf_version: None,
+            signature: None,
+        }
+    }
+
+    /// Create a builder for constructing manifests with all fields.
+    pub fn builder() -> PluginManifestBuilder {
+        PluginManifestBuilder::default()
+    }
+
+    /// Validate a configuration value against this manifest's config_schema.
+    /// Returns Ok(()) if config_schema is null (accepts anything).
+    pub fn validate_config(&self, config: &serde_json::Value) -> Result<(), PluginError> {
+        if self.config_schema.is_null() {
+            return Ok(());
+        }
+        let validator = jsonschema::validator_for(&self.config_schema)
+            .map_err(|e| PluginError::ConfigInvalid(format!("invalid config schema: {e}")))?;
+        validator
+            .validate(config)
+            .map_err(|e| PluginError::ConfigInvalid(e.to_string()))
+    }
+
+    // --- Getters ---
+
+    pub fn schema_version(&self) -> &str {
+        &self.schema_version
+    }
+
+    pub fn id(&self) -> &PluginId {
+        &self.id
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn version(&self) -> &str {
+        &self.version
+    }
+
+    pub fn description(&self) -> &str {
+        &self.description
+    }
+
+    pub fn plugin_kind(&self) -> &PluginKind {
+        &self.plugin_kind
+    }
+
+    pub fn category(&self) -> &str {
+        &self.category
+    }
+
+    pub fn config_schema(&self) -> &serde_json::Value {
+        &self.config_schema
+    }
+
+    pub fn permissions(&self) -> &[String] {
+        &self.permissions
+    }
+
+    pub fn tags(&self) -> &[String] {
+        &self.tags
+    }
+
+    pub fn ocsf_classes(&self) -> &[String] {
+        &self.ocsf_classes
+    }
+
+    pub fn ocsf_version(&self) -> Option<&str> {
+        self.ocsf_version.as_deref()
+    }
+
+    pub fn signature(&self) -> Option<&str> {
+        self.signature.as_deref()
+    }
+}
+
+/// Builder for PluginManifest.
+#[derive(Default)]
+pub struct PluginManifestBuilder {
+    schema_version: Option<String>,
+    id: Option<PluginId>,
+    name: Option<String>,
+    version: Option<String>,
+    description: Option<String>,
+    plugin_kind: Option<PluginKind>,
+    category: Option<String>,
+    config_schema: Option<serde_json::Value>,
+    permissions: Option<Vec<String>>,
+    tags: Option<Vec<String>>,
+    ocsf_classes: Option<Vec<String>>,
+    ocsf_version: Option<String>,
+    signature: Option<String>,
+}
+
+impl PluginManifestBuilder {
+    pub fn schema_version(mut self, v: impl Into<String>) -> Self {
+        self.schema_version = Some(v.into());
+        self
+    }
+
+    pub fn id(mut self, id: PluginId) -> Self {
+        self.id = Some(id);
+        self
+    }
+
+    pub fn name(mut self, n: impl Into<String>) -> Self {
+        self.name = Some(n.into());
+        self
+    }
+
+    pub fn version(mut self, v: impl Into<String>) -> Self {
+        self.version = Some(v.into());
+        self
+    }
+
+    pub fn description(mut self, d: impl Into<String>) -> Self {
+        self.description = Some(d.into());
+        self
+    }
+
+    pub fn plugin_kind(mut self, k: PluginKind) -> Self {
+        self.plugin_kind = Some(k);
+        self
+    }
+
+    pub fn category(mut self, c: impl Into<String>) -> Self {
+        self.category = Some(c.into());
+        self
+    }
+
+    pub fn config_schema(mut self, s: serde_json::Value) -> Self {
+        self.config_schema = Some(s);
+        self
+    }
+
+    pub fn permissions(mut self, p: Vec<String>) -> Self {
+        self.permissions = Some(p);
+        self
+    }
+
+    pub fn tags(mut self, t: Vec<String>) -> Self {
+        self.tags = Some(t);
+        self
+    }
+
+    pub fn build(self) -> PluginManifest {
+        PluginManifest {
+            schema_version: self.schema_version.unwrap_or_else(|| "1.0".into()),
+            id: self.id.expect("PluginManifest requires an id"),
+            name: self.name.unwrap_or_default(),
+            version: self.version.unwrap_or_else(|| "0.1.0".into()),
+            description: self.description.unwrap_or_default(),
+            plugin_kind: self.plugin_kind.expect("PluginManifest requires a plugin_kind"),
+            category: self.category.unwrap_or_default(),
+            config_schema: self.config_schema.unwrap_or(serde_json::Value::Null),
+            permissions: self.permissions.unwrap_or_default(),
+            tags: self.tags.unwrap_or_default(),
+            ocsf_classes: self.ocsf_classes.unwrap_or_default(),
+            ocsf_version: self.ocsf_version,
+            signature: self.signature,
+        }
+    }
+}
