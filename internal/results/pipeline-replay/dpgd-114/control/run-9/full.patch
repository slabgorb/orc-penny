+//! Tests for PluginKind enum (AC-5).
+//!
+//! PluginKind has 6 variants with serde snake_case and Display.
+
+use axiathon_plugin_sdk_core::PluginKind;
+
+// ============================================================
+// AC-5: PluginKind with 6 variants
+// ============================================================
+
+#[test]
+fn plugin_kind_has_connector_variant() {
+    let _ = PluginKind::Connector;
+}
+
+#[test]
+fn plugin_kind_has_parser_variant() {
+    let _ = PluginKind::Parser;
+}
+
+#[test]
+fn plugin_kind_has_enricher_variant() {
+    let _ = PluginKind::Enricher;
+}
+
+#[test]
+fn plugin_kind_has_dissector_variant() {
+    let _ = PluginKind::Dissector;
+}
+
+#[test]
+fn plugin_kind_has_notification_channel_variant() {
+    let _ = PluginKind::NotificationChannel;
+}
+
+#[test]
+fn plugin_kind_has_response_action_variant() {
+    let _ = PluginKind::ResponseAction;
+}
+
+// --- Display as lowercase snake_case ---
+
+#[test]
+fn plugin_kind_display_connector() {
+    assert_eq!(PluginKind::Connector.to_string(), "connector");
+}
+
+#[test]
+fn plugin_kind_display_parser() {
+    assert_eq!(PluginKind::Parser.to_string(), "parser");
+}
+
+#[test]
+fn plugin_kind_display_enricher() {
+    assert_eq!(PluginKind::Enricher.to_string(), "enricher");
+}
+
+#[test]
+fn plugin_kind_display_dissector() {
+    assert_eq!(PluginKind::Dissector.to_string(), "dissector");
+}
+
+#[test]
+fn plugin_kind_display_notification_channel() {
+    assert_eq!(
+        PluginKind::NotificationChannel.to_string(),
+        "notification_channel"
+    );
+}
+
+#[test]
+fn plugin_kind_display_response_action() {
+    assert_eq!(PluginKind::ResponseAction.to_string(), "response_action");
+}
+
+// --- Serde snake_case ---
+
+#[test]
+fn plugin_kind_serde_connector() {
+    let json = serde_json::to_string(&PluginKind::Connector).unwrap();
+    assert_eq!(json, "\"connector\"");
+    let back: PluginKind = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, PluginKind::Connector);
+}
+
+#[test]
+fn plugin_kind_serde_notification_channel() {
+    let json = serde_json::to_string(&PluginKind::NotificationChannel).unwrap();
+    assert_eq!(json, "\"notification_channel\"");
+    let back: PluginKind = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, PluginKind::NotificationChannel);
+}
+
+#[test]
+fn plugin_kind_serde_response_action() {
+    let json = serde_json::to_string(&PluginKind::ResponseAction).unwrap();
+    assert_eq!(json, "\"response_action\"");
+    let back: PluginKind = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, PluginKind::ResponseAction);
+}
+
+#[test]
+fn plugin_kind_serde_all_variants_roundtrip() {
+    let variants = [
+        PluginKind::Connector,
+        PluginKind::Parser,
+        PluginKind::Enricher,
+        PluginKind::Dissector,
+        PluginKind::NotificationChannel,
+        PluginKind::ResponseAction,
+    ];
+    for kind in variants {
+        let json = serde_json::to_string(&kind).unwrap();
+        let back: PluginKind = serde_json::from_str(&json).unwrap();
+        assert_eq!(kind, back, "Roundtrip failed for {kind:?}");
+    }
+}
+
+#[test]
+fn plugin_kind_serde_rejects_unknown_variant() {
+    let result = serde_json::from_str::<PluginKind>("\"unknown_kind\"");
+    assert!(result.is_err(), "Unknown variant should be rejected");
+}
+
+// --- Rule #2: #[non_exhaustive] on public enums ---
+
+#[test]
+fn plugin_kind_is_non_exhaustive() {
+    // If PluginKind is #[non_exhaustive], a match without wildcard
+    // will not compile from outside the crate. We verify by ensuring
+    // we can match with a wildcard arm (this test's existence documents
+    // the requirement — the real enforcement is compile-time).
+    let kind = PluginKind::Connector;
+    let _name = match kind {
+        PluginKind::Connector => "connector",
+        PluginKind::Parser => "parser",
+        PluginKind::Enricher => "enricher",
+        PluginKind::Dissector => "dissector",
+        PluginKind::NotificationChannel => "notification_channel",
+        PluginKind::ResponseAction => "response_action",
+        _ => "unknown", // This arm is required if #[non_exhaustive]
+    };
+    assert_eq!(_name, "connector");
+}
+
+// --- Derive traits ---
+
+#[test]
+fn plugin_kind_debug_clone_copy_eq_hash() {
+    let k1 = PluginKind::Parser;
+    let k2 = k1; // Copy
+    let k3 = k2;
+    assert_eq!(k1, k2);
+    assert_eq!(k2, k3);
+    let debug = format!("{k1:?}");
+    assert!(debug.contains("Parser"), "Debug should contain variant name, got: {debug}");
+    let mut set = std::collections::HashSet::new();
+    set.insert(k1);
+    assert!(set.contains(&k2));
+}
