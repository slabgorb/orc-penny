@@ -0,0 +1,223 @@
+//! Tests for PluginManifest (AC-3).
+//!
+//! PluginManifest has 14 fields, JSON round-trip, and validate_config().
+
+use axiathon_plugin_sdk_core::{PluginId, PluginKind, PluginManifest};
+
+// ============================================================
+// AC-3: PluginManifest with 14 fields
+// ============================================================
+
+#[test]
+fn plugin_manifest_has_schema_version() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.schema_version(), "1.0");
+}
+
+#[test]
+fn plugin_manifest_has_id() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.id().to_string(), "builtin:syslog-tcp");
+}
+
+#[test]
+fn plugin_manifest_has_name() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.name(), "Syslog TCP Connector");
+}
+
+#[test]
+fn plugin_manifest_has_version() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.version(), "0.1.0");
+}
+
+#[test]
+fn plugin_manifest_has_description() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.description(), "Receives syslog over TCP");
+}
+
+#[test]
+fn plugin_manifest_has_plugin_kind() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.plugin_kind(), &PluginKind::Connector);
+}
+
+#[test]
+fn plugin_manifest_has_category() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.category(), "network");
+}
+
+#[test]
+fn plugin_manifest_has_config_schema() {
+    let manifest = test_manifest();
+    let schema = manifest.config_schema();
+    assert!(schema.is_object(), "config_schema should be a JSON object");
+    assert!(schema["properties"]["port"].is_object());
+}
+
+#[test]
+fn plugin_manifest_has_permissions() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.permissions(), &["network:listen"]);
+}
+
+#[test]
+fn plugin_manifest_has_tags() {
+    let manifest = test_manifest();
+    assert_eq!(manifest.tags(), &["syslog", "network"]);
+}
+
+#[test]
+fn plugin_manifest_has_ocsf_classes() {
+    let manifest = test_manifest();
+    // ocsf_classes defaults to empty in test_manifest (not set)
+    assert!(manifest.ocsf_classes().is_empty());
+}
+
+#[test]
+fn plugin_manifest_has_ocsf_version() {
+    let manifest = test_manifest();
+    // ocsf_version defaults to None in test_manifest (not set)
+    assert!(manifest.ocsf_version().is_none());
+}
+
+#[test]
+fn plugin_manifest_has_signature() {
+    let manifest = test_manifest();
+    // signature defaults to None in test_manifest (not set)
+    assert!(manifest.signature().is_none());
+}
+
+// --- JSON round-trip ---
+
+#[test]
+fn plugin_manifest_json_roundtrip() {
+    let manifest = test_manifest();
+    let json = serde_json::to_string(&manifest).unwrap();
+    let deserialized: PluginManifest = serde_json::from_str(&json).unwrap();
+    assert_eq!(deserialized.id().to_string(), "builtin:syslog-tcp");
+    assert_eq!(deserialized.name(), "Syslog TCP Connector");
+    assert_eq!(deserialized.plugin_kind(), &PluginKind::Connector);
+    assert_eq!(deserialized.permissions().len(), 1);
+    assert_eq!(deserialized.tags().len(), 2);
+}
+
+#[test]
+fn plugin_manifest_json_preserves_config_schema_extensions() {
+    let manifest = test_manifest();
+    let json = serde_json::to_string(&manifest).unwrap();
+    let deserialized: PluginManifest = serde_json::from_str(&json).unwrap();
+    assert_eq!(
+        deserialized.config_schema()["properties"]["port"]["x-ui-widget"],
+        "number"
+    );
+    assert_eq!(
+        deserialized.config_schema()["properties"]["port"]["x-ui-order"],
+        1
+    );
+}
+
+// --- validate_config() ---
+
+#[test]
+fn plugin_manifest_validate_config_accepts_valid() {
+    let manifest = test_manifest();
+    let config = serde_json::json!({"port": 1514});
+    let result = manifest.validate_config(&config);
+    assert!(result.is_ok(), "Valid config should pass validation");
+}
+
+#[test]
+fn plugin_manifest_validate_config_rejects_invalid_type() {
+    let manifest = test_manifest();
+    // port expects number, pass a string
+    let config = serde_json::json!({"port": "not-a-number"});
+    let result = manifest.validate_config(&config);
+    assert!(
+        result.is_err(),
+        "Config with wrong type should fail validation"
+    );
+}
+
+#[test]
+fn plugin_manifest_validate_config_none_schema_accepts_anything() {
+    let manifest = PluginManifest::new(
+        PluginId::builtin("test"),
+        "Test Plugin",
+        PluginKind::Parser,
+    );
+    // When config_schema is None/null, any config should be accepted
+    let config = serde_json::json!({"any": "thing", "goes": true});
+    let result = manifest.validate_config(&config);
+    assert!(result.is_ok(), "None schema should accept any config");
+}
+
+#[test]
+fn plugin_manifest_validate_config_rejects_required_missing() {
+    let manifest = manifest_with_required_field();
+    let config = serde_json::json!({});
+    let result = manifest.validate_config(&config);
+    assert!(
+        result.is_err(),
+        "Missing required field should fail validation"
+    );
+}
+
+// --- Rule #9: Private fields with getters ---
+// PluginManifest fields that are validated (id, config_schema) should be
+// accessed through getters, not direct field access. The test above already
+// uses getters (manifest.id(), manifest.name(), etc.) — if fields were
+// public, the getter tests would still pass, but the test structure
+// documents the expectation.
+
+// ============================================================
+// Test helpers
+// ============================================================
+
+fn test_manifest() -> PluginManifest {
+    PluginManifest::builder()
+        .schema_version("1.0")
+        .id(PluginId::builtin("syslog-tcp"))
+        .name("Syslog TCP Connector")
+        .version("0.1.0")
+        .description("Receives syslog over TCP")
+        .plugin_kind(PluginKind::Connector)
+        .category("network")
+        .config_schema(serde_json::json!({
+            "type": "object",
+            "properties": {
+                "port": {
+                    "type": "number",
+                    "description": "TCP port",
+                    "default": 1514,
+                    "x-ui-widget": "number",
+                    "x-ui-order": 1
+                }
+            }
+        }))
+        .permissions(vec!["network:listen".into()])
+        .tags(vec!["syslog".into(), "network".into()])
+        .build()
+}
+
+fn manifest_with_required_field() -> PluginManifest {
+    PluginManifest::builder()
+        .schema_version("1.0")
+        .id(PluginId::builtin("test"))
+        .name("Test")
+        .version("0.1.0")
+        .description("Test plugin")
+        .plugin_kind(PluginKind::Connector)
+        .category("test")
+        .config_schema(serde_json::json!({
+            "type": "object",
+            "required": ["host"],
+            "properties": {
+                "host": {"type": "string"}
+            }
+        }))
+        .build()
+}
