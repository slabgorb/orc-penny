+//! Tests for PluginHealth and PluginConfig (AC-6 through AC-8).
+
+use axiathon_plugin_sdk_core::{PluginConfig, PluginHealth};
+
+// ============================================================
+// AC-6: PluginHealth — Healthy, Degraded(String), Unhealthy(String)
+// ============================================================
+
+#[test]
+fn plugin_health_healthy_variant() {
+    let h = PluginHealth::Healthy;
+    assert_eq!(h, PluginHealth::Healthy);
+}
+
+#[test]
+fn plugin_health_degraded_variant() {
+    let d = PluginHealth::Degraded("high latency".into());
+    match d {
+        PluginHealth::Degraded(msg) => assert_eq!(msg, "high latency"),
+        other => panic!("Expected Degraded, got: {other:?}"),
+    }
+}
+
+#[test]
+fn plugin_health_unhealthy_variant() {
+    let u = PluginHealth::Unhealthy("connection refused".into());
+    match u {
+        PluginHealth::Unhealthy(msg) => assert_eq!(msg, "connection refused"),
+        other => panic!("Expected Unhealthy, got: {other:?}"),
+    }
+}
+
+#[test]
+fn plugin_health_serde_roundtrip() {
+    let variants = vec![
+        PluginHealth::Healthy,
+        PluginHealth::Degraded("slow".into()),
+        PluginHealth::Unhealthy("down".into()),
+    ];
+    for variant in variants {
+        let json = serde_json::to_string(&variant).unwrap();
+        let back: PluginHealth = serde_json::from_str(&json).unwrap();
+        assert_eq!(variant, back, "Roundtrip failed for {variant:?}");
+    }
+}
+
+#[test]
+fn plugin_health_debug_clone_eq() {
+    let h = PluginHealth::Degraded("test".into());
+    let cloned = h.clone();
+    assert_eq!(h, cloned);
+    let debug = format!("{h:?}");
+    assert!(debug.contains("Degraded"), "Debug should contain variant, got: {debug}");
+}
+
+// ============================================================
+// AC-8: PluginConfig is serde_json::Value type alias
+// ============================================================
+
+#[test]
+fn plugin_config_is_json_value() {
+    let config: PluginConfig = serde_json::json!({"port": 1514, "host": "localhost"});
+    assert!(config.is_object());
+    assert_eq!(config["port"], 1514);
+    assert_eq!(config["host"], "localhost");
+}
+
+#[test]
+fn plugin_config_accepts_any_json() {
+    // PluginConfig = serde_json::Value, so any JSON is valid
+    let null: PluginConfig = serde_json::Value::Null;
+    assert!(null.is_null());
+    let num: PluginConfig = serde_json::json!(42);
+    assert!(num.is_number());
+    let arr: PluginConfig = serde_json::json!([1, 2, 3]);
+    assert!(arr.is_array());
+    let obj: PluginConfig = serde_json::json!({"nested": {"deep": true}});
+    assert!(obj.is_object());
+}
diff --git a/crates/axiathon-plugin-sdk/core/tests/plugin_id_tests.rs b/crates/axiathon-plugin-sdk/core/tests/plugin_id_tests.rs
