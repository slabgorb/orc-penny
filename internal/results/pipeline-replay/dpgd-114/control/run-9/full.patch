+//! Tests for network plugin traits (AC-10).
+//!
+//! ProtocolDissector with ProtocolInfo.
+
+use axiathon_plugin_sdk_network::{ProtocolDissector, ProtocolInfo};
+
+// ============================================================
+// AC-10: Network sub-crate trait definitions
+// ============================================================
+
+// --- Object safety (AC-13) ---
+
+#[test]
+fn protocol_dissector_is_object_safe() {
+    fn _take(_: Box<dyn ProtocolDissector>) {}
+}
+
+// --- ProtocolDissector is sync (no async_trait) ---
+
+#[test]
+fn protocol_dissector_requires_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    fn check<T: ProtocolDissector>() {
+        assert_send_sync::<T>();
+    }
+    let _ = check::<MockDissector>;
+}
+
+// --- ProtocolInfo ---
+
+#[test]
+fn protocol_info_has_name_description_ports() {
+    let info = ProtocolInfo {
+        name: "DNS".into(),
+        description: "Domain Name System".into(),
+        default_ports: vec![53],
+    };
+    assert_eq!(info.name, "DNS");
+    assert_eq!(info.description, "Domain Name System");
+    assert_eq!(info.default_ports, vec![53]);
+}
+
+#[test]
+fn protocol_info_serde_roundtrip() {
+    let info = ProtocolInfo {
+        name: "HTTP".into(),
+        description: "Hypertext Transfer Protocol".into(),
+        default_ports: vec![80, 443],
+    };
+    let json = serde_json::to_string(&info).unwrap();
+    let back: ProtocolInfo = serde_json::from_str(&json).unwrap();
+    assert_eq!(info.name, back.name);
+    assert_eq!(info.default_ports, back.default_ports);
+}
+
+#[test]
+fn protocol_info_empty_ports() {
+    let info = ProtocolInfo {
+        name: "Custom".into(),
+        description: "Custom protocol".into(),
+        default_ports: vec![],
+    };
+    assert!(info.default_ports.is_empty());
+}
+
+// --- Mock for compile verification ---
+
+struct MockDissector;
+
+impl ProtocolDissector for MockDissector {
+    fn name(&self) -> &str {
+        "mock-dissector"
+    }
+
+    fn can_dissect(&self, hint: &str) -> bool {
+        hint == "DNS"
+    }
+
+    fn dissect(&self, _data: &[u8]) -> axiathon_core::Result<serde_json::Value> {
+        Ok(serde_json::json!({"query": "example.com"}))
+    }
+
+    fn protocol_info(&self) -> ProtocolInfo {
+        ProtocolInfo {
+            name: "DNS".into(),
+            description: "DNS dissector".into(),
+            default_ports: vec![53],
+        }
+    }
+}
+
+#[test]
+fn mock_dissector_can_dissect_returns_correct_hint() {
+    let d = MockDissector;
+    assert!(d.can_dissect("DNS"));
+    assert!(!d.can_dissect("HTTP"));
+}
+
+#[test]
+fn mock_dissector_dissect_returns_json() {
+    let d = MockDissector;
+    let result = d.dissect(b"dummy").unwrap();
+    assert_eq!(result["query"], "example.com");
+}
+
+#[test]
+fn mock_dissector_protocol_info_correct() {
+    let d = MockDissector;
+    let info = d.protocol_info();
+    assert_eq!(info.name, "DNS");
+    assert_eq!(info.default_ports, vec![53]);
+}
