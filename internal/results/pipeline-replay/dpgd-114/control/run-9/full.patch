+//! Tests for PluginError (AC-6).
+//!
+//! PluginError has 8 structured variants with thiserror.
+
+use axiathon_plugin_sdk_core::PluginError;
+
+// ============================================================
+// AC-6: PluginError with 8 structured variants
+// ============================================================
+
+#[test]
+fn plugin_error_config_invalid_variant() {
+    let err = PluginError::ConfigInvalid("missing host field".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("missing host field"),
+        "ConfigInvalid should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_initialization_failed_variant() {
+    let err = PluginError::InitializationFailed("cannot connect to backend".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("cannot connect to backend"),
+        "InitializationFailed should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_health_check_failed_variant() {
+    let err = PluginError::HealthCheckFailed("connection timeout".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("connection timeout"),
+        "HealthCheckFailed should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_not_found_variant() {
+    let err = PluginError::NotFound("builtin:syslog-tcp".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("builtin:syslog-tcp"),
+        "NotFound should contain plugin id, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_execution_failed_variant() {
+    let err = PluginError::ExecutionFailed("parse error at byte 42".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("parse error at byte 42"),
+        "ExecutionFailed should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_permission_denied_variant() {
+    let err = PluginError::PermissionDenied("network:listen not granted".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("network:listen not granted"),
+        "PermissionDenied should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_version_mismatch_variant() {
+    let err = PluginError::VersionMismatch("expected SDK 1.0, got 0.9".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("expected SDK 1.0, got 0.9"),
+        "VersionMismatch should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_internal_variant() {
+    let err = PluginError::Internal("unexpected state".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("unexpected state"),
+        "Internal should contain message, got: {msg}"
+    );
+}
+
+// --- std::error::Error + Send + Sync + 'static ---
+
+#[test]
+fn plugin_error_implements_std_error_send_sync() {
+    fn assert_bounds<T: std::error::Error + Send + Sync + 'static>() {}
+    assert_bounds::<PluginError>();
+}
+
+// --- Rule #2: #[non_exhaustive] on PluginError ---
+
+#[test]
+fn plugin_error_is_non_exhaustive() {
+    let err = PluginError::Internal("test".into());
+    let msg = match err {
+        PluginError::ConfigInvalid(m) => m,
+        PluginError::InitializationFailed(m) => m,
+        PluginError::HealthCheckFailed(m) => m,
+        PluginError::NotFound(m) => m,
+        PluginError::ExecutionFailed(m) => m,
+        PluginError::PermissionDenied(m) => m,
+        PluginError::VersionMismatch(m) => m,
+        PluginError::Internal(m) => m,
+        _ => "unknown".into(), // Required by #[non_exhaustive]
+    };
+    assert_eq!(msg, "test", "Should match Internal arm");
+}
+
+// --- Different variants trigger different behaviors ---
+
+#[test]
+fn plugin_error_variants_are_distinct() {
+    let config = PluginError::ConfigInvalid("x".into());
+    let init = PluginError::InitializationFailed("x".into());
+    let health = PluginError::HealthCheckFailed("x".into());
+    let not_found = PluginError::NotFound("x".into());
+
+    // Verify they produce different Display output (different prefixes)
+    assert_ne!(config.to_string(), init.to_string());
+    assert_ne!(health.to_string(), not_found.to_string());
+}
