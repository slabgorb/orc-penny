index 0000000..771dc76
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/core/src/identity.rs
@@ -0,0 +1,99 @@
+//! Plugin identity types: PluginId with namespace:name format.
+
+use std::fmt;
+use std::str::FromStr;
+
+use serde::{Deserialize, Deserializer, Serialize};
+
+use crate::PluginError;
+
+/// Namespaced plugin identity.
+///
+/// Plugins are identified by a namespace and name, formatted as `"namespace:name"`.
+/// Standard namespaces:
+/// - `builtin` — shipped with Axiathon
+/// - `community` — community-maintained plugins
+/// - Reverse-domain (e.g. `com.acme`) — vendor plugins
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize)]
+pub struct PluginId {
+    namespace: String,
+    name: String,
+}
+
+impl PluginId {
+    /// Validated constructor. Rejects empty or whitespace-only namespace/name.
+    pub fn new(
+        namespace: impl Into<String>,
+        name: impl Into<String>,
+    ) -> Result<Self, PluginError> {
+        let namespace = namespace.into();
+        let name = name.into();
+        if namespace.trim().is_empty() {
+            return Err(PluginError::ConfigInvalid(
+                "PluginId namespace cannot be empty".into(),
+            ));
+        }
+        if name.trim().is_empty() {
+            return Err(PluginError::ConfigInvalid(
+                "PluginId name cannot be empty".into(),
+            ));
+        }
+        Ok(Self { namespace, name })
+    }
+
+    /// Create a builtin plugin ID. Panics if name is empty.
+    pub fn builtin(name: impl Into<String>) -> Self {
+        Self::new("builtin", name).expect("builtin plugin name must not be empty")
+    }
+
+    /// Create a community plugin ID. Panics if name is empty.
+    pub fn community(name: impl Into<String>) -> Self {
+        Self::new("community", name).expect("community plugin name must not be empty")
+    }
+
+    /// Returns the namespace.
+    pub fn namespace(&self) -> &str {
+        &self.namespace
+    }
+
+    /// Returns the name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+impl fmt::Display for PluginId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.namespace, self.name)
+    }
+}
+
+/// Parse `"namespace:name"` into a `PluginId`.
+impl FromStr for PluginId {
+    type Err = PluginError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s.split_once(':') {
+            Some((ns, name)) => Self::new(ns, name),
+            None => Err(PluginError::ConfigInvalid(format!(
+                "invalid plugin id '{s}': expected 'namespace:name'"
+            ))),
+        }
+    }
+}
+
+/// Custom Deserialize that validates namespace/name are non-empty (CWE-20).
+impl<'de> Deserialize<'de> for PluginId {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        #[derive(Deserialize)]
+        struct Raw {
+            namespace: String,
+            name: String,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        PluginId::new(raw.namespace, raw.name).map_err(serde::de::Error::custom)
+    }
+}
