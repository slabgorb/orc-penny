@@ -0,0 +1,211 @@
+//! Tests for PluginId type (AC-4).
+//!
+//! PluginId uses namespace:name format with FromStr, Display, and helpers.
+//! Tests cover: parsing, validation, display, serde, derive traits, edge cases.
+
+use std::collections::HashSet;
+
+use axiathon_plugin_sdk_core::PluginId;
+
+// ============================================================
+// AC-4: PluginId with namespace:name format
+// ============================================================
+
+// --- FromStr parsing ---
+
+#[test]
+fn plugin_id_from_str_builtin() {
+    let id: PluginId = "builtin:syslog-tcp".parse().unwrap();
+    assert_eq!(id.namespace(), "builtin");
+    assert_eq!(id.name(), "syslog-tcp");
+}
+
+#[test]
+fn plugin_id_from_str_reverse_domain() {
+    let id: PluginId = "com.claroty:xdome".parse().unwrap();
+    assert_eq!(id.namespace(), "com.claroty");
+    assert_eq!(id.name(), "xdome");
+}
+
+#[test]
+fn plugin_id_from_str_community() {
+    let id: PluginId = "community:custom-parser".parse().unwrap();
+    assert_eq!(id.namespace(), "community");
+    assert_eq!(id.name(), "custom-parser");
+}
+
+// --- FromStr rejection (empty parts) ---
+
+#[test]
+fn plugin_id_from_str_rejects_no_colon() {
+    let result = "no-colon".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject input without colon");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_namespace() {
+    let result = ":no-namespace".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject empty namespace");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_name() {
+    let result = "no-name:".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject empty name");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_string() {
+    let result = "".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject empty string");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_colon_only() {
+    let result = ":".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject bare colon");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_whitespace_namespace() {
+    let result = " :name".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject whitespace-only namespace");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_whitespace_name() {
+    let result = "ns: ".parse::<PluginId>();
+    assert!(result.is_err(), "Should reject whitespace-only name");
+}
+
+// --- Display ---
+
+#[test]
+fn plugin_id_display_formats_as_namespace_colon_name() {
+    let id: PluginId = "builtin:syslog-tcp".parse().unwrap();
+    assert_eq!(id.to_string(), "builtin:syslog-tcp");
+}
+
+#[test]
+fn plugin_id_display_reverse_domain() {
+    let id: PluginId = "com.acme:firewall-monitor".parse().unwrap();
+    assert_eq!(id.to_string(), "com.acme:firewall-monitor");
+}
+
+// --- Helpers ---
+
+#[test]
+fn plugin_id_builtin_helper() {
+    let id = PluginId::builtin("syslog-tcp");
+    assert_eq!(id.namespace(), "builtin");
+    assert_eq!(id.name(), "syslog-tcp");
+    assert_eq!(id.to_string(), "builtin:syslog-tcp");
+}
+
+#[test]
+fn plugin_id_community_helper() {
+    let id = PluginId::community("custom-parser");
+    assert_eq!(id.namespace(), "community");
+    assert_eq!(id.name(), "custom-parser");
+    assert_eq!(id.to_string(), "community:custom-parser");
+}
+
+// --- Derive traits: Debug, Clone, PartialEq, Eq, Hash ---
+
+#[test]
+fn plugin_id_debug_contains_fields() {
+    let id = PluginId::builtin("test");
+    let debug = format!("{id:?}");
+    assert!(
+        debug.contains("builtin") && debug.contains("test"),
+        "Debug should contain namespace and name, got: {debug}"
+    );
+}
+
+#[test]
+fn plugin_id_clone_eq() {
+    let id1 = PluginId::builtin("test");
+    let id2 = id1.clone();
+    assert_eq!(id1, id2);
+}
+
+#[test]
+fn plugin_id_hash_in_set() {
+    let id1 = PluginId::builtin("syslog-tcp");
+    let id2 = PluginId::builtin("syslog-tcp");
+    let mut set = HashSet::new();
+    set.insert(id1);
+    assert!(set.contains(&id2));
+}
+
+#[test]
+fn plugin_id_ne_different_namespace() {
+    let id1 = PluginId::builtin("test");
+    let id2 = PluginId::community("test");
+    assert_ne!(id1, id2);
+}
+
+#[test]
+fn plugin_id_ne_different_name() {
+    let id1 = PluginId::builtin("foo");
+    let id2 = PluginId::builtin("bar");
+    assert_ne!(id1, id2);
+}
+
+// --- Serde ---
+
+#[test]
+fn plugin_id_serde_roundtrip() {
+    let id = PluginId::builtin("syslog-tcp");
+    let json = serde_json::to_string(&id).unwrap();
+    let deserialized: PluginId = serde_json::from_str(&json).unwrap();
+    assert_eq!(id, deserialized);
+}
+
+#[test]
+fn plugin_id_serialize_preserves_namespace_and_name() {
+    let id = PluginId::builtin("test-plugin");
+    let json = serde_json::to_value(&id).unwrap();
+    // Whether serialized as struct or string, verify namespace:name are preserved
+    let back: PluginId = serde_json::from_value(json).unwrap();
+    assert_eq!(back.namespace(), "builtin");
+    assert_eq!(back.name(), "test-plugin");
+}
+
+// --- Rule #5: Validated constructors — PluginId::new() should reject empty ---
+
+#[test]
+fn plugin_id_new_rejects_empty_namespace() {
+    // PluginId::new("", "name") should return Err
+    let result = PluginId::new("", "name");
+    assert!(result.is_err(), "Empty namespace should be rejected");
+}
+
+#[test]
+fn plugin_id_new_rejects_empty_name() {
+    let result = PluginId::new("builtin", "");
+    assert!(result.is_err(), "Empty name should be rejected");
+}
+
+// --- Rule #8: Deserialize bypass — if PluginId has validated new(), serde must also validate ---
+
+#[test]
+fn plugin_id_deserialize_rejects_empty_namespace() {
+    // Deserializing a PluginId with empty namespace should fail
+    let json = r#"{"namespace":"","name":"test"}"#;
+    let result = serde_json::from_str::<PluginId>(json);
+    assert!(
+        result.is_err(),
+        "Deserializing empty namespace should fail (CWE-20 serde bypass)"
+    );
+}
+
+#[test]
+fn plugin_id_deserialize_rejects_empty_name() {
+    let json = r#"{"namespace":"builtin","name":""}"#;
+    let result = serde_json::from_str::<PluginId>(json);
+    assert!(
+        result.is_err(),
+        "Deserializing empty name should fail (CWE-20 serde bypass)"
+    );
+}
