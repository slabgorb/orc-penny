@@ -0,0 +1,43 @@
+//! Action plugin traits: ResponseAction.
+#![forbid(unsafe_code)]
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+
+/// Capabilities of a response action.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ActionCapabilities {
+    /// Actions this plugin supports (e.g. `["block_ip", "isolate_host"]`).
+    pub supported_actions: Vec<String>,
+    /// Whether actions are reversible.
+    pub reversible: bool,
+}
+
+/// Result of executing a response action.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ActionResult {
+    /// Whether the action succeeded.
+    pub success: bool,
+    /// Human-readable message.
+    pub message: String,
+    /// Whether this action can be undone.
+    pub reversible: bool,
+    /// Action identifier for potential rollback.
+    pub action_id: String,
+}
+
+/// Executes automated response actions (block IP, isolate host, etc.).
+#[async_trait]
+pub trait ResponseAction: Send + Sync {
+    /// Returns the name of this response action.
+    fn name(&self) -> &str;
+
+    /// Execute the action with the given parameters.
+    async fn execute(&self, params: &serde_json::Value) -> axiathon_core::Result<ActionResult>;
+
+    /// Describe the action's capabilities.
+    fn capabilities(&self) -> ActionCapabilities;
+
+    /// Validate parameters before execution.
+    fn validate_params(&self, params: &serde_json::Value) -> axiathon_core::Result<()>;
+}
diff --git a/crates/axiathon-plugin-sdk/action/tests/action_trait_tests.rs b/crates/axiathon-plugin-sdk/action/tests/action_trait_tests.rs
new file mode 100644
index 0000000..73db4d9
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/action/tests/action_trait_tests.rs
@@ -0,0 +1,151 @@
+//! Tests for action plugin traits (AC-12).
+//!
+//! ResponseAction with ActionCapabilities and ActionResult.
+
+use async_trait::async_trait;
+use axiathon_plugin_sdk_action::{ActionCapabilities, ActionResult, ResponseAction};
+
+// ============================================================
+// AC-12: Action sub-crate trait definitions
+// ============================================================
+
+// --- Object safety (AC-13) ---
+
+#[test]
+fn response_action_is_object_safe() {
+    fn _take(_: Box<dyn ResponseAction>) {}
+}
+
+// --- ResponseAction requires Send + Sync ---
+
+#[test]
+fn response_action_requires_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    fn check<T: ResponseAction>() {
+        assert_send_sync::<T>();
+    }
+    let _ = check::<MockBlockIpAction>;
+}
+
+// --- ActionCapabilities ---
+
+#[test]
+fn action_capabilities_has_supported_actions_and_reversible() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["block_ip".into(), "isolate_host".into()],
+        reversible: true,
+    };
+    assert_eq!(caps.supported_actions, vec!["block_ip", "isolate_host"]);
+    assert!(caps.reversible);
+}
+
+#[test]
+fn action_capabilities_serde_roundtrip() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["quarantine".into()],
+        reversible: false,
+    };
+    let json = serde_json::to_string(&caps).unwrap();
+    let back: ActionCapabilities = serde_json::from_str(&json).unwrap();
+    assert_eq!(caps.supported_actions, back.supported_actions);
+    assert_eq!(caps.reversible, back.reversible);
+}
+
+// --- ActionResult ---
+
+#[test]
+fn action_result_has_success_message_reversible_action_id() {
+    let result = ActionResult {
+        success: true,
+        message: "IP blocked successfully".into(),
+        reversible: true,
+        action_id: "act-001".into(),
+    };
+    assert!(result.success);
+    assert_eq!(result.message, "IP blocked successfully");
+    assert!(result.reversible);
+    assert_eq!(result.action_id, "act-001");
+}
+
+#[test]
+fn action_result_serde_roundtrip() {
+    let result = ActionResult {
+        success: false,
+        message: "Failed to block IP".into(),
+        reversible: false,
+        action_id: "act-002".into(),
+    };
+    let json = serde_json::to_string(&result).unwrap();
+    let back: ActionResult = serde_json::from_str(&json).unwrap();
+    assert_eq!(result.success, back.success);
+    assert_eq!(result.message, back.message);
+    assert_eq!(result.action_id, back.action_id);
+}
+
+// --- Mock implementation ---
+
+struct MockBlockIpAction;
+
+#[async_trait]
+impl ResponseAction for MockBlockIpAction {
+    fn name(&self) -> &str {
+        "mock-block-ip"
+    }
+
+    async fn execute(&self, params: &serde_json::Value) -> axiathon_core::Result<ActionResult> {
+        let ip = params["ip"].as_str().unwrap_or("unknown");
+        Ok(ActionResult {
+            success: true,
+            message: format!("Blocked {ip}"),
+            reversible: true,
+            action_id: "mock-act-001".into(),
+        })
+    }
+
+    fn capabilities(&self) -> ActionCapabilities {
+        ActionCapabilities {
+            supported_actions: vec!["block_ip".into()],
+            reversible: true,
+        }
+    }
+
+    fn validate_params(&self, params: &serde_json::Value) -> axiathon_core::Result<()> {
+        if params.get("ip").is_none() {
+            return Err(axiathon_core::AxiathonError::Validation(
+                "ip parameter required".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[tokio::test]
+async fn mock_response_action_execute() {
+    let action = MockBlockIpAction;
+    let params = serde_json::json!({"ip": "192.168.1.1"});
+    let result = action.execute(&params).await.unwrap();
+    assert!(result.success);
+    assert_eq!(result.message, "Blocked 192.168.1.1");
+}
+
+#[test]
+fn mock_response_action_validate_params_ok() {
+    let action = MockBlockIpAction;
+    let params = serde_json::json!({"ip": "192.168.1.1"});
+    assert!(action.validate_params(&params).is_ok());
+}
+
+#[test]
+fn mock_response_action_validate_params_missing() {
+    let action = MockBlockIpAction;
+    let params = serde_json::json!({});
+    assert!(action.validate_params(&params).is_err());
+}
+
+#[test]
+fn mock_response_action_capabilities() {
+    let action = MockBlockIpAction;
+    let caps = action.capabilities();
+    assert_eq!(caps.supported_actions, vec!["block_ip"]);
+    assert!(caps.reversible);
+}
