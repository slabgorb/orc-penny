@@ -0,0 +1,175 @@
+//! Tests for ingestion plugin traits (AC-9).
+//!
+//! ConnectorPlugin, ParserPlugin, EventEnricher with supporting types.
+
+use async_trait::async_trait;
+use axiathon_plugin_sdk_core::PluginHealth;
+use axiathon_plugin_sdk_ingestion::{
+    ConnectorPlugin, EnricherCapabilities, EnrichmentResult, EventEnricher, ParserPlugin, RawEvent,
+};
+
+// ============================================================
+// AC-9: Ingestion sub-crate trait definitions
+// ============================================================
+
+// --- Object safety (AC-13) ---
+
+#[test]
+fn connector_plugin_is_object_safe() {
+    fn _take(_: Box<dyn ConnectorPlugin>) {}
+}
+
+#[test]
+fn parser_plugin_is_object_safe() {
+    fn _take(_: Box<dyn ParserPlugin>) {}
+}
+
+#[test]
+fn event_enricher_is_object_safe() {
+    fn _take(_: Box<dyn EventEnricher>) {}
+}
+
+// --- ConnectorPlugin requires AxiathonPlugin supertrait ---
+
+#[test]
+fn connector_plugin_requires_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    // This would fail to compile if ConnectorPlugin doesn't require Send + Sync
+    fn check<T: ConnectorPlugin>() {
+        assert_send_sync::<T>();
+    }
+    let _ = check::<MockConnector>;
+}
+
+// --- RawEvent type ---
+
+#[test]
+fn raw_event_new_captures_data_source_tenant() {
+    let tenant = axiathon_core::TenantId::new_unchecked("test-tenant");
+    let raw = RawEvent::new(b"test data".to_vec(), "test-source", tenant);
+    assert_eq!(raw.source(), "test-source");
+    assert_eq!(raw.tenant_id().as_str(), "test-tenant");
+    assert_eq!(raw.data(), b"test data");
+}
+
+#[test]
+fn raw_event_as_str_lossy() {
+    let tenant = axiathon_core::TenantId::new_unchecked("t1");
+    let raw = RawEvent::new(b"hello world".to_vec(), "src", tenant);
+    assert_eq!(raw.as_str(), "hello world");
+}
+
+#[test]
+fn raw_event_as_str_handles_non_utf8() {
+    let tenant = axiathon_core::TenantId::new_unchecked("t1");
+    let raw = RawEvent::new(vec![0xff, 0xfe], "binary", tenant);
+    // Should not panic — lossy conversion
+    let text = raw.as_str();
+    assert!(text.contains('\u{FFFD}'), "Lossy conversion should produce replacement chars, got: {text}");
+}
+
+#[test]
+fn raw_event_has_received_at_timestamp() {
+    let tenant = axiathon_core::TenantId::new_unchecked("t1");
+    let raw = RawEvent::new(b"data".to_vec(), "src", tenant);
+    let ts = raw.received_at();
+    // Should be roughly "now"
+    let now = chrono::Utc::now();
+    let diff = (now - *ts).num_seconds().abs();
+    assert!(diff < 5, "received_at should be within 5s of now");
+}
+
+#[test]
+fn raw_event_metadata_initially_empty() {
+    let tenant = axiathon_core::TenantId::new_unchecked("t1");
+    let raw = RawEvent::new(b"data".to_vec(), "src", tenant);
+    assert!(raw.metadata().is_empty());
+}
+
+// --- Rule #9: RawEvent.tenant_id should be private ---
+
+// RawEvent carries a TenantId which is security-critical.
+// Direct field access should not be possible — use getter instead.
+// If the field is public, this test documents the expectation that
+// it should be private (enforced by the getter-only API in tests above).
+
+// --- Rule #10: Tenant context in trait signatures ---
+
+// ConnectorPlugin.start() should have access to tenant context
+// ParserPlugin.parse() processes RawEvent which carries TenantId
+// EventEnricher.enrich() mutates an event which carries TenantId
+
+// --- EnricherCapabilities ---
+
+#[test]
+fn enricher_capabilities_has_input_output_fields() {
+    let caps = EnricherCapabilities {
+        input_fields: vec!["src_endpoint.ip".into()],
+        output_fields: vec!["geo.country".into(), "geo.city".into()],
+    };
+    assert_eq!(caps.input_fields, vec!["src_endpoint.ip"]);
+    assert_eq!(caps.output_fields, vec!["geo.country", "geo.city"]);
+}
+
+#[test]
+fn enricher_capabilities_serde_roundtrip() {
+    let caps = EnricherCapabilities {
+        input_fields: vec!["ip".into()],
+        output_fields: vec!["country".into()],
+    };
+    let json = serde_json::to_string(&caps).unwrap();
+    let back: EnricherCapabilities = serde_json::from_str(&json).unwrap();
+    assert_eq!(caps.input_fields, back.input_fields);
+    assert_eq!(caps.output_fields, back.output_fields);
+}
+
+// --- EnrichmentResult ---
+
+#[test]
+fn enrichment_result_has_fields_added_and_source() {
+    let result = EnrichmentResult {
+        fields_added: 3,
+        source: "geoip-maxmind".into(),
+    };
+    assert_eq!(result.fields_added, 3);
+    assert_eq!(result.source, "geoip-maxmind");
+}
+
+#[test]
+fn enrichment_result_serde_roundtrip() {
+    let result = EnrichmentResult {
+        fields_added: 2,
+        source: "threatintel".into(),
+    };
+    let json = serde_json::to_string(&result).unwrap();
+    let back: EnrichmentResult = serde_json::from_str(&json).unwrap();
+    assert_eq!(result.fields_added, back.fields_added);
+    assert_eq!(result.source, back.source);
+}
+
+// --- Mock implementations for compile verification ---
+
+struct MockConnector;
+
+#[async_trait]
+impl ConnectorPlugin for MockConnector {
+    fn name(&self) -> &str {
+        "mock-connector"
+    }
+
+    fn version(&self) -> &str {
+        "0.1.0"
+    }
+
+    async fn start(&self, _tx: tokio::sync::mpsc::Sender<RawEvent>) -> axiathon_core::Result<()> {
+        Ok(())
+    }
+
+    async fn stop(&self) -> axiathon_core::Result<()> {
+        Ok(())
+    }
+
+    fn health(&self) -> PluginHealth {
+        PluginHealth::Healthy
+    }
+}
