+//! Tests for notification plugin traits (AC-11).
+//!
+//! NotificationChannel with Notification.
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use axiathon_plugin_sdk_notification::{Notification, NotificationChannel};
+
+// ============================================================
+// AC-11: Notification sub-crate trait definitions
+// ============================================================
+
+// --- Object safety (AC-13) ---
+
+#[test]
+fn notification_channel_is_object_safe() {
+    fn _take(_: Box<dyn NotificationChannel>) {}
+}
+
+// --- NotificationChannel requires Send + Sync ---
+
+#[test]
+fn notification_channel_requires_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    fn check<T: NotificationChannel>() {
+        assert_send_sync::<T>();
+    }
+    let _ = check::<MockSlackChannel>;
+}
+
+// --- Notification struct ---
+
+#[test]
+fn notification_has_title_body_severity_metadata() {
+    let n = Notification {
+        title: "Critical Alert".into(),
+        body: "Unauthorized access detected".into(),
+        severity: "critical".into(),
+        metadata: HashMap::from([("source".into(), "axiathon".into())]),
+    };
+    assert_eq!(n.title, "Critical Alert");
+    assert_eq!(n.body, "Unauthorized access detected");
+    assert_eq!(n.severity, "critical");
+    assert_eq!(n.metadata["source"], "axiathon");
+}
+
+#[test]
+fn notification_serde_roundtrip() {
+    let n = Notification {
+        title: "Test".into(),
+        body: "Test body".into(),
+        severity: "high".into(),
+        metadata: HashMap::new(),
+    };
+    let json = serde_json::to_string(&n).unwrap();
+    let back: Notification = serde_json::from_str(&json).unwrap();
+    assert_eq!(n.title, back.title);
+    assert_eq!(n.severity, back.severity);
+}
+
+#[test]
+fn notification_empty_metadata() {
+    let n = Notification {
+        title: "Alert".into(),
+        body: "Something happened".into(),
+        severity: "low".into(),
+        metadata: HashMap::new(),
+    };
+    assert!(n.metadata.is_empty());
+}
+
+// --- Mock implementation ---
+
+struct MockSlackChannel {
+    sent: std::sync::Mutex<Vec<String>>,
+}
+
+impl MockSlackChannel {
+    fn new() -> Self {
+        Self {
+            sent: std::sync::Mutex::new(Vec::new()),
+        }
+    }
+}
+
+#[async_trait]
+impl NotificationChannel for MockSlackChannel {
+    fn name(&self) -> &str {
+        "mock-slack"
+    }
+
+    async fn send(&self, notification: &Notification) -> axiathon_core::Result<()> {
+        self.sent
+            .lock()
+            .unwrap()
+            .push(notification.title.clone());
+        Ok(())
+    }
+
+    async fn test_connection(&self) -> axiathon_core::Result<()> {
+        Ok(())
+    }
+}
+
+#[tokio::test]
+async fn mock_notification_channel_send() {
+    let channel = MockSlackChannel::new();
+    let n = Notification {
+        title: "Test Alert".into(),
+        body: "Body".into(),
+        severity: "high".into(),
+        metadata: HashMap::new(),
+    };
+    channel.send(&n).await.unwrap();
+    let sent = channel.sent.lock().unwrap();
+    assert_eq!(sent.len(), 1);
+    assert_eq!(sent[0], "Test Alert");
+}
+
+#[tokio::test]
+async fn mock_notification_channel_test_connection() {
+    let channel = MockSlackChannel::new();
+    channel.test_connection().await.unwrap();
+}
