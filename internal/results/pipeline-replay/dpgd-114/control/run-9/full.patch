@@ -0,0 +1,156 @@
+//! Tests for AxiathonPlugin base trait (AC-2).
+//!
+//! AxiathonPlugin uses #[async_trait], is Send + Sync, and is object-safe.
+
+use async_trait::async_trait;
+
+use axiathon_plugin_sdk_core::{
+    AxiathonPlugin, PluginConfig, PluginError, PluginHealth, PluginId, PluginKind, PluginManifest,
+};
+
+// ============================================================
+// AC-2: AxiathonPlugin base trait
+// ============================================================
+
+// --- Object-safety compile tests (AC-13) ---
+
+#[test]
+fn axiathon_plugin_is_object_safe_box() {
+    fn _take(_: Box<dyn AxiathonPlugin>) {}
+}
+
+#[test]
+fn axiathon_plugin_is_object_safe_arc() {
+    fn _take(_: std::sync::Arc<dyn AxiathonPlugin + Send + Sync>) {}
+}
+
+// --- Lifecycle test with mock plugin ---
+
+struct MockPlugin {
+    manifest: PluginManifest,
+    initialized: bool,
+}
+
+impl MockPlugin {
+    fn new() -> Self {
+        Self {
+            manifest: PluginManifest::new(
+                PluginId::builtin("mock-plugin"),
+                "Mock Plugin",
+                PluginKind::Connector,
+            ),
+            initialized: false,
+        }
+    }
+}
+
+#[async_trait]
+impl AxiathonPlugin for MockPlugin {
+    fn manifest(&self) -> &PluginManifest {
+        &self.manifest
+    }
+
+    async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+        self.initialized = true;
+        Ok(())
+    }
+
+    async fn health_check(&self) -> PluginHealth {
+        if self.initialized {
+            PluginHealth::Healthy
+        } else {
+            PluginHealth::Unhealthy("not initialized".into())
+        }
+    }
+
+    async fn shutdown(&mut self) -> Result<(), PluginError> {
+        self.initialized = false;
+        Ok(())
+    }
+}
+
+#[tokio::test]
+async fn axiathon_plugin_manifest_returns_correct_identity() {
+    let plugin = MockPlugin::new();
+    assert_eq!(plugin.manifest().id().to_string(), "builtin:mock-plugin");
+    assert_eq!(plugin.manifest().name(), "Mock Plugin");
+}
+
+#[tokio::test]
+async fn axiathon_plugin_version_reads_from_manifest() {
+    let plugin = MockPlugin::new();
+    assert_eq!(plugin.version(), "0.1.0");
+}
+
+#[tokio::test]
+async fn axiathon_plugin_initialize_then_healthy() {
+    let mut plugin = MockPlugin::new();
+    assert!(matches!(
+        plugin.health_check().await,
+        PluginHealth::Unhealthy(_)
+    ));
+    plugin
+        .initialize(serde_json::json!({"port": 1514}))
+        .await
+        .unwrap();
+    assert_eq!(plugin.health_check().await, PluginHealth::Healthy);
+}
+
+#[tokio::test]
+async fn axiathon_plugin_shutdown_cleans_up() {
+    let mut plugin = MockPlugin::new();
+    plugin.initialize(serde_json::json!({})).await.unwrap();
+    assert_eq!(plugin.health_check().await, PluginHealth::Healthy);
+    plugin.shutdown().await.unwrap();
+    assert!(matches!(
+        plugin.health_check().await,
+        PluginHealth::Unhealthy(_)
+    ));
+}
+
+#[tokio::test]
+async fn axiathon_plugin_initialize_returns_plugin_error() {
+    // AxiathonPlugin methods return Result<(), PluginError>, not anyhow::Result
+    struct FailPlugin;
+
+    #[async_trait]
+    impl AxiathonPlugin for FailPlugin {
+        fn manifest(&self) -> &PluginManifest {
+            unimplemented!("not needed for this test")
+        }
+        async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+            Err(PluginError::ConfigInvalid("bad config".into()))
+        }
+        async fn health_check(&self) -> PluginHealth {
+            PluginHealth::Unhealthy("never initialized".into())
+        }
+        async fn shutdown(&mut self) -> Result<(), PluginError> {
+            Ok(())
+        }
+    }
+
+    let mut plugin = FailPlugin;
+    let result = plugin.initialize(serde_json::json!({})).await;
+    assert!(matches!(
+        result.unwrap_err(),
+        PluginError::ConfigInvalid(_)
+    ));
+}
+
+// --- Send + Sync ---
+
+#[test]
+fn axiathon_plugin_is_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    assert_send_sync::<MockPlugin>();
+}
+
+#[tokio::test]
+async fn axiathon_plugin_usable_across_tokio_spawn() {
+    let plugin = MockPlugin::new();
+    let handle = tokio::spawn(async move {
+        plugin.manifest().name().to_string()
+    });
+    let name = handle.await.unwrap();
+    assert_eq!(name, "Mock Plugin");
+}
