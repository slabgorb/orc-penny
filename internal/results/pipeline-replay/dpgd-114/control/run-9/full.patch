+//! Notification plugin traits: NotificationChannel.
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+
+/// A notification to be sent through a channel.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Notification {
+    /// Notification title.
+    pub title: String,
+    /// Notification body/message.
+    pub body: String,
+    /// Severity level (e.g. `"critical"`, `"high"`).
+    pub severity: String,
+    /// Optional structured metadata.
+    pub metadata: HashMap<String, String>,
+}
+
+/// Sends notifications to external channels (Slack, email, PagerDuty, etc.).
+#[async_trait]
+pub trait NotificationChannel: Send + Sync {
+    /// Returns the name of this notification channel.
+    fn name(&self) -> &str;
+
+    /// Send a notification.
+    async fn send(&self, notification: &Notification) -> axiathon_core::Result<()>;
+
+    /// Test connectivity to the notification target.
+    async fn test_connection(&self) -> axiathon_core::Result<()>;
+}
