@@ -0,0 +1,40 @@
+//! Tests for SDK facade re-exports (AC-1).
+//!
+//! Verifies that all key types are accessible through the top-level
+//! axiathon_plugin_sdk crate, so downstream consumers can use a single
+//! dependency rather than importing individual sub-crates.
+
+// AC-1: All 5 sub-crate modules are re-exported from the facade.
+// Downstream usage: `use axiathon_plugin_sdk::core::PluginId;`
+
+use axiathon_plugin_sdk::core::{AxiathonPlugin, PluginHealth, PluginId, PluginKind};
+use axiathon_plugin_sdk::ingestion::{ConnectorPlugin, EventEnricher, ParserPlugin};
+use axiathon_plugin_sdk::network::ProtocolDissector;
+use axiathon_plugin_sdk::notification::NotificationChannel;
+use axiathon_plugin_sdk::action::ResponseAction;
+
+#[test]
+fn facade_reexports_core_types() {
+    // Exercise the types to prove they're usable via the facade, not just importable.
+    let id = PluginId::builtin("test");
+    assert_eq!(id.full_id(), "builtin:test");
+
+    let kind = PluginKind::Parser;
+    assert_eq!(kind.to_string(), "parser");
+
+    let health = PluginHealth::Healthy;
+    assert_eq!(health, PluginHealth::Healthy);
+}
+
+/// Compile-time verification that all 7 trait types are accessible via the facade
+/// and are object-safe. If any re-export is missing, this test fails to compile.
+#[test]
+fn facade_reexports_all_sub_crate_modules() {
