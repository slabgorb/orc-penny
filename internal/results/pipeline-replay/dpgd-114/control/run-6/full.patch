+//! Plugin manifest and signature metadata types.
+
+use serde::{Deserialize, Serialize};
+
+use crate::config::PluginConfig;
+use crate::error::PluginError;
+use crate::identity::{PluginId, PluginKind};
+
+/// Declarative plugin manifest with metadata, config schema, and permissions.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PluginManifest {
+    /// Manifest schema version (e.g. "1.0").
+    pub schema_version: String,
+    /// Namespaced plugin identity.
+    pub id: PluginId,
+    /// Human-readable display name.
+    pub name: String,
+    /// Semantic version (e.g. "0.1.0").
+    pub version: String,
+    /// Plugin description.
+    pub description: String,
+    /// Plugin kind.
+    pub plugin_kind: PluginKind,
+    /// Organizational category.
+    pub category: String,
+    /// JSON Schema for plugin configuration, with optional `x-ui-*` extensions
+    /// for rendering hints (e.g. `x-ui-widget: "password"`, `x-ui-order: 1`).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub config_schema: Option<serde_json::Value>,
+    /// Required permissions (e.g. `["network:listen", "file:read"]`).
+    #[serde(default)]
+    pub permissions: Vec<String>,
+    /// Searchable tags.
+    #[serde(default)]
+    pub tags: Vec<String>,
+    /// OCSF event class IDs this plugin produces.
+    #[serde(default)]
+    pub ocsf_classes: Vec<i32>,
+    /// Target OCSF schema version (e.g. "1.7.0").
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ocsf_version: Option<String>,
+    /// Signature metadata for verification (placeholder for Story 23.6).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub signature: Option<SignatureMetadata>,
+}
+
+impl PluginManifest {
+    /// Create a minimal manifest for testing.
+    pub fn new(id: PluginId, name: impl Into<String>, kind: PluginKind) -> Self {
+        Self {
+            schema_version: "1.0".into(),
+            id,
+            name: name.into(),
+            version: "0.1.0".into(),
+            description: String::new(),
+            plugin_kind: kind,
+            category: String::new(),
+            config_schema: None,
+            permissions: Vec::new(),
+            tags: Vec::new(),
+            ocsf_classes: Vec::new(),
+            ocsf_version: None,
+            signature: None,
+        }
+    }
+
+    /// Validate a config value against this manifest's `config_schema`.
+    ///
+    /// If `config_schema` is `None`, any config is accepted.
+    /// If `config_schema` is `Some`, the config is validated using JSON Schema.
+    pub fn validate_config(&self, config: &PluginConfig) -> Result<(), PluginError> {
+        let Some(schema) = &self.config_schema else {
+            return Ok(());
+        };
+
+        let validator = jsonschema::validator_for(schema)
+            .map_err(|e| PluginError::ManifestInvalid(format!("invalid config_schema: {e}")))?;
+
+        if let Err(err) = validator.validate(config) {
+            return Err(PluginError::ConfigInvalid(err.to_string()));
+        }
+
+        Ok(())
+    }
+}
+
+/// Signature metadata for plugin verification (placeholder for Story 23.6).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SignatureMetadata {
+    /// Signing algorithm (e.g. "ed25519", "rsa-sha256").
+    pub algorithm: String,
+    /// Key identifier for verification.
+    pub key_id: String,
+    /// Signature value (hex or base64 encoded).
+    pub signature: String,
+}
