diff --git a/crates/axiathon-plugin-sdk/ingestion/src/lib.rs b/crates/axiathon-plugin-sdk/ingestion/src/lib.rs
new file mode 100644
index 0000000..8a98011
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/ingestion/src/lib.rs
@@ -0,0 +1,107 @@
+//! Axiathon Plugin SDK Ingestion — connector, parser, and enricher plugin traits.
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use tokio::sync::mpsc;
+
+use axiathon_core::TenantId;
+use axiathon_plugin_sdk_core::{PluginError, PluginHealth};
+
+/// Raw event received from a connector before parsing.
+#[derive(Debug, Clone)]
+pub struct RawEvent {
+    /// Raw bytes of the event.
+    pub data: Vec<u8>,
+    /// Source identifier (e.g., "syslog", "claroty-xdome").
+    pub source: String,
+    /// When the raw event was received.
+    pub received_at: DateTime<Utc>,
+    /// Tenant that owns this event.
+    pub tenant_id: TenantId,
+    /// Optional metadata key-value pairs.
+    pub metadata: HashMap<String, String>,
+}
+
+impl RawEvent {
+    /// Create a new RawEvent with the current timestamp.
+    pub fn new(data: Vec<u8>, source: impl Into<String>, tenant_id: TenantId) -> Self {
+        Self {
+            data,
+            source: source.into(),
+            received_at: Utc::now(),
+            tenant_id,
+            metadata: HashMap::new(),
+        }
+    }
+
+    /// Get the data as a UTF-8 string (lossy conversion).
+    pub fn as_str(&self) -> String {
+        String::from_utf8_lossy(&self.data).to_string()
+    }
+}
+
+/// A connector plugin that collects raw events from an external source.
+#[async_trait]
+pub trait ConnectorPlugin: Send + Sync {
+    /// Returns the name of this connector.
+    fn name(&self) -> &str;
+
+    /// Start the connector, sending raw events to the provided channel.
+    async fn start(&self, tx: mpsc::Sender<RawEvent>) -> Result<(), PluginError>;
+
+    /// Stop the connector gracefully.
+    async fn stop(&self) -> Result<(), PluginError>;
+
+    /// Returns the current health status of this connector.
+    fn health(&self) -> PluginHealth;
+}
+
+/// A parser plugin that converts raw events into structured events.
+///
+/// Sync trait — no `async_trait` needed. Parsers should be pure CPU work.
+pub trait ParserPlugin: Send + Sync {
+    /// Returns the name of this parser.
+    fn name(&self) -> &str;
+
+    /// Returns true if this parser can handle the given raw event.
+    fn can_parse(&self, raw: &RawEvent) -> bool;
+
+    /// Parse a raw event into structured events.
+    fn parse(&self, raw: &RawEvent) -> Result<Vec<serde_json::Value>, PluginError>;
+}
+
+/// Capabilities that an enricher can provide.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct EnricherCapabilities {
+    /// Fields this enricher reads (e.g. `["src_endpoint.ip"]`).
+    pub input_fields: Vec<String>,
+    /// Fields this enricher writes (e.g. `["geo.country", "geo.city"]`).
+    pub output_fields: Vec<String>,
+}
+
+/// Result of an enrichment operation.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct EnrichmentResult {
+    /// Number of fields added to the event.
+    pub fields_added: usize,
+    /// Enrichment source (e.g. `"geoip-maxmind"`).
+    pub source: String,
+}
+
+/// Enriches events with additional context (GeoIP, threat intel, etc.).
+///
+/// Sync trait — enrichment should be fast, in-memory lookups.
+pub trait EventEnricher: Send + Sync {
+    /// Returns the name of this enricher.
+    fn name(&self) -> &str;
+
+    /// Enrich an event in place, adding contextual fields.
+    fn enrich(&self, event: &mut serde_json::Value) -> EnrichmentResult;
+
+    /// Describe the enricher's capabilities.
+    fn capabilities(&self) -> EnricherCapabilities;
+}
