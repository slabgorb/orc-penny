+//! Structured error types for the plugin SDK.
+//!
+//! **SECURITY:** Display output is for internal logging only. When mapping
+//! `PluginError` to API responses, sanitize before sending to clients —
+//! do NOT expose internal plugin IDs or error details.
+
+use thiserror::Error;
+
+use crate::identity::PluginId;
+
+/// Structured plugin error hierarchy.
+///
+/// Different variants trigger different runtime behaviors:
+/// - `ConfigInvalid` → reject config submission
+/// - `HealthCheckFailed` → degrade plugin status
+/// - `NotFound` → 404 API response
+/// - `AlreadyExists` → 409 conflict
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum PluginError {
+    #[error("plugin initialization failed: {0}")]
+    InitializationFailed(String),
+
+    #[error("invalid plugin configuration: {0}")]
+    ConfigInvalid(String),
+
+    #[error("health check failed: {0}")]
+    HealthCheckFailed(String),
+
+    #[error("plugin shutdown failed: {0}")]
+    ShutdownFailed(String),
+
+    #[error("plugin not found: {0}")]
+    NotFound(PluginId),
+
+    #[error("plugin already exists: {0}")]
+    AlreadyExists(PluginId),
+
+    #[error("invalid plugin manifest: {0}")]
+    ManifestInvalid(String),
+
+    #[error("internal plugin error: {0}")]
+    Internal(String),
+}
