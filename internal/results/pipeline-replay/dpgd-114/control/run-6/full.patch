+//! Tests for PluginId and PluginKind (AC-4, AC-5).
+//!
+//! Covers:
+//! - PluginId namespace:name format, FromStr, Display, helpers
+//! - PluginKind 6 variants, serde snake_case, Display
+//! - Boundary cases: empty parts, missing colon, multiple colons
+
+use std::collections::HashSet;
+use std::str::FromStr;
+
+use axiathon_plugin_sdk_core::{PluginId, PluginKind};
+
+// ============================================================
+// AC-4: PluginId with namespace:name format
+// ============================================================
+
+// --- FromStr parsing ---
+
+#[test]
+fn plugin_id_from_str_valid_builtin() {
+    let id: PluginId = "builtin:syslog-tcp".parse().unwrap();
+    assert_eq!(id.namespace, "builtin");
+    assert_eq!(id.name, "syslog-tcp");
+}
+
+#[test]
+fn plugin_id_from_str_valid_reverse_domain() {
+    let id: PluginId = "com.claroty:xdome".parse().unwrap();
+    assert_eq!(id.namespace, "com.claroty");
+    assert_eq!(id.name, "xdome");
+}
+
+#[test]
+fn plugin_id_from_str_rejects_no_colon() {
+    assert!(PluginId::from_str("no-colon").is_err());
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_namespace() {
+    assert!(PluginId::from_str(":no-namespace").is_err());
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_name() {
+    assert!(PluginId::from_str("no-name:").is_err());
+}
+
+#[test]
+fn plugin_id_from_str_rejects_empty_string() {
+    assert!(PluginId::from_str("").is_err());
+}
+
+#[test]
+fn plugin_id_from_str_rejects_just_colon() {
+    assert!(PluginId::from_str(":").is_err());
+}
+
+#[test]
+fn plugin_id_from_str_handles_multiple_colons() {
+    // "ns:name:extra" should parse with name="name:extra" (split_once behavior)
+    let id: PluginId = "ns:name:extra".parse().unwrap();
+    assert_eq!(id.namespace, "ns");
+    assert_eq!(id.name, "name:extra");
+}
+
+// --- Display and full_id ---
+
+#[test]
+fn plugin_id_display_matches_full_id() {
+    let id = PluginId::new("builtin", "syslog-tcp");
+    assert_eq!(id.to_string(), "builtin:syslog-tcp");
+    assert_eq!(id.full_id(), "builtin:syslog-tcp");
+    assert_eq!(id.to_string(), id.full_id());
+}
+
+// --- Helper constructors ---
+
+#[test]
+fn plugin_id_builtin_helper() {
+    let id = PluginId::builtin("syslog-tcp");
+    assert_eq!(id.namespace, "builtin");
+    assert_eq!(id.name, "syslog-tcp");
+    assert_eq!(id.full_id(), "builtin:syslog-tcp");
+}
+
+#[test]
+fn plugin_id_community_helper() {
+    let id = PluginId::community("custom-parser");
+    assert_eq!(id.namespace, "community");
+    assert_eq!(id.name, "custom-parser");
+    assert_eq!(id.full_id(), "community:custom-parser");
+}
+
+// --- Derive verification ---
+
+#[test]
+fn plugin_id_debug_clone_eq_hash() {
+    let id1 = PluginId::builtin("test");
+    let id2 = id1.clone();
+    assert_eq!(id1, id2);
+
+    let mut set = HashSet::new();
+    set.insert(id1.clone());
+    assert!(set.contains(&id2));
+
+    let debug = format!("{id1:?}");
+    assert!(
+        debug.contains("PluginId"),
+        "Debug should contain type name, got: {debug}"
+    );
+}
+
+#[test]
+fn plugin_id_serde_roundtrip() {
+    let id = PluginId::builtin("syslog-tcp");
+    let json = serde_json::to_string(&id).unwrap();
+    let back: PluginId = serde_json::from_str(&json).unwrap();
+    assert_eq!(id, back);
+}
+
+#[test]
+fn plugin_id_json_contains_namespace_and_name() {
+    let id = PluginId::new("com.acme", "firewall");
+    let json = serde_json::to_value(&id).unwrap();
+    assert_eq!(json["namespace"], "com.acme");
+    assert_eq!(json["name"], "firewall");
+}
+
+// ============================================================
+// AC-5: PluginKind with 6 variants
+// ============================================================
+
+#[test]
+fn plugin_kind_display_all_variants() {
+    assert_eq!(PluginKind::Connector.to_string(), "connector");
+    assert_eq!(PluginKind::Parser.to_string(), "parser");
+    assert_eq!(PluginKind::Enricher.to_string(), "enricher");
+    assert_eq!(PluginKind::Dissector.to_string(), "dissector");
+    assert_eq!(
+        PluginKind::NotificationChannel.to_string(),
+        "notification_channel"
+    );
+    assert_eq!(PluginKind::ResponseAction.to_string(), "response_action");
+}
+
+#[test]
+fn plugin_kind_serde_snake_case() {
+    let kind = PluginKind::NotificationChannel;
+    let json = serde_json::to_string(&kind).unwrap();
+    assert_eq!(json, "\"notification_channel\"");
+    let back: PluginKind = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, kind);
+}
+
+#[test]
+fn plugin_kind_serde_all_variants_roundtrip() {
+    let variants = [
+        PluginKind::Connector,
+        PluginKind::Parser,
+        PluginKind::Enricher,
+        PluginKind::Dissector,
+        PluginKind::NotificationChannel,
+        PluginKind::ResponseAction,
+    ];
+    for kind in &variants {
+        let json = serde_json::to_string(kind).unwrap();
+        let back: PluginKind = serde_json::from_str(&json).unwrap();
+        assert_eq!(&back, kind, "round-trip failed for {kind}");
+    }
+}
+
+/// PluginKind is Copy — verified by using the original after a copy assignment.
+/// The real test is compilation; the assert verifies Display consistency.
+#[test]
+fn plugin_kind_is_copy_and_display_consistent() {
+    let kind = PluginKind::Parser;
+    let copied = kind; // Copy, not move
+    // Original is still usable (proves Copy) AND displays consistently
+    assert_eq!(kind.to_string(), copied.to_string());
+}
+
+#[test]
+fn plugin_kind_rejects_unknown_variant() {
+    let result = serde_json::from_str::<PluginKind>("\"unknown_kind\"");
+    assert!(result.is_err(), "unknown variant should fail deserialization");
+}
+
+#[test]
+fn plugin_kind_rejects_pascal_case() {
+    let result = serde_json::from_str::<PluginKind>("\"NotificationChannel\"");
+    assert!(
+        result.is_err(),
+        "PascalCase should fail — serde uses snake_case"
+    );
+}
diff --git a/crates/axiathon-plugin-sdk/core/tests/lifecycle_tests.rs b/crates/axiathon-plugin-sdk/core/tests/lifecycle_tests.rs
new file mode 100644
index 0000000..2a49553
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/core/tests/lifecycle_tests.rs
@@ -0,0 +1,216 @@
+//! Tests for AxiathonPlugin base trait (AC-2).
+//!
+//! Covers:
+//! - Trait methods: manifest, version, initialize, health_check, shutdown
+//! - Object safety: Box<dyn AxiathonPlugin>, Arc<dyn AxiathonPlugin + Send + Sync>
+//! - Full lifecycle: construct -> unhealthy -> initialize -> healthy -> shutdown
+//! - Default version() reads from manifest
+//! - Send + Sync bounds
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+
+use axiathon_plugin_sdk_core::{
+    AxiathonPlugin, PluginConfig, PluginError, PluginHealth, PluginId, PluginKind, PluginManifest,
+};
+
+// --- Test Plugin Implementation ---
+
+struct TestPlugin {
+    manifest: PluginManifest,
+    initialized: bool,
+}
+
+impl TestPlugin {
+    fn new() -> Self {
+        Self {
+            manifest: PluginManifest::new(
+                PluginId::builtin("test-plugin"),
+                "Test Plugin",
+                PluginKind::Connector,
+            ),
+            initialized: false,
+        }
+    }
+}
+
+#[async_trait]
+impl AxiathonPlugin for TestPlugin {
+    fn manifest(&self) -> &PluginManifest {
+        &self.manifest
+    }
+
+    async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+        self.initialized = true;
+        Ok(())
+    }
+
+    async fn health_check(&self) -> Result<PluginHealth, PluginError> {
+        if self.initialized {
+            Ok(PluginHealth::Healthy)
+        } else {
+            Ok(PluginHealth::Unhealthy("not initialized".into()))
+        }
+    }
+
+    async fn shutdown(&mut self) -> Result<(), PluginError> {
+        self.initialized = false;
+        Ok(())
+    }
+}
+
+// --- Failing Plugin for error path testing ---
+
+struct FailingPlugin {
+    manifest: PluginManifest,
+}
+
+impl FailingPlugin {
+    fn new() -> Self {
+        Self {
+            manifest: PluginManifest::new(
+                PluginId::builtin("failing-plugin"),
+                "Failing Plugin",
+                PluginKind::Parser,
+            ),
+        }
+    }
+}
+
+#[async_trait]
+impl AxiathonPlugin for FailingPlugin {
+    fn manifest(&self) -> &PluginManifest {
+        &self.manifest
+    }
+
+    async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+        Err(PluginError::InitializationFailed(
+            "dependency not available".into(),
+        ))
+    }
+
+    async fn health_check(&self) -> Result<PluginHealth, PluginError> {
+        Err(PluginError::HealthCheckFailed("cannot reach backend".into()))
+    }
+
+    async fn shutdown(&mut self) -> Result<(), PluginError> {
+        Err(PluginError::ShutdownFailed("resources leaked".into()))
+    }
+}
+
+// ============================================================
+// AC-2: AxiathonPlugin base trait
+// ============================================================
+
+#[tokio::test]
+async fn lifecycle_full_cycle() {
+    let mut plugin = TestPlugin::new();
+
+    // Before initialization — unhealthy
+    let health = plugin.health_check().await.unwrap();
+    assert!(
+        matches!(health, PluginHealth::Unhealthy(_)),
+        "should be unhealthy before init"
+    );
+
+    // Initialize
+    plugin
+        .initialize(serde_json::json!({"port": 1514}))
+        .await
+        .unwrap();
+
+    // After initialization — healthy
+    let health = plugin.health_check().await.unwrap();
+    assert_eq!(health, PluginHealth::Healthy);
+
+    // Shutdown
+    plugin.shutdown().await.unwrap();
+
+    // After shutdown — unhealthy again
+    let health = plugin.health_check().await.unwrap();
+    assert!(
+        matches!(health, PluginHealth::Unhealthy(_)),
+        "should be unhealthy after shutdown"
+    );
+}
+
+#[test]
+fn version_default_reads_from_manifest() {
+    let plugin = TestPlugin::new();
+    assert_eq!(plugin.version(), "0.1.0");
+    assert_eq!(plugin.version(), plugin.manifest().version);
+}
+
+#[test]
+fn manifest_returns_correct_identity() {
+    let plugin = TestPlugin::new();
+    assert_eq!(plugin.manifest().id.full_id(), "builtin:test-plugin");
+    assert_eq!(plugin.manifest().name, "Test Plugin");
+    assert_eq!(plugin.manifest().plugin_kind, PluginKind::Connector);
+}
+
+// --- Object safety (AC-13 partial) ---
+
+#[test]
+fn axiathon_plugin_is_object_safe_box() {
+    fn _take(_: Box<dyn AxiathonPlugin>) {}
+}
+
+#[test]
+fn axiathon_plugin_is_object_safe_arc() {
+    fn _take(_: Arc<dyn AxiathonPlugin + Send + Sync>) {}
+}
+
+// --- Send + Sync ---
+
+#[test]
+fn axiathon_plugin_is_send_sync() {
+    fn assert_send_sync<T: Send + Sync>() {}
+    assert_send_sync::<TestPlugin>();
+}
+
+#[tokio::test]
+async fn axiathon_plugin_can_cross_task_boundary() {
+    let plugin = TestPlugin::new();
+    let handle = tokio::spawn(async move {
+        plugin.manifest().id.full_id()
+    });
+    let result = handle.await.unwrap();
+    assert_eq!(result, "builtin:test-plugin");
+}
+
+// --- Error paths ---
+
+#[tokio::test]
+async fn initialize_failure_returns_error() {
+    let mut plugin = FailingPlugin::new();
+    let result = plugin.initialize(serde_json::json!({})).await;
+    assert!(result.is_err());
+    assert!(matches!(
+        result.unwrap_err(),
+        PluginError::InitializationFailed(_)
+    ));
+}
+
+#[tokio::test]
+async fn health_check_failure_returns_error() {
+    let plugin = FailingPlugin::new();
+    let result = plugin.health_check().await;
+    assert!(result.is_err());
+    assert!(matches!(
+        result.unwrap_err(),
+        PluginError::HealthCheckFailed(_)
+    ));
+}
+
+#[tokio::test]
+async fn shutdown_failure_returns_error() {
+    let mut plugin = FailingPlugin::new();
+    let result = plugin.shutdown().await;
+    assert!(result.is_err());
+    assert!(matches!(
+        result.unwrap_err(),
+        PluginError::ShutdownFailed(_)
+    ));
+}
diff --git a/crates/axiathon-plugin-sdk/core/tests/manifest_tests.rs b/crates/axiathon-plugin-sdk/core/tests/manifest_tests.rs
