+++ b/crates/axiathon-plugin-sdk/core/tests/manifest_tests.rs
@@ -0,0 +1,217 @@
+//! Tests for PluginManifest and config validation (AC-3, AC-8).
+//!
+//! Covers:
+//! - PluginManifest 14 fields, serde round-trip
+//! - validate_config with JSON Schema
+//! - SignatureMetadata placeholder
+//! - PluginConfig type alias
+
+use axiathon_plugin_sdk_core::{
+    PluginConfig, PluginError, PluginId, PluginKind, PluginManifest, SignatureMetadata,
+};
+
+// ============================================================
+// AC-3: PluginManifest with 14 fields
+// ============================================================
+
+fn sample_manifest() -> PluginManifest {
+    PluginManifest {
+        schema_version: "1.0".into(),
+        id: PluginId::builtin("syslog-tcp"),
+        name: "Syslog TCP Connector".into(),
+        version: "0.1.0".into(),
+        description: "Receives syslog over TCP".into(),
+        plugin_kind: PluginKind::Connector,
+        category: "network".into(),
+        config_schema: Some(serde_json::json!({
+            "type": "object",
+            "properties": {
+                "port": {
+                    "type": "number",
+                    "description": "TCP port",
+                    "default": 1514,
+                    "x-ui-widget": "number",
+                    "x-ui-order": 1
+                }
+            },
+            "required": ["port"]
+        })),
+        permissions: vec!["network:listen".into()],
+        tags: vec!["syslog".into(), "network".into()],
+        ocsf_classes: vec![4001, 4002],
+        ocsf_version: Some("1.7.0".into()),
+        signature: None,
+    }
+}
+
+#[test]
+fn manifest_json_roundtrip() {
+    let manifest = sample_manifest();
+    let json = serde_json::to_string(&manifest).unwrap();
+    let back: PluginManifest = serde_json::from_str(&json).unwrap();
+    assert_eq!(back.id.full_id(), "builtin:syslog-tcp");
+    assert_eq!(back.name, "Syslog TCP Connector");
+    assert_eq!(back.plugin_kind, PluginKind::Connector);
+    assert_eq!(back.permissions.len(), 1);
+    assert_eq!(back.tags.len(), 2);
+    assert_eq!(back.ocsf_classes, vec![4001, 4002]);
+    assert_eq!(back.ocsf_version.as_deref(), Some("1.7.0"));
+    assert!(back.signature.is_none());
+}
+
+#[test]
+fn manifest_preserves_x_ui_extensions() {
+    let manifest = sample_manifest();
+    let json = serde_json::to_value(&manifest).unwrap();
+    assert_eq!(
+        json["config_schema"]["properties"]["port"]["x-ui-widget"],
+        "number"
+    );
+    assert_eq!(
+        json["config_schema"]["properties"]["port"]["x-ui-order"], 1
+    );
+}
+
+#[test]
+fn manifest_has_all_required_field_names() {
+    let manifest = sample_manifest();
+    let json = serde_json::to_value(&manifest).unwrap();
+    let obj = json.as_object().unwrap();
+    // AC-3 requires 13 named fields (signature may be None/skipped).
+    // Verify each field name is present rather than just counting.
+    let required = [
+        "schema_version",
+        "id",
+        "name",
+        "version",
+        "description",
+        "plugin_kind",
+        "category",
+        "config_schema",
+        "permissions",
+        "tags",
+        "ocsf_classes",
+        "ocsf_version",
+    ];
+    for field in &required {
+        assert!(
+            obj.contains_key(*field),
+            "manifest JSON missing required field '{field}', keys: {keys:?}",
+            keys = obj.keys().collect::<Vec<_>>()
+        );
+    }
+}
+
+#[test]
+fn manifest_new_minimal_constructor() {
+    let manifest = PluginManifest::new(
+        PluginId::builtin("test-plugin"),
+        "Test Plugin",
+        PluginKind::Parser,
+    );
+    assert_eq!(manifest.schema_version, "1.0");
+    assert_eq!(manifest.id.full_id(), "builtin:test-plugin");
+    assert_eq!(manifest.name, "Test Plugin");
+    assert_eq!(manifest.version, "0.1.0");
+    assert_eq!(manifest.plugin_kind, PluginKind::Parser);
+    assert!(manifest.permissions.is_empty());
+    assert!(manifest.tags.is_empty());
+    assert!(manifest.ocsf_classes.is_empty());
+    assert!(manifest.ocsf_version.is_none());
+    assert!(manifest.signature.is_none());
+}
+
+#[test]
+fn manifest_with_signature_metadata() {
+    let manifest = PluginManifest {
+        signature: Some(SignatureMetadata {
+            algorithm: "ed25519".into(),
+            key_id: "key-001".into(),
+            signature: "deadbeef".into(),
+        }),
+        ..PluginManifest::new(
+            PluginId::builtin("signed"),
+            "Signed Plugin",
+            PluginKind::Connector,
+        )
+    };
+    let json = serde_json::to_string(&manifest).unwrap();
+    let back: PluginManifest = serde_json::from_str(&json).unwrap();
+    let sig = back.signature.unwrap();
+    assert_eq!(sig.algorithm, "ed25519");
+    assert_eq!(sig.key_id, "key-001");
+    assert_eq!(sig.signature, "deadbeef");
+}
+
+// ============================================================
+// AC-8: PluginConfig and validate_config
+// ============================================================
+
+#[test]
+fn validate_config_accepts_valid_config() {
+    let manifest = sample_manifest();
+    let config: PluginConfig = serde_json::json!({"port": 1514});
+    assert!(manifest.validate_config(&config).is_ok());
+}
+
+#[test]
+fn validate_config_rejects_invalid_type() {
+    let manifest = sample_manifest();
+    // port should be number, not string
+    let config: PluginConfig = serde_json::json!({"port": "not-a-number"});
+    let result = manifest.validate_config(&config);
+    assert!(result.is_err());
+    assert!(
+        matches!(result.unwrap_err(), PluginError::ConfigInvalid(_)),
+        "wrong config should produce ConfigInvalid"
+    );
+}
+
+#[test]
+fn validate_config_rejects_missing_required_field() {
+    let manifest = sample_manifest();
+    // "port" is required but missing
+    let config: PluginConfig = serde_json::json!({});
+    let result = manifest.validate_config(&config);
+    assert!(result.is_err());
+    assert!(
+        matches!(result.unwrap_err(), PluginError::ConfigInvalid(_)),
+        "missing required field should produce ConfigInvalid"
+    );
+}
+
+#[test]
+fn validate_config_none_schema_accepts_anything() {
+    let manifest = PluginManifest {
+        config_schema: None,
+        ..PluginManifest::new(
+            PluginId::builtin("no-schema"),
+            "No Schema",
+            PluginKind::Parser,
+        )
+    };
+    let config: PluginConfig = serde_json::json!({"anything": "goes", "number": 42});
+    assert!(manifest.validate_config(&config).is_ok());
+}
+
+#[test]
+fn validate_config_empty_object_schema_accepts_empty() {
+    let manifest = PluginManifest {
+        config_schema: Some(serde_json::json!({"type": "object", "properties": {}})),
+        ..PluginManifest::new(
+            PluginId::builtin("empty-schema"),
+            "Empty Schema",
+            PluginKind::Parser,
+        )
+    };
+    let config: PluginConfig = serde_json::json!({});
+    assert!(manifest.validate_config(&config).is_ok());
+}
+
+#[test]
+fn plugin_config_is_serde_json_value() {
+    // PluginConfig should be usable as serde_json::Value
+    let config: PluginConfig = serde_json::json!({"key": "value"});
+    assert!(config.is_object());
+    assert_eq!(config["key"], "value");
+}
