+//! Tests for PluginHealth (AC-6) and PluginError (AC-7).
+//!
+//! Covers:
+//! - PluginHealth 3 states, serde round-trip
+//! - PluginError 8 variants, Display, Error trait, Send + Sync
+//! - Error matching for runtime behavior dispatch
+
+use axiathon_plugin_sdk_core::{PluginError, PluginHealth, PluginId};
+
+// ============================================================
+// AC-6: PluginHealth with 3 states
+// ============================================================
+
+/// Healthy variant serde round-trips correctly (not just self-equality).
+#[test]
+fn plugin_health_healthy_serde_roundtrip() {
+    let h = PluginHealth::Healthy;
+    let json = serde_json::to_string(&h).unwrap();
+    let back: PluginHealth = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, PluginHealth::Healthy);
+}
+
+#[test]
+fn plugin_health_degraded_carries_reason() {
+    let h = PluginHealth::Degraded("high latency".into());
+    if let PluginHealth::Degraded(reason) = &h {
+        assert_eq!(reason, "high latency");
+    } else {
+        panic!("expected Degraded variant");
+    }
+}
+
+#[test]
+fn plugin_health_unhealthy_carries_reason() {
+    let h = PluginHealth::Unhealthy("connection refused".into());
+    if let PluginHealth::Unhealthy(reason) = &h {
+        assert_eq!(reason, "connection refused");
+    } else {
+        panic!("expected Unhealthy variant");
+    }
+}
+
+#[test]
+fn plugin_health_serde_roundtrip() {
+    let variants = [
+        PluginHealth::Healthy,
+        PluginHealth::Degraded("slow".into()),
+        PluginHealth::Unhealthy("down".into()),
+    ];
+    for health in &variants {
+        let json = serde_json::to_string(health).unwrap();
+        let back: PluginHealth = serde_json::from_str(&json).unwrap();
+        assert_eq!(&back, health, "round-trip failed for {health:?}");
+    }
+}
+
+#[test]
+fn plugin_health_derives_debug_clone_eq() {
+    let h1 = PluginHealth::Degraded("slow".into());
+    let h2 = h1.clone();
+    assert_eq!(h1, h2);
+    let debug = format!("{h1:?}");
+    assert!(debug.contains("Degraded"));
+}
+
+// ============================================================
+// AC-7: PluginError structured error hierarchy
+// ============================================================
+
+#[test]
+fn plugin_error_initialization_failed() {
+    let err = PluginError::InitializationFailed("missing config".into());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("missing config"),
+        "InitializationFailed display should contain message, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_config_invalid() {
+    let err = PluginError::ConfigInvalid("port must be number".into());
+    let msg = err.to_string();
+    assert!(msg.contains("port must be number"));
+}
+
+#[test]
+fn plugin_error_health_check_failed() {
+    let err = PluginError::HealthCheckFailed("timeout after 5s".into());
+    let msg = err.to_string();
+    assert!(msg.contains("timeout after 5s"));
+}
+
+#[test]
+fn plugin_error_shutdown_failed() {
+    let err = PluginError::ShutdownFailed("resources leaked".into());
+    let msg = err.to_string();
+    assert!(msg.contains("resources leaked"));
+}
+
+#[test]
+fn plugin_error_not_found_with_plugin_id() {
+    let id = PluginId::builtin("nonexistent");
+    let err = PluginError::NotFound(id);
+    let msg = err.to_string();
+    assert!(
+        msg.contains("builtin:nonexistent"),
+        "NotFound display must contain the plugin id, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_already_exists_with_plugin_id() {
+    let id = PluginId::builtin("duplicate");
+    let err = PluginError::AlreadyExists(id);
+    let msg = err.to_string();
+    assert!(
+        msg.contains("builtin:duplicate"),
+        "AlreadyExists display must contain the plugin id, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_manifest_invalid() {
+    let err = PluginError::ManifestInvalid("missing required field 'id'".into());
+    let msg = err.to_string();
+    assert!(msg.contains("missing required field"));
+}
+
+#[test]
+fn plugin_error_internal() {
+    let err = PluginError::Internal("unexpected state".into());
+    let msg = err.to_string();
+    assert!(msg.contains("unexpected state"));
+}
+
+#[test]
+fn plugin_error_implements_std_error() {
+    fn assert_error<T: std::error::Error>() {}
+    assert_error::<PluginError>();
+}
+
+#[test]
+fn plugin_error_implements_send_sync() {
+    fn assert_send_sync<T: Send + Sync + 'static>() {}
+    assert_send_sync::<PluginError>();
+}
+
+#[test]
+fn plugin_error_is_debug() {
+    let err = PluginError::Internal("test".into());
+    let debug = format!("{err:?}");
+    assert!(
+        debug.contains("Internal"),
+        "Debug output should contain variant name, got: {debug}"
+    );
+}
+
+/// Verify that different error variants can be pattern-matched for runtime dispatch.
+/// This is critical: ConfigInvalid -> reject config, HealthCheckFailed -> degrade status,
+/// NotFound -> 404 API response.
+#[test]
+fn plugin_error_variants_are_matchable() {
+    fn classify_error(err: &PluginError) -> &str {
+        match err {
+            PluginError::ConfigInvalid(_) => "reject_config",
+            PluginError::HealthCheckFailed(_) => "degrade_status",
+            PluginError::NotFound(_) => "not_found_404",
+            PluginError::AlreadyExists(_) => "conflict_409",
+            PluginError::InitializationFailed(_) => "init_failure",
+            PluginError::ShutdownFailed(_) => "shutdown_failure",
+            PluginError::ManifestInvalid(_) => "bad_manifest",
+            PluginError::Internal(_) => "internal_500",
+            _ => "unknown",
+        }
+    }
+
+    assert_eq!(
+        classify_error(&PluginError::ConfigInvalid("x".into())),
+        "reject_config"
+    );
+    assert_eq!(
+        classify_error(&PluginError::NotFound(PluginId::builtin("x"))),
+        "not_found_404"
+    );
+    assert_eq!(
+        classify_error(&PluginError::Internal("x".into())),
+        "internal_500"
+    );
+}
+
+/// PluginError should propagate via ? operator across function boundaries.
+#[test]
+fn plugin_error_propagates_with_question_mark() {
+    fn inner() -> Result<(), PluginError> {
+        Err(PluginError::ConfigInvalid("bad".into()))
+    }
+    fn outer() -> Result<(), PluginError> {
+        inner()?;
+        Ok(())
+    }
+    let result = outer();
+    assert!(matches!(
+        result.unwrap_err(),
+        PluginError::ConfigInvalid(_)
+    ));
+}
