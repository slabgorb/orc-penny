+//! Tests for action sub-crate traits (AC-12).
+//!
+//! Covers:
+//! - ResponseAction trait: name, execute, capabilities, validate_params
+//! - ActionCapabilities and ActionResult supporting types
+//! - Object safety
+//! - async_trait for dyn dispatch
+
+use axiathon_plugin_sdk_action::{ActionCapabilities, ActionResult, ResponseAction};
+
+// --- ActionCapabilities ---
+
+#[test]
+fn action_capabilities_serde_roundtrip() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["block_ip".into(), "isolate_host".into()],
+        reversible: true,
+    };
+    let json = serde_json::to_string(&caps).unwrap();
+    let back: ActionCapabilities = serde_json::from_str(&json).unwrap();
+    assert_eq!(back.supported_actions, vec!["block_ip", "isolate_host"]);
+    assert!(back.reversible);
+}
+
+// --- ActionResult ---
+
+#[test]
+fn action_result_serde_roundtrip() {
+    let result = ActionResult {
+        success: false,
+        message: "timeout".into(),
+        reversible: false,
+        action_id: "act-002".into(),
+    };
+    let json = serde_json::to_string(&result).unwrap();
+    let back: ActionResult = serde_json::from_str(&json).unwrap();
+    assert!(!back.success);
+    assert_eq!(back.message, "timeout");
+    assert!(!back.reversible);
+    assert_eq!(back.action_id, "act-002");
+}
+
+// --- ResponseAction Object Safety (compile-time check for AC-13) ---
+
+#[test]
+fn response_action_is_object_safe() {
+    fn _take(_: Box<dyn ResponseAction>) {}
+}
