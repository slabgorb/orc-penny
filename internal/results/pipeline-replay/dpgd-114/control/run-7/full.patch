+    assert!(result.is_err(), "PluginId should reject whitespace-only parts");
+}
+
+#[test]
+fn plugin_error_display_initialization_failed_includes_context() {
+    let err = PluginError::InitializationFailed("database connection refused".to_string());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("initialization") && msg.contains("database connection refused"),
+        "Display should include both error type and detail, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_display_not_found_includes_plugin_id() {
+    let err = PluginError::NotFound(PluginId::builtin("missing"));
+    let msg = err.to_string();
+    assert!(
+        msg.contains("not found") && msg.contains("builtin:missing"),
+        "NotFound display should include error kind and plugin id, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_error_display_already_exists_includes_plugin_id() {
+    let err = PluginError::AlreadyExists(PluginId::community("duplicate"));
+    let msg = err.to_string();
+    assert!(
+        msg.contains("already") && msg.contains("community:duplicate"),
+        "AlreadyExists display should include error kind and plugin id, got: {msg}"
+    );
+}
+
+#[test]
+fn plugin_kind_deserialize_rejects_unknown_variant() {
+    let result: Result<PluginKind, _> = serde_json::from_str("\"unknown_kind\"");
+    assert!(result.is_err(), "Unknown variant should fail deserialization");
+}
+
+#[test]
+fn plugin_manifest_deserialization_with_missing_optional_fields() {
+    // JSON with only required fields — optional fields should deserialize to defaults
+    let json = serde_json::json!({
+        "schema_version": "1.0",
+        "id": { "namespace": "builtin", "name": "test" },
+        "name": "Test Plugin",
+        "version": "0.1.0",
+        "description": "",
+        "plugin_kind": "parser",
+        "category": ""
+    });
