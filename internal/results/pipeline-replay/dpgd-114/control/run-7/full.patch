+// Object safety — AC-13
+// ============================================================
+
+#[test]
+fn connector_plugin_is_object_safe() {
+    fn _take(_: &dyn ConnectorPlugin) {}
+}
+
+#[test]
+fn parser_plugin_is_object_safe() {
+    fn _take(_: &dyn ParserPlugin) {}
+}
+
+#[test]
+fn event_enricher_is_object_safe() {
+    fn _take(_: &dyn EventEnricher) {}
+}
