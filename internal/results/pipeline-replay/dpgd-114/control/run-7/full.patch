+#[tokio::test]
+async fn axiathon_plugin_lifecycle_test() {
+    struct TestPlugin {
+        manifest: PluginManifest,
+        initialized: bool,
+    }
+
+    impl TestPlugin {
+        fn new() -> Self {
+            Self {
+                manifest: PluginManifest::new(
+                    PluginId::builtin("test-lifecycle"),
+                    "Test Lifecycle Plugin",
+                    PluginKind::Parser,
+                ),
+                initialized: false,
+            }
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl AxiathonPlugin for TestPlugin {
+        fn manifest(&self) -> &PluginManifest {
+            &self.manifest
+        }
+
+        async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+            self.initialized = true;
+            Ok(())
+        }
+
+        async fn health_check(&self) -> Result<PluginHealth, PluginError> {
+            if self.initialized {
+                Ok(PluginHealth::Healthy)
+            } else {
+                Ok(PluginHealth::Unhealthy("not initialized".to_string()))
+            }
+        }
+
+        async fn shutdown(&mut self) -> Result<(), PluginError> {
+            self.initialized = false;
+            Ok(())
+        }
+    }
+
+    let mut plugin = TestPlugin::new();
+
+    // Before init: unhealthy
+    let health = plugin.health_check().await.unwrap();
+    assert_eq!(health, PluginHealth::Unhealthy("not initialized".to_string()));
+
+    // Initialize
+    plugin.initialize(serde_json::json!({})).await.unwrap();
+
+    // After init: healthy
+    let health = plugin.health_check().await.unwrap();
+    assert_eq!(health, PluginHealth::Healthy);
+
+    // Version comes from manifest
+    assert_eq!(plugin.version(), "0.1.0");
+
+    // Shutdown
+    plugin.shutdown().await.unwrap();
+
+    // After shutdown: unhealthy
+    let health = plugin.health_check().await.unwrap();
+    assert_eq!(health, PluginHealth::Unhealthy("not initialized".to_string()));
+}
