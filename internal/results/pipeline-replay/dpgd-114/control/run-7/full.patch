+//! Ingestion plugin traits: ConnectorPlugin, ParserPlugin, EventEnricher.
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use tokio::sync::mpsc;
+
+use axiathon_core::TenantId;
+use axiathon_plugin_sdk_core::error::PluginError;
+use axiathon_plugin_sdk_core::health::PluginHealth;
+
+/// Raw event data from a connector.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RawEvent {
+    pub data: Vec<u8>,
+    pub source: String,
+    pub received_at: DateTime<Utc>,
+    pub tenant_id: TenantId,
+    pub metadata: HashMap<String, String>,
+}
+
+/// Capabilities of an enricher plugin.
+#[derive(Debug, Clone)]
+pub struct EnricherCapabilities {
+    pub input_fields: Vec<String>,
+    pub output_fields: Vec<String>,
+}
+
+/// Result of an enrichment operation.
+#[derive(Debug, Clone)]
+pub struct EnrichmentResult {
+    pub fields_added: usize,
+    pub source: String,
+}
+
+// STUB: Traits not yet defined — tests will fail to compile or fail on assertions.
+// ConnectorPlugin, ParserPlugin, EventEnricher must be defined by Dev.
+
+/// Connector plugin trait — manages connections to data sources.
+///
+/// STUB: supertrait requirement missing — tests should verify AxiathonPlugin supertrait.
+#[async_trait]
+pub trait ConnectorPlugin: Send + Sync {
+    fn name(&self) -> &str;
+    async fn start(&self, tx: mpsc::Sender<RawEvent>) -> Result<(), PluginError>;
+    async fn stop(&self) -> Result<(), PluginError>;
+    fn health(&self) -> PluginHealth;
+}
+
+/// Parser plugin trait — parses raw events into structured events.
+///
+/// STUB: Sync trait, no async. Supertrait requirement missing.
+pub trait ParserPlugin: Send + Sync {
+    fn name(&self) -> &str;
+    fn can_parse(&self, raw: &RawEvent) -> bool;
+    // STUB: returns empty vec instead of using AxiathonEvent — placeholder for Story 2.16
+    fn parse(&self, raw: &RawEvent) -> Result<Vec<serde_json::Value>, PluginError>;
+}
+
+/// Event enricher trait — enriches parsed events with additional context.
+///
+/// STUB: Sync trait. Supertrait requirement missing.
+pub trait EventEnricher: Send + Sync {
+    fn name(&self) -> &str;
+    fn enrich(&self, event: &mut serde_json::Value) -> EnrichmentResult;
+    fn capabilities(&self) -> EnricherCapabilities;
+}
