+// ============================================================
+// EnricherCapabilities and EnrichmentResult
+// ============================================================
+
+#[test]
+fn enricher_capabilities_fields() {
+    let caps = EnricherCapabilities {
+        input_fields: vec!["src_ip".to_string()],
+        output_fields: vec!["geo_country".to_string(), "geo_city".to_string()],
+    };
