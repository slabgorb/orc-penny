+//! - ConnectorPlugin trait definition and object safety
+//! - ParserPlugin trait definition and object safety
+//! - EventEnricher trait definition and object safety
+//! - RawEvent, EnricherCapabilities, EnrichmentResult types
+
+use std::collections::HashMap;
+
+use axiathon_plugin_sdk_ingestion::{
+    ConnectorPlugin, EnricherCapabilities, EnrichmentResult, EventEnricher, ParserPlugin, RawEvent,
+};
+
+// ============================================================
+// RawEvent supporting type
+// ============================================================
+
+#[test]
+fn raw_event_creation() {
+    let event = RawEvent {
+        data: b"test log line".to_vec(),
+        source: "syslog-tcp".to_string(),
+        received_at: chrono::Utc::now(),
+        tenant_id: axiathon_core::TenantId::new_unchecked("test-tenant"),
+        metadata: HashMap::from([("key".to_string(), "value".to_string())]),
+    };
+    assert_eq!(event.source, "syslog-tcp");
+    assert_eq!(event.data, b"test log line");
+    assert!(!event.metadata.is_empty());
+}
+
+#[test]
+fn raw_event_data_as_str() {
+    let event = RawEvent {
+        data: b"hello world".to_vec(),
+        source: "test".to_string(),
+        received_at: chrono::Utc::now(),
+        tenant_id: axiathon_core::TenantId::new_unchecked("t1"),
+        metadata: HashMap::new(),
+    };
+    let text = std::str::from_utf8(&event.data).unwrap();
+    assert_eq!(text, "hello world");
+}
+
+#[test]
+fn raw_event_serde_round_trip() {
+    let event = RawEvent {
+        data: b"log data".to_vec(),
+        source: "connector-1".to_string(),
+        received_at: chrono::Utc::now(),
+        tenant_id: axiathon_core::TenantId::new_unchecked("tenant-1"),
+        metadata: HashMap::new(),
+    };
+    let json = serde_json::to_string(&event).unwrap();
+    let back: RawEvent = serde_json::from_str(&json).unwrap();
+    assert_eq!(back.source, "connector-1");
+}
