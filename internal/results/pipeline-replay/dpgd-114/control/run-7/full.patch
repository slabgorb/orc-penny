+    #[serde(default)]
+    pub tags: Vec<String>,
+    #[serde(default)]
+    pub ocsf_classes: Vec<i32>,
+    #[serde(default)]
+    pub ocsf_version: Option<String>,
+    #[serde(default)]
+    pub signature: Option<SignatureMetadata>,
+}
+
+impl PluginManifest {
+    /// Minimal constructor for test convenience.
+    pub fn new(id: PluginId, name: impl Into<String>, kind: PluginKind) -> Self {
+        Self {
+            schema_version: "1.0".to_string(),
+            id,
+            name: name.into(),
+            version: "0.1.0".to_string(),
+            description: String::new(),
+            plugin_kind: kind,
+            category: String::new(),
+            config_schema: None,
+            permissions: Vec::new(),
+            tags: Vec::new(),
+            ocsf_classes: Vec::new(),
+            ocsf_version: None,
+            signature: None,
+        }
+    }
+
+    /// Validate config against config_schema using jsonschema.
+    ///
+    /// If `config_schema` is `None`, any config is accepted.
+    /// Returns `PluginError::ConfigInvalid` with detail on validation failure.
+    pub fn validate_config(&self, config: &PluginConfig) -> Result<(), PluginError> {
+        let Some(schema) = &self.config_schema else {
+            return Ok(());
+        };
+        let validator = jsonschema::validator_for(schema).map_err(|e| {
+            PluginError::ManifestInvalid(format!("invalid config_schema: {e}"))
+        })?;
+        let errors: Vec<String> = validator
+            .iter_errors(config)
+            .map(|e| e.to_string())
+            .collect();
+        if !errors.is_empty() {
+            return Err(PluginError::ConfigInvalid(errors.join("; ")));
+        }
+        Ok(())
+    }
+}
