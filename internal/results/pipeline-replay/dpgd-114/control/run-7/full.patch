+//! Integration tests for axiathon-plugin-sdk facade (Story 23.1, AC-1).
+//!
+//! Verifies that the facade crate re-exports all sub-crate modules correctly,
+//! allowing downstream consumers to use `axiathon_plugin_sdk::core::PluginId`
+//! instead of `axiathon_plugin_sdk_core::PluginId`.
+
+// ============================================================
+// AC-1: All 6 sub-crates accessible via facade
+// ============================================================
+
+#[test]
+fn facade_re_exports_core_module() {
+    let id = axiathon_plugin_sdk::core::PluginId::builtin("test");
+    assert_eq!(id.namespace(), "builtin");
+    let kind = axiathon_plugin_sdk::core::PluginKind::Parser;
+    assert_eq!(kind.to_string(), "parser");
+    let health = axiathon_plugin_sdk::core::PluginHealth::Healthy;
+    assert_eq!(health, axiathon_plugin_sdk::core::PluginHealth::Healthy);
+}
+
+#[test]
+fn facade_re_exports_ingestion_module() {
+    let caps = axiathon_plugin_sdk::ingestion::EnricherCapabilities {
+        input_fields: vec!["src_ip".to_string()],
+        output_fields: vec![],
+    };
+    assert_eq!(caps.input_fields.len(), 1);
+}
+
+#[test]
+fn facade_re_exports_network_module() {
+    let info = axiathon_plugin_sdk::network::ProtocolInfo {
+        name: "DNS".to_string(),
+        description: "test".to_string(),
+        default_ports: vec![53],
+    };
+    assert_eq!(info.name, "DNS");
+}
+
+#[test]
+fn facade_re_exports_notification_module() {
+    let notif = axiathon_plugin_sdk::notification::Notification {
+        title: "test".to_string(),
+        body: "test".to_string(),
+        severity: "info".to_string(),
+        metadata: std::collections::HashMap::new(),
+    };
+    assert_eq!(notif.severity, "info");
+}
+
+#[test]
+fn facade_re_exports_action_module() {
+    let caps = axiathon_plugin_sdk::action::ActionCapabilities {
+        supported_actions: vec!["block".to_string()],
+        reversible: false,
+    };
+    assert_eq!(caps.supported_actions.len(), 1);
+    assert!(!caps.reversible);
+}
+
+// ============================================================
+// Cross-crate type usage via facade
+// ============================================================
+
+#[test]
+fn facade_core_manifest_with_kind() {
+    let manifest = axiathon_plugin_sdk::core::PluginManifest::new(
+        axiathon_plugin_sdk::core::PluginId::builtin("test"),
+        "Test Plugin",
+        axiathon_plugin_sdk::core::PluginKind::Connector,
+    );
+    assert_eq!(manifest.name, "Test Plugin");
+}
+
+// ============================================================
+// Object safety through facade — AC-13
+// ============================================================
+
+#[test]
+fn facade_all_traits_object_safe() {
+    fn _take_plugin(_: Box<dyn axiathon_plugin_sdk::core::AxiathonPlugin>) {}
+    fn _take_connector(_: Box<dyn axiathon_plugin_sdk::ingestion::ConnectorPlugin>) {}
+    fn _take_parser(_: Box<dyn axiathon_plugin_sdk::ingestion::ParserPlugin>) {}
+    fn _take_enricher(_: Box<dyn axiathon_plugin_sdk::ingestion::EventEnricher>) {}
+    fn _take_dissector(_: Box<dyn axiathon_plugin_sdk::network::ProtocolDissector>) {}
+    fn _take_notifier(_: Box<dyn axiathon_plugin_sdk::notification::NotificationChannel>) {}
+    fn _take_action(_: Box<dyn axiathon_plugin_sdk::action::ResponseAction>) {}
+}
