+//! Plugin identity types: PluginId and PluginKind.
+
+use serde::{Deserialize, Serialize};
+use std::fmt;
+use std::str::FromStr;
+
+use crate::error::PluginError;
+
+/// Namespaced plugin identifier in `namespace:name` format.
+///
+/// Fields are private to prevent post-construction mutation of plugin identity.
+/// Use getters to access namespace and name.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct PluginId {
+    namespace: String,
+    name: String,
+}
+
+impl PluginId {
+    /// Create a new PluginId with explicit namespace and name.
+    pub fn new(namespace: impl Into<String>, name: impl Into<String>) -> Self {
+        Self {
+            namespace: namespace.into(),
+            name: name.into(),
+        }
+    }
+
+    /// Create a builtin plugin id (namespace: "builtin").
+    pub fn builtin(name: impl Into<String>) -> Self {
+        Self::new("builtin", name)
+    }
+
+    /// Create a community plugin id (namespace: "community").
+    pub fn community(name: impl Into<String>) -> Self {
+        Self::new("community", name)
+    }
+
+    /// Full identifier string: "namespace:name".
+    pub fn full_id(&self) -> String {
+        format!("{self}")
+    }
+
+    /// Access the namespace component.
+    pub fn namespace(&self) -> &str {
+        &self.namespace
+    }
+
+    /// Access the name component.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+impl fmt::Display for PluginId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.namespace, self.name)
+    }
+}
+
+impl FromStr for PluginId {
+    type Err = PluginError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let parts: Vec<&str> = s.splitn(2, ':').collect();
+        if parts.len() != 2 {
+            return Err(PluginError::ManifestInvalid(format!(
+                "invalid plugin id format (expected 'namespace:name'): {s}"
+            )));
+        }
+        let namespace = parts[0].trim();
+        let name = parts[1].trim();
+        if namespace.is_empty() {
+            return Err(PluginError::ManifestInvalid(
+                "plugin id namespace cannot be empty".to_string(),
+            ));
+        }
+        if name.is_empty() {
+            return Err(PluginError::ManifestInvalid(
+                "plugin id name cannot be empty".to_string(),
+            ));
+        }
+        Ok(Self {
+            namespace: namespace.to_string(),
+            name: name.to_string(),
+        })
+    }
+}
+
+/// The 6 plugin type variants.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+#[non_exhaustive]
+pub enum PluginKind {
+    Connector,
+    Parser,
+    Enricher,
+    Dissector,
+    NotificationChannel,
+    ResponseAction,
+}
+
+impl fmt::Display for PluginKind {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Connector => write!(f, "connector"),
+            Self::Parser => write!(f, "parser"),
+            Self::Enricher => write!(f, "enricher"),
+            Self::Dissector => write!(f, "dissector"),
+            Self::NotificationChannel => write!(f, "notification_channel"),
+            Self::ResponseAction => write!(f, "response_action"),
+        }
+    }
+}
