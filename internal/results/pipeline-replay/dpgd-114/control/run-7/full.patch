+//! AxiathonPlugin base trait — lifecycle management for all plugin types.
+
+use async_trait::async_trait;
+
+use crate::config::PluginConfig;
+use crate::error::PluginError;
+use crate::health::PluginHealth;
+use crate::manifest::PluginManifest;
+
+/// Base trait for all Axiathon plugins.
+///
+/// All plugin types (parser, connector, enricher, dissector, notification, action)
+/// must implement this trait for shared lifecycle management.
+#[async_trait]
+pub trait AxiathonPlugin: Send + Sync {
+    /// Returns the plugin's manifest.
+    fn manifest(&self) -> &PluginManifest;
+
+    /// Returns the plugin version (default reads from manifest).
+    fn version(&self) -> &str {
+        &self.manifest().version
+    }
+
+    /// Initialize the plugin with the given configuration.
+    async fn initialize(&mut self, config: PluginConfig) -> Result<(), PluginError>;
+
+    /// Check plugin health.
+    async fn health_check(&self) -> Result<PluginHealth, PluginError>;
+
+    /// Gracefully shut down the plugin.
+    async fn shutdown(&mut self) -> Result<(), PluginError>;
+}
