+}
+
+/// Result of executing a response action.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ActionResult {
+    pub success: bool,
+    pub message: String,
+    pub reversible: bool,
+    pub action_id: String,
+}
