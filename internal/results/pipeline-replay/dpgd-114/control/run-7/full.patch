+//! Integration tests for axiathon-plugin-sdk-action (Story 23.1, AC-12).
+//!
+//! Covers:
+//! - ResponseAction trait definition and object safety
+//! - ActionCapabilities and ActionResult supporting types
+
+use axiathon_plugin_sdk_action::{ActionCapabilities, ActionResult, ResponseAction};
+
+// ============================================================
+// ActionCapabilities supporting type
+// ============================================================
+
+#[test]
+fn action_capabilities_creation() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["block_ip".to_string(), "quarantine_host".to_string()],
+        reversible: true,
+    };
+    assert_eq!(caps.supported_actions.len(), 2);
+    assert!(caps.reversible);
+}
+
+#[test]
+fn action_capabilities_serde_round_trip() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["isolate".to_string()],
+        reversible: false,
+    };
+    let json = serde_json::to_string(&caps).unwrap();
+    let back: ActionCapabilities = serde_json::from_str(&json).unwrap();
+    assert_eq!(back.supported_actions, vec!["isolate"]);
+    assert!(!back.reversible);
+}
+
+// ============================================================
+// ActionResult supporting type
+// ============================================================
+
+#[test]
+fn action_result_creation() {
+    let result = ActionResult {
+        success: true,
+        message: "IP blocked successfully".to_string(),
+        reversible: true,
+        action_id: "act-001".to_string(),
+    };
+    assert!(result.success);
+    assert_eq!(result.message, "IP blocked successfully");
+    assert!(result.reversible);
+    assert_eq!(result.action_id, "act-001");
+}
+
+#[test]
+fn action_result_serde_round_trip() {
+    let result = ActionResult {
+        success: false,
+        message: "timeout".to_string(),
+        reversible: false,
+        action_id: "act-002".to_string(),
+    };
+    let json = serde_json::to_string(&result).unwrap();
+    let back: ActionResult = serde_json::from_str(&json).unwrap();
+    assert!(!back.success);
+    assert_eq!(back.action_id, "act-002");
+}
+
+// ============================================================
+// Object safety — AC-13
+// ============================================================
+
+#[test]
+fn response_action_is_object_safe() {
+    fn _take(_: &dyn ResponseAction) {}
+}
