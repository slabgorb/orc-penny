+    assert_eq!(back.key_id, "key-abc");
+    assert_eq!(back.signature, "deadbeef");
+}
+
+// ============================================================
+// Edge cases and paranoia tests
+// ============================================================
+
+#[test]
+fn plugin_id_from_str_rejects_only_whitespace() {
