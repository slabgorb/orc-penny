+//! Network plugin traits: protocol dissectors.
+//!
+//! Protocol dissectors are sync (no `async_trait`) for performance.
+//! Requires `AxiathonPlugin` as a supertrait (AC-10).
+
+use serde::{Deserialize, Serialize};
+
+use axiathon_plugin_sdk_core::error::PluginError;
+use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+/// Information about a protocol that a dissector handles.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ProtocolInfo {
+    /// Protocol name (e.g. `"DNS"`, `"HTTP"`).
+    pub name: String,
+    /// Short description.
+    pub description: String,
+    /// Default port(s), if applicable.
+    pub default_ports: Vec<u16>,
+}
+
+/// Dissects raw network data into structured protocol fields.
+///
+/// Sync trait for performance — dissection must be fast (<100us/line for WASM).
+pub trait ProtocolDissector: AxiathonPlugin {
+    /// Returns true if this dissector can handle the given protocol hint.
+    fn can_dissect(&self, hint: &str) -> bool;
+
+    /// Dissect raw bytes into structured JSON fields.
+    fn dissect(&self, data: &[u8]) -> Result<serde_json::Value, PluginError>;
+
+    /// Returns information about the protocol this dissector handles.
+    fn protocol_info(&self) -> ProtocolInfo;
+}
