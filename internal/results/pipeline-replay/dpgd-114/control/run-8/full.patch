+//! Plugin error types.
+//!
+//! `PluginError` provides structured, semantic error variants for all plugin
+//! operations. Each variant maps to a specific runtime behavior (e.g.,
+//! `ConfigInvalid` triggers config rejection, `HealthCheckFailed` degrades status).
+//!
+//! **SECURITY:** Display output is for internal logging only. Sanitize before
+//! sending to clients.
+
+use thiserror::Error;
+
+/// Structured error type for plugin operations.
+///
+/// **SECURITY:** Display output is for internal logging only. Sanitize before
+/// sending to clients.
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum PluginError {
+    /// Plugin configuration is invalid (rejects config).
+    #[error("config invalid: {0}")]
+    ConfigInvalid(String),
+
+    /// Health check failed (degrades plugin status).
+    #[error("health check failed: {0}")]
+    HealthCheckFailed(String),
+
+    /// Plugin or resource not found (maps to 404).
+    #[error("not found: {0}")]
+    NotFound(String),
+
+    /// Plugin initialization failed.
+    #[error("initialization failed: {0}")]
+    InitializationFailed(String),
+
+    /// Runtime error during plugin operation.
+    #[error("runtime error: {0}")]
+    Runtime(String),
+
+    /// Permission denied for requested operation.
+    #[error("permission denied: {0}")]
+    PermissionDenied(String),
+
+    /// Operation not supported by this plugin.
+    #[error("unsupported operation: {0}")]
+    UnsupportedOperation(String),
+
+    /// Error during plugin shutdown.
+    #[error("shutdown error: {0}")]
+    ShutdownError(String),
+}
