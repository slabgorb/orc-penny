+//! Ingestion plugin traits: connectors, parsers, and enrichers.
+//!
+//! All ingestion traits require `AxiathonPlugin` as a supertrait (AC-9).
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+
+use axiathon_plugin_sdk_core::error::PluginError;
+use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+/// Raw event received from a connector before parsing.
+#[derive(Debug, Clone)]
+pub struct RawEvent {
+    /// Raw bytes of the event.
+    pub data: Vec<u8>,
+    /// Source identifier (e.g., "syslog", "claroty-xdome").
+    pub source: String,
+}
+
+impl RawEvent {
+    /// Create a new RawEvent.
+    pub fn new(data: Vec<u8>, source: impl Into<String>) -> Self {
+        Self {
+            data,
+            source: source.into(),
+        }
+    }
+
+    /// Get the data as a UTF-8 string (lossy).
+    pub fn as_str(&self) -> String {
+        String::from_utf8_lossy(&self.data).to_string()
+    }
+}
+
+/// Placeholder for OCSF-normalized event until axiathon-types is extracted.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ParsedEvent {
+    /// Structured event data.
+    pub data: serde_json::Value,
+}
+
+/// A connector plugin that collects raw events from an external source.
+///
+/// Connectors are responsible for connecting to data sources,
+/// receiving or polling for raw data, and framing raw data into events.
+#[async_trait]
+pub trait ConnectorPlugin: AxiathonPlugin {
+    /// Start collecting events, returning them as a stream.
+    async fn connect(&self) -> Result<(), PluginError>;
+
+    /// Collect a batch of raw events.
+    async fn collect(&self) -> Result<Vec<RawEvent>, PluginError>;
+}
+
+/// A parser plugin that converts raw events into OCSF-normalized events.
+///
+/// Parsers are sync (no `async_trait`) for performance (NFR172: <10us/line native).
+pub trait ParserPlugin: AxiathonPlugin {
+    /// Returns true if this parser can handle the given raw event.
+    fn detect(&self, raw: &RawEvent) -> bool;
+
+    /// Parse a raw event into OCSF events.
+    fn parse(&self, raw: &RawEvent) -> Result<Vec<ParsedEvent>, PluginError>;
+}
+
+/// Enriches events with additional context (GeoIP, threat intel, etc.).
+#[async_trait]
+pub trait EventEnricher: AxiathonPlugin {
+    /// Enrich an event in place.
+    fn enrich(&self, event: &mut ParsedEvent) -> Result<(), PluginError>;
+
+    /// Optional cache configuration for the enricher.
+    fn cache_config(&self) -> Option<serde_json::Value> {
+        None
+    }
+
+    /// Priority for ordering in the enrichment pipeline (lower = earlier).
+    fn priority(&self) -> u32 {
+        100
+    }
+}
+
+/// Capabilities that an enricher can provide.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct EnricherCapabilities {
+    /// Fields this enricher reads (e.g. `["src_endpoint.ip"]`).
+    pub input_fields: Vec<String>,
+    /// Fields this enricher writes (e.g. `["geo.country", "geo.city"]`).
+    pub output_fields: Vec<String>,
+}
