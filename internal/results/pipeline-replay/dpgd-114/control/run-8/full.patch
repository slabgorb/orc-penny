+//! Action plugin traits: response actions.
+//!
+//! Requires `AxiathonPlugin` as a supertrait (AC-12).
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+
+use axiathon_plugin_sdk_core::error::PluginError;
+use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+/// Capabilities of a response action.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ActionCapabilities {
+    /// Actions this plugin supports (e.g. `["block_ip", "isolate_host"]`).
+    pub supported_actions: Vec<String>,
+    /// Whether actions are reversible.
+    pub reversible: bool,
+}
+
+/// Result of executing a response action.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ActionResult {
+    /// Whether the action succeeded.
+    pub success: bool,
+    /// Human-readable message.
+    pub message: String,
+    /// Whether this action can be undone.
+    pub reversible: bool,
+    /// Action identifier for potential rollback.
+    pub action_id: String,
+}
+
+/// Executes automated response actions (block IP, isolate host, etc.).
+#[async_trait]
+pub trait ResponseAction: AxiathonPlugin {
+    /// Execute the action with the given parameters.
+    async fn execute(&self, params: &serde_json::Value) -> Result<ActionResult, PluginError>;
+
+    /// Describe the action's capabilities.
+    fn capabilities(&self) -> ActionCapabilities;
+
+    /// Validate parameters before execution.
+    fn validate_params(&self, params: &serde_json::Value) -> Result<(), PluginError>;
+}
