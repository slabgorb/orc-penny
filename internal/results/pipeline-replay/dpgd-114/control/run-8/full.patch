+//! Integration tests for axiathon-plugin-sdk-ingestion.
+//!
+//! Covers AC-9 and AC-13 from Story 23-1.
+//! Verifies ConnectorPlugin, ParserPlugin, EventEnricher traits and supporting types.
+
+use axiathon_plugin_sdk_ingestion::{
+    ConnectorPlugin, EnricherCapabilities, EventEnricher, ParsedEvent, ParserPlugin, RawEvent,
+};
+
+// ==========================================================
+// Object Safety — AC-13
+// ==========================================================
+
+#[test]
+fn connector_plugin_is_object_safe() {
+    fn _take(_: Box<dyn ConnectorPlugin>) {}
+}
+
+#[test]
