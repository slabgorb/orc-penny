+}
+
+// ==========================================================
+// Supertrait Verification — AC-9
+// ==========================================================
+
+/// ConnectorPlugin requires AxiathonPlugin as supertrait.
+/// This test verifies the trait bound exists by checking that a type
+/// implementing ConnectorPlugin can be used as AxiathonPlugin.
+#[test]
+fn connector_plugin_requires_axiathon_plugin_supertrait() {
+    use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+    fn _check<T: ConnectorPlugin>(_t: &T) {
+        fn _requires_base<U: AxiathonPlugin>() {}
+        _requires_base::<T>();
+    }
+}
+
+#[test]
+fn parser_plugin_requires_axiathon_plugin_supertrait() {
+    use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+    fn _check<T: ParserPlugin>(_t: &T) {
+        fn _requires_base<U: AxiathonPlugin>() {}
+        _requires_base::<T>();
+    }
+}
+
+#[test]
+fn event_enricher_requires_axiathon_plugin_supertrait() {
+    use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+    fn _check<T: EventEnricher>(_t: &T) {
+        fn _requires_base<U: AxiathonPlugin>() {}
+        _requires_base::<T>();
+    }
+}
+
+// ==========================================================
+// RawEvent
+// ==========================================================
+
+#[test]
+fn raw_event_creation() {
+    let raw = RawEvent::new(b"test data".to_vec(), "test-source");
+    assert_eq!(raw.source, "test-source");
+    assert_eq!(raw.data, b"test data");
+}
+
+#[test]
+fn raw_event_as_str_converts_utf8() {
+    let raw = RawEvent::new(b"hello world".to_vec(), "test");
+    assert_eq!(raw.as_str(), "hello world");
+}
+
+#[test]
+fn raw_event_as_str_handles_non_utf8() {
+    let raw = RawEvent::new(vec![0xFF, 0xFE, 0x00], "binary-source");
+    let text = raw.as_str();
+    assert!(
+        text.contains('\u{FFFD}'),
+        "as_str should replace invalid UTF-8 with U+FFFD replacement character, got: {text:?}"
+    );
+}
+
+// ==========================================================
+// ParsedEvent
+// ==========================================================
+
+#[test]
+fn parsed_event_serde_round_trip() {
+    let event = ParsedEvent {
+        data: serde_json::json!({"type": "dns_query", "src_ip": "10.0.0.1"}),
+    };
+    let json = serde_json::to_string(&event).expect("serialize ParsedEvent");
+    let back: ParsedEvent = serde_json::from_str(&json).expect("deserialize ParsedEvent");
+    assert_eq!(back.data["type"], "dns_query");
+    assert_eq!(back.data["src_ip"], "10.0.0.1");
+}
+
+// ==========================================================
+// EnricherCapabilities
+// ==========================================================
+
+#[test]
+fn enricher_capabilities_serde_round_trip() {
+    let caps = EnricherCapabilities {
+        input_fields: vec!["src_endpoint.ip".into()],
+        output_fields: vec!["geo.country".into(), "geo.city".into()],
+    };
+    let json = serde_json::to_string(&caps).expect("serialize");
+    let back: EnricherCapabilities = serde_json::from_str(&json).expect("deserialize");
+    assert_eq!(back.input_fields, vec!["src_endpoint.ip"]);
+    assert_eq!(back.output_fields.len(), 2);
+}
+
+#[test]
+fn enricher_capabilities_fields() {
+    let caps = EnricherCapabilities {
+        input_fields: vec!["ip".into()],
+        output_fields: vec!["geo".into()],
+    };
+    assert_eq!(caps.input_fields.len(), 1);
+    assert_eq!(caps.output_fields.len(), 1);
+}
