+}
+
+// --- AxiathonPlugin lifecycle tests (requires mock implementation) ---
+
+mod lifecycle_tests {
+    use super::*;
+    use async_trait::async_trait;
+
+    struct MockPlugin {
+        manifest: PluginManifest,
+        initialized: bool,
+    }
+
+    impl MockPlugin {
+        fn new() -> Self {
+            Self {
+                manifest: PluginManifest::new(
+                    PluginId::builtin("mock"),
+                    "Mock Plugin",
+                    PluginKind::Connector,
+                ),
+                initialized: false,
+            }
+        }
+    }
+
+    #[async_trait]
+    impl AxiathonPlugin for MockPlugin {
+        fn manifest(&self) -> &PluginManifest {
+            &self.manifest
+        }
+
+        async fn initialize(&mut self, _config: PluginConfig) -> Result<(), PluginError> {
+            self.initialized = true;
+            Ok(())
+        }
+
+        async fn health_check(&self) -> PluginHealth {
+            if self.initialized {
+                PluginHealth::Healthy
+            } else {
+                PluginHealth::Unhealthy("not initialized".into())
+            }
+        }
+
+        async fn shutdown(&mut self) -> Result<(), PluginError> {
+            self.initialized = false;
+            Ok(())
+        }
+    }
+
+    /// AC-2: Default version() reads from manifest.
+    #[tokio::test]
+    async fn axiathon_plugin_default_version_reads_manifest() {
+        let plugin = MockPlugin::new();
+        assert_eq!(
+            plugin.version(),
+            "0.1.0",
+            "default version() should read manifest.version"
+        );
+    }
+
+    /// AC-2: Full lifecycle: initialize → health_check → shutdown.
+    #[tokio::test]
+    async fn axiathon_plugin_lifecycle() {
+        let mut plugin = MockPlugin::new();
+
+        // Before initialization
+        assert!(
+            matches!(plugin.health_check().await, PluginHealth::Unhealthy(_)),
+            "uninitialized plugin should be Unhealthy"
+        );
+
+        // Initialize
+        plugin
+            .initialize(serde_json::json!({"port": 1514}))
+            .await
+            .expect("initialize should succeed");
+        assert_eq!(
+            plugin.health_check().await,
+            PluginHealth::Healthy,
+            "initialized plugin should be Healthy"
+        );
+
+        // Shutdown
+        plugin.shutdown().await.expect("shutdown should succeed");
+        assert!(
+            matches!(plugin.health_check().await, PluginHealth::Unhealthy(_)),
+            "shutdown plugin should be Unhealthy"
+        );
+    }
+
+    /// AC-2: Plugin can be sent across async task boundaries.
+    #[tokio::test]
+    async fn axiathon_plugin_is_send_across_tasks() {
+        let plugin = MockPlugin::new();
+        let handle = tokio::spawn(async move {
+            plugin.manifest().name.clone()
+        });
+        let name = handle.await.expect("task should complete");
+        assert_eq!(name, "Mock Plugin");
+    }
+}
+
+// ==========================================================
+// SignatureMetadata — supporting type
+// ==========================================================
+
+#[test]
+fn signature_metadata_serde_round_trip() {
+    let sig = SignatureMetadata {
+        algorithm: "ed25519".into(),
+        key_id: "key-001".into(),
+        signature: "base64encoded".into(),
+    };
+    let json = serde_json::to_string(&sig).expect("serialize");
+    let back: SignatureMetadata = serde_json::from_str(&json).expect("deserialize");
+    assert_eq!(back.algorithm, "ed25519");
+    assert_eq!(back.key_id, "key-001");
+    assert_eq!(back.signature, "base64encoded");
+}
