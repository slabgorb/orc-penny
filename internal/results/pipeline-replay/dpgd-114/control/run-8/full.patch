new file mode 100644
index 0000000..7a915ba
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/core/src/identity.rs
@@ -0,0 +1,150 @@
+//! Plugin identity types: `PluginId` and `PluginKind`.
+
+use std::fmt;
+use std::str::FromStr;
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::PluginError;
+
+/// Intermediate struct for validated deserialization of `PluginId`.
+/// Prevents `#[derive(Deserialize)]` from bypassing validation (CWE-20, Rule #8).
+#[derive(Deserialize)]
+struct PluginIdRaw {
+    namespace: String,
+    name: String,
+}
+
+/// Namespaced plugin identity.
+///
+/// Plugins are identified by a namespace and name, formatted as `"namespace:name"`.
+/// Standard namespaces:
+/// - `builtin` — shipped with Axiathon
+/// - `community` — community-maintained plugins
+/// - Reverse-domain (e.g. `com.acme`) — vendor plugins
+///
+/// Fields are private to prevent post-construction mutation of identity data
+/// (Rule #9). Use `namespace()` and `name()` getters.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize)]
+pub struct PluginId {
+    namespace: String,
+    name: String,
+}
+
+impl PluginId {
+    /// Create a new PluginId without validation (internal use).
+    /// For trust boundaries, use `FromStr` or deserialize from JSON.
+    pub fn new(namespace: impl Into<String>, name: impl Into<String>) -> Self {
+        Self {
+            namespace: namespace.into(),
+            name: name.into(),
+        }
+    }
+
+    /// Create a builtin plugin ID (`builtin:name`).
+    pub fn builtin(name: impl Into<String>) -> Self {
+        Self::new("builtin", name)
+    }
+
+    /// Create a community plugin ID (`community:name`).
+    pub fn community(name: impl Into<String>) -> Self {
+        Self::new("community", name)
+    }
+
+    /// Return the fully-qualified ID string: `"namespace:name"`.
+    pub fn full_id(&self) -> String {
+        format!("{}:{}", self.namespace, self.name)
+    }
+
+    /// Get the namespace part of the plugin ID.
+    pub fn namespace(&self) -> &str {
+        &self.namespace
+    }
+
+    /// Get the name part of the plugin ID.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Validate namespace and name are non-empty.
+    fn validate(namespace: &str, name: &str) -> Result<(), PluginError> {
+        if namespace.is_empty() {
+            return Err(PluginError::ConfigInvalid(
+                "plugin id namespace cannot be empty".into(),
+            ));
+        }
+        if name.is_empty() {
+            return Err(PluginError::ConfigInvalid(
+                "plugin id name cannot be empty".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl fmt::Display for PluginId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.namespace, self.name)
+    }
+}
+
+/// Parse `"namespace:name"` into a `PluginId`.
+///
+/// Rejects empty namespace, empty name, and missing colon separator.
+impl FromStr for PluginId {
+    type Err = PluginError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let (ns, name) = s.split_once(':').ok_or_else(|| {
+            PluginError::ConfigInvalid(format!(
+                "invalid plugin id '{s}': expected 'namespace:name'"
+            ))
+        })?;
+        Self::validate(ns, name)?;
+        Ok(Self {
+            namespace: ns.into(),
+            name: name.into(),
+        })
+    }
+}
+
+/// Custom Deserialize that validates namespace and name are non-empty (CWE-20).
+impl<'de> Deserialize<'de> for PluginId {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        let raw = PluginIdRaw::deserialize(deserializer)?;
+        Self::validate(&raw.namespace, &raw.name).map_err(serde::de::Error::custom)?;
+        Ok(Self {
+            namespace: raw.namespace,
+            name: raw.name,
+        })
+    }
+}
+
+/// The six supported plugin kinds.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+#[non_exhaustive]
+pub enum PluginKind {
+    Connector,
+    Parser,
+    Enricher,
+    Dissector,
+    NotificationChannel,
+    ResponseAction,
+}
+
+impl fmt::Display for PluginKind {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Connector => write!(f, "connector"),
+            Self::Parser => write!(f, "parser"),
+            Self::Enricher => write!(f, "enricher"),
+            Self::Dissector => write!(f, "dissector"),
+            Self::NotificationChannel => write!(f, "notification_channel"),
+            Self::ResponseAction => write!(f, "response_action"),
+        }
+    }
+}
