+//! Notification plugin traits: notification channels.
+//!
+//! Requires `AxiathonPlugin` as a supertrait (AC-11).
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+
+use axiathon_plugin_sdk_core::error::PluginError;
+use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+/// A notification to be sent through a channel.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Notification {
+    /// Notification title.
+    pub title: String,
+    /// Notification body/message.
+    pub body: String,
+    /// Severity level (e.g. `"critical"`, `"high"`).
+    pub severity: String,
+    /// Optional structured metadata.
+    pub metadata: HashMap<String, String>,
+}
+
+/// Sends notifications to external channels (Slack, email, PagerDuty, etc.).
+#[async_trait]
+pub trait NotificationChannel: AxiathonPlugin {
+    /// Send a notification.
+    async fn send(&self, notification: &Notification) -> Result<(), PluginError>;
+
+    /// Test connectivity to the notification target.
+    async fn test_connection(&self) -> Result<(), PluginError>;
+}
