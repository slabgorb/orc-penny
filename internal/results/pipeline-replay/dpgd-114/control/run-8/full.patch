+}
+
+// ==========================================================
+// AxiathonPlugin trait — AC-2, AC-13
+// ==========================================================
+
+/// AC-13: AxiathonPlugin must be object-safe (`Box<dyn AxiathonPlugin>` compiles).
+#[test]
+fn axiathon_plugin_is_object_safe() {
+    fn _take(_: Box<dyn AxiathonPlugin>) {}
+}
+
+/// AC-2: AxiathonPlugin must be Send + Sync for async contexts.
+#[test]
+fn axiathon_plugin_is_send_sync() {
+    fn assert_send_sync<T: Send + Sync + ?Sized>() {}
+    assert_send_sync::<dyn AxiathonPlugin>();
+}
+
+/// AC-13: Arc<dyn AxiathonPlugin + Send + Sync> must compile.
+#[test]
+fn axiathon_plugin_arc_dyn_compiles() {
