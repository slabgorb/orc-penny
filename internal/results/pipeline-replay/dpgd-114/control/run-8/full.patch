@@ -0,0 +1,88 @@
+//! Integration tests for axiathon-plugin-sdk-action.
+//!
+//! Covers AC-12 and AC-13 from Story 23-1.
+//! Verifies ResponseAction trait, ActionCapabilities, and ActionResult types.
+
+use axiathon_plugin_sdk_action::{ActionCapabilities, ActionResult, ResponseAction};
+
+// ==========================================================
+// Object Safety — AC-13
+// ==========================================================
+
+#[test]
+fn response_action_is_object_safe() {
+    fn _take(_: Box<dyn ResponseAction>) {}
+}
+
+// ==========================================================
+// Supertrait Verification — AC-12
+// ==========================================================
+
+#[test]
+fn response_action_requires_axiathon_plugin_supertrait() {
+    use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+    fn _check<T: ResponseAction>(_t: &T) {
+        fn _requires_base<U: AxiathonPlugin>() {}
+        _requires_base::<T>();
+    }
+}
+
+// ==========================================================
+// ActionCapabilities
+// ==========================================================
+
+#[test]
+fn action_capabilities_serde_round_trip() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["block_ip".into(), "isolate_host".into()],
+        reversible: true,
+    };
+    let json = serde_json::to_string(&caps).expect("serialize ActionCapabilities");
+    let back: ActionCapabilities = serde_json::from_str(&json).expect("deserialize");
+    assert_eq!(back.supported_actions, vec!["block_ip", "isolate_host"]);
+    assert!(back.reversible);
+}
+
+#[test]
+fn action_capabilities_fields() {
+    let caps = ActionCapabilities {
+        supported_actions: vec!["quarantine".into()],
+        reversible: false,
+    };
+    assert_eq!(caps.supported_actions.len(), 1);
+    assert!(!caps.reversible);
+}
+
+// ==========================================================
+// ActionResult
+// ==========================================================
+
+#[test]
+fn action_result_serde_round_trip() {
+    let result = ActionResult {
+        success: true,
+        message: "IP blocked successfully".into(),
+        reversible: true,
+        action_id: "act-001".into(),
+    };
+    let json = serde_json::to_string(&result).expect("serialize ActionResult");
+    let back: ActionResult = serde_json::from_str(&json).expect("deserialize");
+    assert!(back.success);
+    assert_eq!(back.message, "IP blocked successfully");
+    assert!(back.reversible);
+    assert_eq!(back.action_id, "act-001");
+}
+
+#[test]
+fn action_result_failure() {
+    let result = ActionResult {
+        success: false,
+        message: "Host not found".into(),
+        reversible: false,
+        action_id: "act-002".into(),
+    };
+    assert!(!result.success);
+    assert!(!result.reversible);
+    assert_eq!(result.action_id, "act-002");
+}
