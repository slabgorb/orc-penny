+//! Integration tests for axiathon-plugin-sdk-notification.
+//!
+//! Covers AC-11 and AC-13 from Story 23-1.
+//! Verifies NotificationChannel trait and Notification type.
+
+use std::collections::HashMap;
+
+use axiathon_plugin_sdk_notification::{Notification, NotificationChannel};
+
+// ==========================================================
+// Object Safety — AC-13
+// ==========================================================
+
+#[test]
+fn notification_channel_is_object_safe() {
+    fn _take(_: Box<dyn NotificationChannel>) {}
+}
+
+// ==========================================================
+// Supertrait Verification — AC-11
+// ==========================================================
+
+#[test]
+fn notification_channel_requires_axiathon_plugin_supertrait() {
+    use axiathon_plugin_sdk_core::AxiathonPlugin;
+
+    fn _check<T: NotificationChannel>(_t: &T) {
+        fn _requires_base<U: AxiathonPlugin>() {}
+        _requires_base::<T>();
+    }
+}
+
+// ==========================================================
+// Notification
+// ==========================================================
+
+#[test]
+fn notification_serde_round_trip() {
+    let mut metadata = HashMap::new();
+    metadata.insert("channel".into(), "#alerts".into());
+
+    let notif = Notification {
+        title: "Critical Alert".into(),
+        body: "Suspicious activity detected".into(),
+        severity: "critical".into(),
+        metadata,
+    };
+    let json = serde_json::to_string(&notif).expect("serialize Notification");
+    let back: Notification = serde_json::from_str(&json).expect("deserialize Notification");
+    assert_eq!(back.title, "Critical Alert");
+    assert_eq!(back.body, "Suspicious activity detected");
+    assert_eq!(back.severity, "critical");
+    assert_eq!(back.metadata.get("channel").map(String::as_str), Some("#alerts"));
+}
+
+#[test]
+fn notification_fields() {
+    let notif = Notification {
+        title: "Test".into(),
+        body: "Body".into(),
+        severity: "low".into(),
+        metadata: HashMap::new(),
+    };
+    assert_eq!(notif.title, "Test");
+    assert_eq!(notif.body, "Body");
+    assert_eq!(notif.severity, "low");
+    assert!(notif.metadata.is_empty());
+}
+
+#[test]
+fn notification_metadata_multiple_entries() {
+    let mut metadata = HashMap::new();
+    metadata.insert("channel".into(), "#security".into());
+    metadata.insert("priority".into(), "urgent".into());
+
+    let notif = Notification {
+        title: "Alert".into(),
+        body: "Details".into(),
+        severity: "high".into(),
+        metadata,
+    };
+    assert_eq!(notif.metadata.len(), 2);
+}
