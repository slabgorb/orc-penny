+//! Plugin lifecycle trait.
+//!
+//! `AxiathonPlugin` is the base trait for all plugin types. It provides
+//! common lifecycle operations: manifest retrieval, initialization,
+//! health checks, and shutdown.
+
+use async_trait::async_trait;
+
+use crate::config::PluginConfig;
+use crate::error::PluginError;
+use crate::health::PluginHealth;
+use crate::manifest::PluginManifest;
+
+/// Base trait that all Axiathon plugins implement.
+///
+/// Uses `#[async_trait]` because native async fn in traits is NOT object-safe
+/// with `Box<dyn Trait>` as of Rust 1.85. All plugin traits needing dyn dispatch
+/// must use `#[async_trait]`.
+///
+/// Must be `Send + Sync` for safe use across async task boundaries.
+#[async_trait]
+pub trait AxiathonPlugin: Send + Sync {
+    /// Returns the plugin's manifest (identity, kind, config schema, etc.).
+    fn manifest(&self) -> &PluginManifest;
+
+    /// Returns the plugin's semantic version.
+    ///
+    /// Default implementation reads from the manifest.
+    fn version(&self) -> &str {
+        &self.manifest().version
+    }
+
+    /// Initialize the plugin with the given configuration.
+    async fn initialize(&mut self, config: PluginConfig) -> Result<(), PluginError>;
+
+    /// Perform a health check and return current status.
+    async fn health_check(&self) -> PluginHealth;
+
+    /// Gracefully shut down the plugin, releasing any resources.
+    async fn shutdown(&mut self) -> Result<(), PluginError>;
+}
diff --git a/crates/axiathon-plugin-sdk/core/src/manifest.rs b/crates/axiathon-plugin-sdk/core/src/manifest.rs
new file mode 100644
index 0000000..317f1bb
--- /dev/null
+++ b/crates/axiathon-plugin-sdk/core/src/manifest.rs
@@ -0,0 +1,88 @@
+//! Plugin manifest types.
+//!
+//! `PluginManifest` is the declarative metadata for a plugin, including its
+//! identity, configuration schema, OCSF metadata, and signature information.
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::PluginError;
+use crate::identity::{PluginId, PluginKind};
+
+/// GPG signature metadata for plugin verification.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SignatureMetadata {
+    /// Signing algorithm (e.g. "GPG", "ed25519").
+    pub algorithm: String,
+    /// Key identifier.
+    pub key_id: String,
+    /// Detached signature bytes (base64-encoded).
+    pub signature: String,
+}
+
+/// Declarative plugin manifest with metadata, config schema, and permissions.
+///
+/// Includes 13 fields (AC-3). The `validate_config()` method validates
+/// arbitrary JSON against the `config_schema` using the `jsonschema` crate.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PluginManifest {
+    /// Manifest schema version (e.g. "1.0").
+    pub schema_version: String,
+    /// Namespaced plugin identity.
+    pub id: PluginId,
+    /// Human-readable display name.
+    pub name: String,
+    /// Semantic version (e.g. "0.1.0").
+    pub version: String,
+    /// Plugin description.
+    pub description: String,
+    /// Plugin kind.
+    pub plugin_kind: PluginKind,
+    /// Organizational category.
+    pub category: String,
+    /// JSON Schema for plugin configuration. None means no schema (accept anything).
+    pub config_schema: Option<serde_json::Value>,
+    /// Required permissions (e.g. `["network:listen", "file:read"]`).
+    pub permissions: Vec<String>,
+    /// Searchable tags.
+    pub tags: Vec<String>,
+    /// OCSF event class IDs this plugin produces.
+    pub ocsf_classes: Vec<i32>,
+    /// OCSF schema version (e.g. "1.1.0").
+    pub ocsf_version: Option<String>,
+    /// GPG signature metadata for plugin verification.
+    pub signature: Option<SignatureMetadata>,
+}
+
+impl PluginManifest {
+    /// Create a minimal manifest for testing.
+    pub fn new(id: PluginId, name: impl Into<String>, kind: PluginKind) -> Self {
+        Self {
+            schema_version: "1.0".into(),
+            id,
+            name: name.into(),
+            version: "0.1.0".into(),
+            description: String::new(),
+            plugin_kind: kind,
+            category: String::new(),
+            config_schema: None,
+            permissions: Vec::new(),
+            tags: Vec::new(),
+            ocsf_classes: Vec::new(),
+            ocsf_version: None,
+            signature: None,
+        }
+    }
+
+    /// Validate a configuration value against this manifest's `config_schema`.
+    ///
+    /// If `config_schema` is `None`, any configuration is accepted.
+    /// Uses the `jsonschema` crate for validation (20-470x faster than alternatives).
+    pub fn validate_config(&self, config: &serde_json::Value) -> Result<(), PluginError> {
+        let schema = match &self.config_schema {
+            Some(s) => s,
+            None => return Ok(()),
+        };
+        jsonschema::validate(schema, config)
+            .map_err(|e| PluginError::ConfigInvalid(e.to_string()))
+    }
+}
