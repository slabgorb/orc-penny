index 0000000..3c9764e
--- /dev/null
+++ b/crates/axiathon-core/tests/query_types_edge_test.rs
@@ -0,0 +1,431 @@
+//! Edge case and security tests for shared query types (AC-7).
+//!
+//! Covers:
+//! - FieldRef constructor validation (lang-review rule #5)
+//! - FieldRef Display/FromStr roundtrip (including array indices)
+//! - Value Display for all variants
+//! - CompareOp and StringOp Display roundtrip
+//! - Boundary conditions: empty, very long, special characters
+//!
+//! Lang-review checklist rules covered:
+//! - #5: Unvalidated constructors at trust boundaries
+//! - #8: Deserialize bypassing validated constructors
+//! - #9: Public fields on types with invariants
+//! - #13: Constructor/Deserialize validation consistency
+
+use std::str::FromStr;
+use std::time::Duration;
+
+use axiathon_core::{CompareOp, FieldRef, StringOp, Value};
+
+// ============================================================
+// FieldRef constructor validation (rule #5)
+// ============================================================
+
+#[test]
+fn field_ref_new_empty_should_reject() {
+    // FieldRef::new("") should either return Result::Err or panic,
+    // not silently create an invalid FieldRef.
+    // Currently FieldRef::new("") silently creates FieldRef with segments [""],
+    // but FromStr rejects empty. This inconsistency violates rule #13
+    // (constructor/deserialize validation consistency).
+    let field = FieldRef::new("");
+    let display = field.to_string();
+    // If we get here, new("") didn't reject — document the inconsistency
+    assert!(
+        !display.is_empty() || field.segments().is_empty(),
+        "FieldRef::new('') should reject empty paths or produce empty segments, \
+         but got segments: {:?}, display: '{display}'",
+        field.segments()
+    );
+}
+
+#[test]
+fn field_ref_from_str_rejects_empty() {
+    let result = FieldRef::from_str("");
+    assert!(
+        result.is_err(),
+        "FieldRef::from_str('') should return Err"
+    );
+}
+
+#[test]
+fn field_ref_new_vs_from_str_consistency() {
+    // Both constructors should enforce the same invariants (rule #13).
+    // If from_str rejects empty, new should too.
+    let from_str_result = FieldRef::from_str("");
+    assert!(
+        from_str_result.is_err(),
+        "from_str should reject empty — if this fails, both constructors are broken"
+    );
+    // This test documents the inconsistency:
+    // new("") succeeds but from_str("") fails — rule #13 violation.
+    // The Dev should fix FieldRef::new to also validate, or at minimum
+    // return Result like FromStr does.
+}
+
+// ============================================================
+// FieldRef Display/FromStr roundtrip
+// ============================================================
+
+#[test]
+fn field_ref_display_from_str_roundtrip_simple() {
+    let original = FieldRef::new("src_endpoint.ip");
+    let display = original.to_string();
+    let parsed = FieldRef::from_str(&display).expect("roundtrip should succeed");
+    assert_eq!(original, parsed, "simple field roundtrip should preserve value");
+}
+
+#[test]
+fn field_ref_display_from_str_roundtrip_single_segment() {
+    let original = FieldRef::new("severity");
+    let display = original.to_string();
+    let parsed = FieldRef::from_str(&display).expect("roundtrip should succeed");
+    assert_eq!(original, parsed);
+}
+
+#[test]
+fn field_ref_display_from_str_roundtrip_with_array_index() {
+    // FieldRef::new("answers[0].value") stores segments as ["answers", "0", "value"]
+    // Display joins with "." producing "answers.0.value"
+    // FromStr on "answers.0.value" would produce the same segments
+    // BUT has_array would be different — Display loses bracket notation.
+    let original = FieldRef::new("answers[0].value");
+    assert!(
+        original.has_array_index(),
+        "answers[0].value should have array index"
+    );
+    let display = original.to_string();
+    let parsed = FieldRef::from_str(&display).expect("roundtrip should succeed");
+    // The segments should match...
+    assert_eq!(
+        original.segments(),
+        parsed.segments(),
+        "segments should match after roundtrip"
+    );
+    // ...but has_array_index may differ — this is a Display/FromStr asymmetry bug
+    assert_eq!(
+        original.has_array_index(),
+        parsed.has_array_index(),
+        "has_array_index should be preserved through Display/FromStr roundtrip"
+    );
+}
+
+#[test]
+fn field_ref_display_preserves_dotted_path() {
+    let field = FieldRef::new("actor.user.account.uid");
+    assert_eq!(field.to_string(), "actor.user.account.uid");
+}
+
+// ============================================================
+// FieldRef Serde roundtrip
+// ============================================================
+
+#[test]
+fn field_ref_serde_roundtrip_preserves_array_index() {
+    let original = FieldRef::new("answers[0].value");
+    let json = serde_json::to_string(&original).expect("serialize");
+    let deserialized: FieldRef = serde_json::from_str(&json).expect("deserialize");
+    assert_eq!(
+        original.segments(),
+        deserialized.segments(),
+        "serde roundtrip should preserve segments"
+    );
+    assert_eq!(
+        original.has_array_index(),
+        deserialized.has_array_index(),
+        "serde roundtrip should preserve has_array_index"
+    );
+}
+
+#[test]
+fn field_ref_deserialize_empty_json_string() {
+    // Deserializing an empty field ref from JSON — should this be rejected?
+    // FieldRef doesn't have a custom Deserialize impl (uses derive), so it
+    // deserializes whatever segments are in the JSON, including empty.
+    let json = r#"{"segments":[""],"has_array":false}"#;
+    let result: Result<FieldRef, _> = serde_json::from_str(json);
+    // If deserialization succeeds with empty segments, that's a rule #8 violation:
+    // Deserialize bypasses any constructor validation.
+    if let Ok(field) = result {
+        assert!(
+            !field.segments().is_empty(),
+            "deserialized FieldRef should not have empty segments"
+        );
+    }
+}
+
+// ============================================================
+// FieldRef boundary conditions
+// ============================================================
+
+#[test]
+fn field_ref_very_long_path() {
+    let segments: Vec<String> = (0..100).map(|i| format!("seg{i}")).collect();
+    let path = segments.join(".");
+    let field = FieldRef::new(&path);
+    assert_eq!(field.segments().len(), 100);
+    assert_eq!(field.to_string(), path);
+}
+
+#[test]
+fn field_ref_single_character_segments() {
+    let field = FieldRef::new("a.b.c");
+    assert_eq!(field.segments(), &["a", "b", "c"]);
+}
+
+#[test]
+fn field_ref_with_underscores() {
+    let field = FieldRef::new("src_endpoint.dst_port");
+    assert_eq!(field.segments(), &["src_endpoint", "dst_port"]);
+}
+
+#[test]
+fn field_ref_vendor_extension_preserves_brackets() {
+    // Vendor extensions use unmapped['vendor.field'] notation
+    let field = FieldRef::new("unmapped['claroty.alert_type']");
+    let display = field.to_string();
+    // The display should preserve the bracket notation in some form
+    assert!(
+        display.contains("unmapped"),
+        "vendor extension should contain 'unmapped': {display}"
+    );
+}
+
+// ============================================================
+// Value Display
+// ============================================================
+
+#[test]
+fn value_display_string_is_quoted() {
+    let val = Value::String("hello".into());
+    assert_eq!(format!("{val}"), r#""hello""#);
+}
+
+#[test]
+fn value_display_integer() {
+    let val = Value::Integer(42);
+    assert_eq!(format!("{val}"), "42");
+}
+
+#[test]
+fn value_display_negative_integer() {
+    let val = Value::Integer(-1);
+    assert_eq!(format!("{val}"), "-1");
+}
+
+#[test]
+fn value_display_float() {
+    let val = Value::Float(1.23);
+    let display = format!("{val}");
+    assert!(display.starts_with("1.23"), "float display: {display}");
+}
+
+#[test]
+fn value_display_boolean_true() {
+    let val = Value::Boolean(true);
+    assert_eq!(format!("{val}"), "true");
+}
+
+#[test]
+fn value_display_boolean_false() {
+    let val = Value::Boolean(false);
+    assert_eq!(format!("{val}"), "false");
+}
+
+#[test]
+fn value_display_regex() {
+    let val = Value::Regex(r"10\.0\..*".into());
+    let display = format!("{val}");
+    assert!(
+        display.contains(r"10\.0\..*"),
+        "regex display should contain pattern: {display}"
+    );
+}
+
+#[test]
+fn value_display_duration() {
+    let val = Value::Duration(Duration::from_secs(300));
+    let display = format!("{val}");
+    assert!(
+        display.contains("300"),
+        "duration display should contain seconds: {display}"
+    );
+}
+
+// ============================================================
+// Value equality edge cases
+// ============================================================
+
+#[test]
+fn value_float_nan_equality() {
+    // NaN != NaN in standard floating point, but our PartialEq uses to_bits()
+    let nan1 = Value::Float(f64::NAN);
+    let nan2 = Value::Float(f64::NAN);
+    // With to_bits comparison, NaN == NaN (bit-identical)
+    assert_eq!(nan1, nan2, "NaN values should be equal via to_bits comparison");
+}
+
+#[test]
+fn value_float_positive_negative_zero() {
+    let pos_zero = Value::Float(0.0);
+    let neg_zero = Value::Float(-0.0);
+    // +0.0 and -0.0 have different bit representations
+    // Our PartialEq uses to_bits, so they should be different
+    assert_ne!(
+        pos_zero, neg_zero,
+        "+0.0 and -0.0 should be different with to_bits comparison"
+    );
+}
+
+#[test]
+fn value_different_variants_not_equal() {
+    let str_val = Value::String("42".into());
+    let int_val = Value::Integer(42);
+    assert_ne!(str_val, int_val, "String '42' should not equal Integer 42");
+}
+
+#[test]
+fn value_integer_boundary_i64_max() {
+    let val = Value::Integer(i64::MAX);
+    assert_eq!(format!("{val}"), i64::MAX.to_string());
+}
+
+#[test]
+fn value_integer_boundary_i64_min() {
+    let val = Value::Integer(i64::MIN);
+    assert_eq!(format!("{val}"), i64::MIN.to_string());
+}
+
+// ============================================================
+// CompareOp Display
+// ============================================================
+
+#[test]
+fn compare_op_display_all_variants() {
+    assert_eq!(format!("{}", CompareOp::Eq), "=");
+    assert_eq!(format!("{}", CompareOp::Ne), "!=");
+    assert_eq!(format!("{}", CompareOp::Gt), ">");
+    assert_eq!(format!("{}", CompareOp::Lt), "<");
+    assert_eq!(format!("{}", CompareOp::Ge), ">=");
+    assert_eq!(format!("{}", CompareOp::Le), "<=");
+}
+
+#[test]
+fn compare_op_is_copy() {
+    let op = CompareOp::Eq;
+    let copied = op;
+    assert_eq!(op, copied, "CompareOp should be Copy");
+}
+
+// ============================================================
+// StringOp Display
+// ============================================================
+
+#[test]
+fn string_op_display_all_variants() {
+    assert_eq!(format!("{}", StringOp::Contains), "CONTAINS");
+    assert_eq!(format!("{}", StringOp::StartsWith), "STARTSWITH");
+    assert_eq!(format!("{}", StringOp::EndsWith), "ENDSWITH");
+    assert_eq!(format!("{}", StringOp::IContains), "ICONTAINS");
+    assert_eq!(format!("{}", StringOp::IStartsWith), "ISTARTSWITH");
+    assert_eq!(format!("{}", StringOp::IEndsWith), "IENDSWITH");
+}
+
+#[test]
+fn string_op_is_copy() {
+    let op = StringOp::Contains;
+    let copied = op;
+    assert_eq!(op, copied, "StringOp should be Copy");
+}
+
+// ============================================================
+// Serde roundtrips for shared types
+// ============================================================
+
+#[test]
+fn compare_op_serde_roundtrip() {
+    for op in [
+        CompareOp::Eq,
+        CompareOp::Ne,
+        CompareOp::Gt,
+        CompareOp::Lt,
+        CompareOp::Ge,
+        CompareOp::Le,
+    ] {
+        let json = serde_json::to_string(&op).expect("serialize");
+        let deserialized: CompareOp = serde_json::from_str(&json).expect("deserialize");
+        assert_eq!(op, deserialized, "CompareOp::{op:?} roundtrip failed");
+    }
+}
+
+#[test]
+fn string_op_serde_roundtrip() {
+    for op in [
+        StringOp::Contains,
+        StringOp::StartsWith,
