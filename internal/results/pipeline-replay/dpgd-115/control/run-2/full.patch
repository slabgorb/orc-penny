+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::And(left, _)) => {
+            assert!(
+                matches!(*left, FilterExpr::Not(_)),
+                "left of AND should be NOT (NOT has highest precedence)"
+            );
+        }
+        other => panic!("expected And(Not(...), ...), got: {other:?}"),
+    }
+}
