diff --git a/crates/axiathon-query/tests/parser_security_test.rs b/crates/axiathon-query/tests/parser_security_test.rs
new file mode 100644
index 0000000..66ab314
--- /dev/null
+++ b/crates/axiathon-query/tests/parser_security_test.rs
@@ -0,0 +1,466 @@
+//! Security and edge case tests for AxiQL parser.
+//!
+//! Tests cover:
+//! - CWE-674: Unbounded recursive/nested input (deeply nested parens)
+//! - CWE-400: Denial of service via very long input
+//! - CWE-190: Integer overflow in LIMIT/head/tail values
+//! - CWE-20: Input validation (CIDR format, empty values)
+//! - Missing parser branches: NOT IN, PERCENTILE, escaped quotes
+//! - Error recovery for partial/malformed input
+//!
+//! Lang-review checklist rules #7 (unsafe `as` casts), #15 (unbounded input)
+
+use axiathon_query::ast::{AxiQLStatement, FilterExpr, PipeStage, SelectExpr};
+use axiathon_query::parser::parse_axiql;
+
+// ============================================================
+// CWE-674: Unbounded recursive/nested input
+// ============================================================
+
+#[test]
+fn deeply_nested_parentheses_do_not_stack_overflow() {
+    // 100 levels of nested parentheses — should either parse successfully
+    // or return an error, but never stack overflow/panic.
+    let mut query = String::new();
+    for _ in 0..100 {
+        query.push('(');
+    }
+    query.push_str(r#"severity = "high""#);
+    for _ in 0..100 {
+        query.push(')');
+    }
+    let (result, errors) = parse_axiql(&query);
+    // We don't care whether it parses or errors — just that it doesn't panic.
+    // If it parses, the inner expression should be preserved.
+    if let Some(AxiQLStatement::Filter(expr)) = result {
+        assert!(
+            matches!(expr, FilterExpr::Comparison { .. }),
+            "deeply nested parens should unwrap to inner comparison"
+        );
+    } else {
+        // If it errors, that's also acceptable (depth limit triggered)
+        assert!(
+            !errors.is_empty(),
+            "if deeply nested parens fail, should produce errors"
+        );
+    }
+}
+
+#[test]
+fn parser_has_nesting_depth_limit() {
+    // 1000 levels of nesting — parser SHOULD reject this to prevent DoS.
+    // This test enforces lang-review rule #15 (unbounded input).
+    let mut query = String::new();
+    for _ in 0..1000 {
+        query.push('(');
+    }
+    query.push_str(r#"severity = "high""#);
+    for _ in 0..1000 {
+        query.push(')');
+    }
+    let (result, errors) = parse_axiql(&query);
+    // A well-designed parser should reject excessively deep nesting.
+    // If it accepts this without any depth limit, that's CWE-674.
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "parser should reject or error on 1000-deep nesting (CWE-674)"
+    );
+}
+
+// ============================================================
+// CWE-400: Denial of service via resource consumption
+// ============================================================
+
+#[test]
+fn very_long_input_does_not_hang() {
+    // 10KB input — parser should handle this in bounded time
+    let long_field = "a".repeat(10_000);
+    let query = format!(r#"{long_field} = "test""#);
+    let (result, errors) = parse_axiql(&query);
+    // Should either parse or error, not hang
+    assert!(
+        result.is_some() || !errors.is_empty(),
+        "parser should return a result or errors for valid-looking input"
+    );
+}
+
+#[test]
+fn parser_rejects_or_handles_extremely_long_field_names() {
+    // 100KB field name — should the parser reject this?
+    let long_field = "field_".to_string() + &"a".repeat(100_000);
+    let query = format!(r#"{long_field} = "test""#);
+    let (result, errors) = parse_axiql(&query);
+    // We don't mandate rejection, but it must not panic
+    if result.is_some() {
+        // If parsed, verify it didn't silently truncate
+        if let Some(AxiQLStatement::Filter(FilterExpr::Comparison { field, .. })) = &result {
+            assert!(
+                field.to_string().len() > 100,
+                "field should not be silently truncated"
+            );
+        }
+    }
+    // If result is None, errors should explain why
+    if result.is_none() {
+        assert!(
+            !errors.is_empty(),
+            "if parsing fails, errors should explain why"
+        );
+    }
+}
+
+// ============================================================
+// CWE-190: Integer overflow in LIMIT/head/tail
+// ============================================================
+
+#[test]
+fn sql_limit_large_value_no_overflow() {
+    // Value larger than i32::MAX but within i64 range
+    let query = "SELECT * FROM EVENTS LIMIT 2147483648";
+    let (result, errors) = parse_axiql(query);
+    assert!(errors.is_empty(), "large LIMIT should parse: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Sql { limit, .. } => {
+            assert_eq!(
+                limit,
+                Some(2_147_483_648),
+                "LIMIT should preserve value larger than i32::MAX"
+            );
+        }
+        other => panic!("expected Sql, got: {other:?}"),
+    }
+}
+
+#[test]
+fn sql_limit_very_large_value_handles_overflow() {
+    // Value larger than i64::MAX — should error, not panic
+    let query = "SELECT * FROM EVENTS LIMIT 99999999999999999999";
+    let (result, errors) = parse_axiql(query);
+    // This should either:
+    // 1. Return an error (preferred — CWE-190 mitigation)
+    // 2. Silently truncate (bad but shouldn't panic)
+    // It should NOT panic or overflow
+    // With overflow-safe parsing, this should produce an error, not panic.
+    // The parser returns an error for values that exceed i64 range.
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "very large LIMIT should produce a parse error, not silently succeed"
+    );
+}
+
+#[test]
+fn pipe_head_large_value_no_silent_truncation() {
+    // Test that `n as usize` in pipe_stage doesn't silently truncate
+    let query = r#"severity = "high" | head 2147483648"#;
+    let (result, errors) = parse_axiql(query);
+    assert!(errors.is_empty(), "large head value should parse: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Pipe { stages, .. } => {
+            match stages[0] {
+                PipeStage::Head(n) => {
+                    assert_eq!(
+                        n, 2_147_483_648,
+                        "head should preserve value > i32::MAX without truncation"
+                    );
+                }
+                ref other => panic!("expected Head, got: {other:?}"),
+            }
+        }
+        other => panic!("expected Pipe, got: {other:?}"),
+    }
+}
+
+#[test]
+fn pipe_tail_large_value_no_silent_truncation() {
+    let query = r#"severity = "high" | tail 2147483648"#;
+    let (result, errors) = parse_axiql(query);
+    assert!(errors.is_empty(), "large tail value should parse: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Pipe { stages, .. } => {
+            match stages[0] {
+                PipeStage::Tail(n) => {
+                    assert_eq!(
+                        n, 2_147_483_648,
+                        "tail should preserve value > i32::MAX without truncation"
+                    );
+                }
+                ref other => panic!("expected Tail, got: {other:?}"),
+            }
+        }
+        other => panic!("expected Pipe, got: {other:?}"),
+    }
+}
+
+#[test]
+fn sql_limit_negative_value_rejected() {
+    // Negative LIMIT should be rejected (or at minimum not produce usize underflow)
+    let query = "SELECT * FROM EVENTS LIMIT -1";
+    let (result, errors) = parse_axiql(query);
+    // Should produce an error — negative LIMIT is invalid
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "negative LIMIT should be rejected"
+    );
+}
+
+// ============================================================
+// CWE-20: Input validation
+// ============================================================
+
+#[test]
+fn cidr_invalid_format_still_accepted_by_parser() {
+    // The parser currently accepts any string for CIDR without validation.
+    // This test documents the behavior. Proper CIDR validation (CWE-20)
+    // should be done at semantic analysis time, not parse time.
+    let (result, errors) = parse_axiql(r#"src_endpoint.ip IN CIDR "not-a-cidr""#);
+    // Parser should accept this (validation is semantic, not syntactic)
+    assert!(errors.is_empty(), "parser should accept any CIDR string: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Cidr { cidr, .. }) => {
+            assert_eq!(cidr, "not-a-cidr", "parser should preserve CIDR string as-is");
+        }
+        other => panic!("expected Cidr, got: {other:?}"),
+    }
+}
+
+#[test]
+fn cidr_ipv6_format() {
+    let (result, errors) = parse_axiql(r#"src_endpoint.ip IN CIDR "2001:db8::/32""#);
+    assert!(errors.is_empty(), "IPv6 CIDR should parse: {errors:?}");
+    let stmt = result.expect("should parse IPv6 CIDR");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Cidr { cidr, .. }) => {
+            assert_eq!(cidr, "2001:db8::/32");
+        }
+        other => panic!("expected Cidr, got: {other:?}"),
+    }
+}
+
+// ============================================================
+// Error recovery and partial input
+// ============================================================
+
+#[test]
+fn partial_sql_missing_from_clause() {
+    let (result, errors) = parse_axiql("SELECT *");
+    // Missing FROM clause — should error, not silently succeed
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "SELECT without FROM should produce an error"
+    );
+}
+
+#[test]
+fn partial_sql_missing_source() {
+    let (result, errors) = parse_axiql("SELECT * FROM");
+    // Missing source after FROM — should error
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "SELECT * FROM (no source) should produce an error"
+    );
+}
+
+#[test]
+fn filter_missing_value() {
+    let (result, errors) = parse_axiql("severity =");
+    // Missing value after = — should error
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "field = (no value) should produce an error"
+    );
+}
+
+#[test]
+fn filter_missing_field() {
+    let (result, errors) = parse_axiql(r#"= "high""#);
+    // Missing field before = — should error
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "= value (no field) should produce an error"
+    );
+}
+
+#[test]
+fn pipe_empty_stage() {
+    let (result, errors) = parse_axiql(r#"severity = "high" |"#);
+    // Empty pipe stage — should error
+    assert!(
+        result.is_none() || !errors.is_empty(),
+        "trailing pipe without stage should error"
+    );
+}
+
+// ============================================================
+// String value edge cases
+// ============================================================
+
+#[test]
+fn parse_empty_string_value() {
+    let (result, errors) = parse_axiql(r#"user.name = """#);
+    assert!(errors.is_empty(), "empty string value should parse: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Comparison { value, .. }) => {
+            assert_eq!(
+                value,
+                axiathon_core::Value::String(String::new()),
+                "empty string should be preserved"
+            );
+        }
+        other => panic!("expected Comparison, got: {other:?}"),
+    }
+}
+
+#[test]
+fn parse_string_with_escaped_quotes() {
+    // Strings with escaped quotes should be handled (or rejected cleanly)
+    let (result, errors) = parse_axiql(r#"user.name = "it's \"quoted\"""#);
+    // This is a challenging edge case. The parser may or may not support
+    // escape sequences. What matters is it doesn't panic.
+    // Verify parser produces either a result or errors (not silent Nothing).
+    assert!(
+        result.is_some() || !errors.is_empty(),
+        "parser should return a result or errors, not silently produce nothing"
+    );
+}
+
+#[test]
+fn parse_string_with_unicode() {
+    let (result, errors) = parse_axiql(r#"user.name = "日本語テスト""#);
+    assert!(errors.is_empty(), "unicode strings should parse: {errors:?}");
+    let stmt = result.expect("should parse unicode");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Comparison { value, .. }) => {
+            assert_eq!(
+                value,
+                axiathon_core::Value::String("日本語テスト".into()),
+                "unicode should be preserved"
+            );
+        }
+        other => panic!("expected Comparison, got: {other:?}"),
+    }
+}
+
+// ============================================================
+// Operator edge cases
+// ============================================================
+
+#[test]
+fn wildcard_with_ne_operator_semantics() {
+    // When using != with a wildcard pattern, the semantics matter.
+    // Should it produce a Wildcard variant (which has no negation field)
+    // or a Comparison with Ne? This tests the parser's behavior.
+    let (result, errors) = parse_axiql(r#"hostname != "web-*""#);
+    assert!(errors.is_empty(), "!= with wildcard should parse: {errors:?}");
+    let stmt = result.expect("should parse");
+    // The parser should ideally preserve the != operator semantics,
+    // not silently discard it by converting to a Wildcard (which has no op field).
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Comparison { op, .. }) => {
+            assert_eq!(
+                op,
+                axiathon_core::CompareOp::Ne,
+                "!= should be preserved even with wildcard pattern"
+            );
+        }
+        AxiQLStatement::Filter(FilterExpr::Wildcard { .. }) => {
+            panic!(
+                "!= with wildcard pattern should NOT produce Wildcard variant \
+                 (which has no negation semantics) — the != operator is silently discarded"
+            );
+        }
+        other => panic!("unexpected variant: {other:?}"),
+    }
+}
+
+// ============================================================
+// SQL aggregation edge cases
+// ============================================================
+
+#[test]
+fn parse_sql_count_with_field() {
+    let (result, errors) = parse_axiql("SELECT COUNT(severity) FROM EVENTS");
+    assert!(errors.is_empty(), "unexpected errors: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Sql { select, .. } => {
+            match &select[0] {
+                SelectExpr::Aggregation(agg) => {
+                    assert_eq!(
+                        agg.field,
+                        Some(axiathon_core::FieldRef::new("severity")),
+                        "COUNT(field) should preserve the field"
+                    );
+                }
+                other => panic!("expected Aggregation, got: {other:?}"),
+            }
+        }
+        other => panic!("expected Sql, got: {other:?}"),
+    }
+}
+
+#[test]
+fn parse_sql_multiple_select_with_aggregation() {
+    let (result, errors) =
+        parse_axiql("SELECT src_endpoint.ip, COUNT(*) FROM EVENTS GROUP BY src_endpoint.ip");
+    assert!(errors.is_empty(), "unexpected errors: {errors:?}");
