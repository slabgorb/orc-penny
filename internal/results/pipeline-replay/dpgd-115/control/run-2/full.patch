+#[test]
+fn and_has_higher_precedence_than_or() {
+    // "a OR b AND c" should parse as "a OR (b AND c)", not "(a OR b) AND c"
+    let (result, errors) =
+        parse_axiql(r#"a = "1" OR b = "2" AND c = "3""#);
+    assert!(errors.is_empty(), "unexpected errors: {errors:?}");
+    let stmt = result.expect("should parse");
+    match stmt {
+        AxiQLStatement::Filter(FilterExpr::Or(left, right)) => {
+            // Left should be the simple "a = 1" comparison
+            assert!(
+                matches!(*left, FilterExpr::Comparison { .. }),
+                "left of OR should be simple comparison"
+            );
+            // Right should be AND(b=2, c=3)
+            assert!(
+                matches!(*right, FilterExpr::And(_, _)),
+                "right of OR should be AND expression (AND has higher precedence)"
+            );
+        }
