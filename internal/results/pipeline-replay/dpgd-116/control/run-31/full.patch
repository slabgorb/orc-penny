index 0000000..7679082
--- /dev/null
+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,56 @@
+//! HTTP client wrapper for communicating with axiathon-server.
+
+use crate::error::CliError;
+
+/// HTTP client wrapper that communicates with axiathon-server.
+///
+/// Injects `X-Tenant-ID` and `Authorization: Bearer <token>` headers.
+/// Maps HTTP status codes to [`CliError`] variants.
+pub struct SiemClient {
+    base_url: String,
+}
+
+impl SiemClient {
+    /// Create a new client pointing at the given server URL.
+    ///
+    /// Validates that the URL is non-empty. Returns `Err` if invalid.
+    pub fn new(base_url: &str) -> Result<Self, CliError> {
+        if base_url.is_empty() {
+            return Err(CliError::Config(
+                "server URL must not be empty".to_string(),
+            ));
+        }
+        Ok(Self {
+            base_url: base_url.to_string(),
+        })
+    }
+
+    /// Get the configured base URL.
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    /// Map an HTTP status code to the appropriate [`CliError`].
+    ///
+    /// Mapping per spec:
+    /// - 2xx → Ok(())
+    /// - 401 → AuthenticationExpired
+    /// - 403 → Unauthorized
+    /// - 404 → NotFound
+    /// - 429 → RateLimited
+    /// - 5xx → ServerError
+    /// - other → ServerError
+    pub fn map_status_code(status: u16) -> Result<(), CliError> {
+        match status {
+            200..=299 => Ok(()),
+            401 => Err(CliError::AuthenticationExpired),
+            403 => Err(CliError::Unauthorized("forbidden".to_string())),
+            404 => Err(CliError::NotFound("resource not found".to_string())),
+            429 => Err(CliError::RateLimited),
+            500..=599 => Err(CliError::ServerError(format!("HTTP {status}"))),
+            _ => Err(CliError::ServerError(format!(
+                "unexpected HTTP status {status}"
+            ))),
+        }
+    }
+}
