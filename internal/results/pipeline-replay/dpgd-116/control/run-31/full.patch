diff --git a/crates/axiathon-client/tests/security_rules_test.rs b/crates/axiathon-client/tests/security_rules_test.rs
new file mode 100644
index 0000000..209e7ac
--- /dev/null
+++ b/crates/axiathon-client/tests/security_rules_test.rs
@@ -0,0 +1,233 @@
+//! Security and lang-review rule enforcement tests.
+//!
+//! Each test maps to a specific rule from the Rust review checklist.
+//! These tests catch violations that automated tools miss.
+
+use axiathon_client::{Cli, CliError, SiemClient};
+use clap::CommandFactory;
+
+// ============================================================
+// Rule #1: Silent error swallowing
+// ============================================================
+
+#[test]
+fn siem_client_status_mapping_does_not_swallow_errors() {
+    // 400 Bad Request should produce a meaningful error, not be silently ignored
+    let result = SiemClient::map_status_code(400);
+    assert!(
+        result.is_err(),
+        "HTTP 400 should produce an error, not be silently OK"
+    );
+    let err = result.unwrap_err();
+    let msg = err.to_string();
+    assert!(
+        !msg.is_empty(),
+        "Error from status mapping must have non-empty Display"
+    );
+}
+
+// ============================================================
+// Rule #2: Missing #[non_exhaustive]
+// ============================================================
+
+#[test]
+fn cli_error_is_non_exhaustive() {
+    // CliError must have #[non_exhaustive] so downstream crates handle future variants.
+    let error_rs = std::fs::read_to_string(format!("{}/src/error.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read error.rs");
+    assert!(
+        error_rs.contains("#[non_exhaustive]"),
+        "CliError must have #[non_exhaustive] attribute"
+    );
+}
+
+// ============================================================
+// Rule #5: Unvalidated constructors at trust boundaries
+// ============================================================
+
+#[test]
+fn siem_client_rejects_empty_base_url() {
+    // At trust boundaries, constructors must validate input.
+    // SiemClient::new("") should return Err.
+    let result = SiemClient::new("");
+    assert!(
+        result.is_err(),
+        "SiemClient::new(\"\") should return Err, not silently accept empty URL"
+    );
+}
+
+// ============================================================
+// Rule #8: Deserialize bypass
+// ============================================================
+
+#[test]
+fn output_format_from_str_is_implemented() {
+    // OutputFormat must implement FromStr so clap can parse --format values.
+    // This test verifies the trait is implemented by checking the source.
+    let output_rs = std::fs::read_to_string(format!("{}/src/output.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read output.rs");
+    let has_from_str = output_rs.contains("impl FromStr for OutputFormat")
+        || output_rs.contains("impl std::str::FromStr for OutputFormat")
+        || output_rs.contains("#[derive(") && output_rs.contains("ValueEnum");
+    assert!(
+        has_from_str,
+        "OutputFormat must implement FromStr or derive ValueEnum for clap parsing"
+    );
+}
+
+// ============================================================
+// Rule #10: Tenant context in headers
+// ============================================================
+
+#[test]
+fn cli_has_tenant_flag_for_all_commands() {
+    // Per AC-5 and Rule #10: --tenant must be a global flag available
+    // on all subcommands, ensuring tenant context is explicit.
+    let cmd = Cli::command();
+    let tenant_arg = cmd
+        .get_arguments()
+        .find(|a| a.get_id().as_str() == "tenant");
+    assert!(
+        tenant_arg.is_some(),
+        "--tenant flag must exist as a global argument"
+    );
+    // If the arg exists, verify it's marked global
+    if let Some(arg) = tenant_arg {
+        assert!(
+            arg.is_global_set(),
+            "--tenant must be a global flag (available on all subcommands)"
+        );
+    }
+}
+
+// ============================================================
+// CWE-209: Error information exposure
+// ============================================================
+
+#[test]
+fn cli_error_display_does_not_expose_internal_paths() {
+    // Error messages shown to users must not leak internal file paths
+    let err = CliError::Config("/etc/axiathon/internal/secrets.toml".to_string());
+    let msg = err.to_string();
+    // The Display impl should sanitize — this test documents the requirement.
+    // For now it will pass because the stub just wraps the string,
+    // but the Dev must ensure API-facing errors are sanitized.
+    assert!(
+        !msg.contains("/etc/"),
+        "Error display should not expose internal file paths (CWE-209), got: {msg}"
+    );
+}
+
+#[test]
+fn cli_error_display_does_not_expose_stack_traces() {
+    let err = CliError::ServerError("at module::function (src/main.rs:42)".to_string());
+    let msg = err.to_string();
+    assert!(
+        !msg.contains("src/main.rs"),
+        "Error display should not expose stack traces (CWE-209), got: {msg}"
+    );
+}
+
+// ============================================================
+// Rule #11: Workspace dependency compliance
+// ============================================================
+
+#[test]
+fn axiathon_client_cargo_toml_uses_workspace_deps() {
+    // All dependencies that exist in workspace.dependencies must use { workspace = true }
+    // This is a structural test — reads the Cargo.toml and checks for inline versions.
+    let cargo_toml = std::fs::read_to_string(format!("{}/Cargo.toml", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read client Cargo.toml");
+
+    // These deps are in workspace.dependencies and must use workspace = true
+    let workspace_deps = ["clap", "thiserror", "tokio", "tracing", "serde_json"];
+    for dep in workspace_deps {
+        if cargo_toml.contains(dep) {
+            assert!(
+                cargo_toml.contains(&format!("{dep} = {{ workspace = true }}"))
+                    || cargo_toml.contains(&format!("{dep} = {{workspace = true}}"))
+                    || cargo_toml.contains(&format!("{dep}.workspace = true")),
+                "Dependency '{dep}' must use {{ workspace = true }}, not inline version"
+            );
+        }
+    }
+}
+
+// ============================================================
+// Rule #6: Test quality — self-check
+// ============================================================
+
+#[test]
+fn exit_code_tests_check_specific_values() {
+    // Meta-test: verify our own exit code tests use assert_eq! with specific values,
+    // not just assert!(is_err()) or assert!(code > 0)
+    let test_file = std::fs::read_to_string(format!("{}/tests/error_exit_codes_test.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read test file");
+
+    // Count assert_eq! calls with exit_code
+    let meaningful_assertions = test_file.matches("assert_eq!").count();
+    assert!(
+        meaningful_assertions >= 9,
+        "Exit code tests should have at least 9 assert_eq! (one per variant), found {meaningful_assertions}"
+    );
+
+    // Ensure no vacuous `let _ = result;` patterns
+    assert!(
+        !test_file.contains("let _ = "),
+        "Test file must not contain vacuous 'let _ = result;' patterns"
+    );
+}
+
+// ============================================================
+// Forbid unsafe code (workspace lint)
+// ============================================================
+
+#[test]
+fn crate_forbids_unsafe_code() {
+    // Verify the lib.rs has #![forbid(unsafe_code)]
+    let lib_rs = std::fs::read_to_string(format!("{}/src/lib.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read lib.rs");
+    assert!(
+        lib_rs.contains("forbid(unsafe_code)"),
+        "axiathon-client lib.rs must contain #![forbid(unsafe_code)]"
+    );
+}
+
+// ============================================================
+// Config security: no tokens in config file
+// ============================================================
+
+#[test]
+fn config_does_not_store_tokens() {
+    // Per AC-8: tokens go in OS keychain, NOT config file.
+    // Verify ClientConfig struct does not have a token/api_token field.
+    // We check this structurally by reading the source.
+    let config_rs = std::fs::read_to_string(format!("{}/src/config.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read config.rs");
+
+    // The config struct should not have any token-related fields
+    let has_token_field = config_rs.contains("pub token")
+        || config_rs.contains("pub api_token")
+        || config_rs.contains("pub bearer_token")
+        || config_rs.contains("pub auth_token");
+    assert!(
+        !has_token_field,
+        "ClientConfig must NOT have token fields — tokens belong in OS keychain per AC-8"
+    );
+}
+
+// ============================================================
+// AC-5: --server supports AXIATHON_SERVER env var
+// ============================================================
+
+#[test]
+fn server_flag_supports_env_var() {
+    // --server should support AXIATHON_SERVER env var as default.
+    // We verify by checking the source for the env annotation.
+    let cli_rs = std::fs::read_to_string(format!("{}/src/cli.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read cli.rs");
+    assert!(
+        cli_rs.contains("AXIATHON_SERVER"),
+        "--server flag must support AXIATHON_SERVER env var (via clap env attribute)"
+    );
+}
