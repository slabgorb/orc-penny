+//! Tests for shell completion generation and stub handlers.
+//!
+//! Covers:
+//! - AC-9: Shell completion (bash/zsh/fish/powershell)
+//! - AC-10: Stub handlers print "not yet implemented"
+
+use axiathon_client::Cli;
+use clap::{CommandFactory, Parser};
+
+// ============================================================
+// AC-9: Shell completion generation
+// ============================================================
+
+#[test]
+fn completion_subcommand_exists() {
+    let cmd = Cli::command();
+    let names: Vec<&str> = cmd.get_subcommands().map(clap::Command::get_name).collect();
+    assert!(
+        names.contains(&"completion"),
+        "completion subcommand must exist. Found: {names:?}"
+    );
+}
+
+#[test]
+fn completion_subcommand_accepts_bash() {
+    // `axiathon completion bash` should be a valid invocation
+    let result = Cli::try_parse_from(["axiathon", "completion", "bash"]);
+    assert!(
+        result.is_ok(),
+        "'axiathon completion bash' should parse successfully. Error: {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn completion_subcommand_accepts_zsh() {
+    let result = Cli::try_parse_from(["axiathon", "completion", "zsh"]);
+    assert!(
+        result.is_ok(),
+        "'axiathon completion zsh' should parse successfully. Error: {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn completion_subcommand_accepts_fish() {
+    let result = Cli::try_parse_from(["axiathon", "completion", "fish"]);
+    assert!(
+        result.is_ok(),
+        "'axiathon completion fish' should parse successfully. Error: {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn completion_subcommand_accepts_powershell() {
+    let result = Cli::try_parse_from(["axiathon", "completion", "powershell"]);
+    assert!(
+        result.is_ok(),
+        "'axiathon completion powershell' should parse successfully. Error: {:?}",
+        result.err()
+    );
+}
+
+// ============================================================
+// AC-10: Stub handlers
+// ============================================================
+
+#[test]
+fn stub_handler_message_contains_not_yet_implemented() {
+    // CliError::NotImplemented should contain "not yet implemented" text
+    let err = axiathon_client::CliError::NotImplemented("query (Story 5.5)".to_string());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Stub handler message must contain 'not yet implemented', got: {msg}"
+    );
+}
+
+#[test]
+fn stub_handler_message_includes_story_reference() {
+    // Per AC-10: unimplemented commands print "not yet implemented (Story X.Y)"
+    let err = axiathon_client::CliError::NotImplemented("query (Story 5.5)".to_string());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("Story"),
+        "Stub handler message must include Story reference, got: {msg}"
+    );
+}
+
+#[test]
+fn stub_handler_exits_with_code_1() {
+    let err = axiathon_client::CliError::NotImplemented("rules".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "Stub handlers should exit with code 1"
+    );
+}
