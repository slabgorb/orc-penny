+//! Client-side configuration loaded from cli.toml.
+
+use crate::error::CliError;
+use std::path::Path;
+
+/// Client-side configuration.
+///
+/// Loaded from `~/.config/axiathon/cli.toml` by default.
+/// Precedence: CLI flags > env vars > config file > defaults.
+#[derive(Debug, Default, serde::Deserialize)]
+pub struct ClientConfig {
+    /// Server URL (default: http://localhost:8080)
+    pub server_url: Option<String>,
+    /// Request timeout in seconds
+    pub timeout_secs: Option<u64>,
+}
+
+impl ClientConfig {
+    /// Load config from the default path (`~/.config/axiathon/cli.toml`).
+    ///
+    /// Returns defaults if the file does not exist.
+    pub fn load() -> Result<Self, CliError> {
+        let config_dir = dirs::config_dir().unwrap_or_else(|| std::path::PathBuf::from("."));
+        let default_path = config_dir.join("axiathon").join("cli.toml");
+
+        if default_path.exists() {
+            Self::load_from(&default_path)
+        } else {
+            Ok(Self::default())
+        }
+    }
+
+    /// Load config from a specified path.
+    ///
+    /// Applies env var overrides after loading from file:
+    /// - `AXIATHON_API_URL` overrides `server_url`
+    /// - `AXIATHON_TIMEOUT` overrides `timeout_secs`
+    pub fn load_from(path: &Path) -> Result<Self, CliError> {
+        let content = std::fs::read_to_string(path)
+            .map_err(|e| CliError::Config(format!("cannot read config file: {e}")))?;
+
+        let mut config: ClientConfig = toml::from_str(&content)
+            .map_err(|e| CliError::Config(format!("invalid TOML: {e}")))?;
+
+        // Env var overrides (precedence: env > file)
+        if let Ok(url) = std::env::var("AXIATHON_API_URL") {
+            config.server_url = Some(url);
+        }
+        if let Ok(timeout) = std::env::var("AXIATHON_TIMEOUT") {
+            if let Ok(secs) = timeout.parse::<u64>() {
+                config.timeout_secs = Some(secs);
+            }
+        }
+
+        Ok(config)
+    }
+}
