+//! Tests for SiemClient HTTP wrapper and ClientConfig loading.
+//!
+//! Covers:
+//! - AC-7: SiemClient with header injection and error mapping
+//! - AC-8: Config file loading with env var overrides
+
+use axiathon_client::{ClientConfig, CliError, SiemClient};
+
+// ============================================================
+// AC-7: SiemClient — HTTP status code mapping
+// ============================================================
+
+#[test]
+fn siem_client_maps_401_to_authentication_expired() {
+    let result = SiemClient::map_status_code(401);
+    assert!(result.is_err(), "401 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::AuthenticationExpired),
+        "HTTP 401 must map to CliError::AuthenticationExpired"
+    );
+}
+
+#[test]
+fn siem_client_maps_403_to_unauthorized() {
+    let result = SiemClient::map_status_code(403);
+    assert!(result.is_err(), "403 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::Unauthorized(_)),
+        "HTTP 403 must map to CliError::Unauthorized"
+    );
+}
+
+#[test]
+fn siem_client_maps_404_to_not_found() {
+    let result = SiemClient::map_status_code(404);
+    assert!(result.is_err(), "404 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::NotFound(_)),
+        "HTTP 404 must map to CliError::NotFound"
+    );
+}
+
+#[test]
+fn siem_client_maps_429_to_rate_limited() {
+    let result = SiemClient::map_status_code(429);
+    assert!(result.is_err(), "429 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::RateLimited),
+        "HTTP 429 must map to CliError::RateLimited"
+    );
+}
+
+#[test]
+fn siem_client_maps_500_to_server_error() {
+    let result = SiemClient::map_status_code(500);
+    assert!(result.is_err(), "500 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::ServerError(_)),
+        "HTTP 500 must map to CliError::ServerError"
+    );
+}
+
+#[test]
+fn siem_client_maps_502_to_server_error() {
+    let result = SiemClient::map_status_code(502);
+    assert!(result.is_err(), "502 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::ServerError(_)),
+        "HTTP 502 must map to CliError::ServerError"
+    );
+}
+
+#[test]
+fn siem_client_maps_503_to_server_error() {
+    let result = SiemClient::map_status_code(503);
+    assert!(result.is_err(), "503 should be an error");
+    assert!(
+        matches!(result.unwrap_err(), CliError::ServerError(_)),
