+
+#[test]
+fn config_load_from_valid_toml() {
+    use std::io::Write;
+    let dir = std::env::temp_dir().join("axiathon-test-config");
+    std::fs::create_dir_all(&dir).unwrap();
+    let config_path = dir.join("cli.toml");
+    let mut f = std::fs::File::create(&config_path).unwrap();
+    writeln!(f, r#"server_url = "https://axiathon.local:9090""#).unwrap();
+    writeln!(f, "timeout_secs = 30").unwrap();
+    drop(f);
+
+    let config = ClientConfig::load_from(&config_path);
+    assert!(config.is_ok(), "load_from() should parse valid TOML");
+    let config = config.unwrap();
+    assert_eq!(
+        config.server_url.as_deref(),
+        Some("https://axiathon.local:9090"),
+        "server_url should be loaded from TOML"
+    );
+    assert_eq!(
+        config.timeout_secs,
+        Some(30),
+        "timeout_secs should be loaded from TOML"
+    );
+
+    // Cleanup
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn config_source_references_axiathon_api_url_env() {
+    // AXIATHON_API_URL env var should override server_url from file (AC-8).
+    // Since set_var is unsafe in Rust 2024 (forbid(unsafe_code) is active),
+    // we verify the config source handles this env var.
+    let config_rs = std::fs::read_to_string(format!("{}/src/config.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read config.rs");
+    assert!(
+        config_rs.contains("AXIATHON_API_URL"),
+        "ClientConfig must check AXIATHON_API_URL env var for server_url override"
+    );
+}
+
+#[test]
+fn config_source_references_axiathon_timeout_env() {
+    // AXIATHON_TIMEOUT env var should override timeout_secs from file (AC-8).
+    let config_rs = std::fs::read_to_string(format!("{}/src/config.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read config.rs");
+    assert!(
+        config_rs.contains("AXIATHON_TIMEOUT"),
+        "ClientConfig must check AXIATHON_TIMEOUT env var for timeout override"
+    );
+}
+
+#[test]
+fn config_precedence_documented() {
+    // AC-8: Precedence is CLI flags > env vars > config file > defaults.
+    // Verify the config source documents or implements this precedence.
+    let config_rs = std::fs::read_to_string(format!("{}/src/config.rs", env!("CARGO_MANIFEST_DIR")))
+        .expect("should be able to read config.rs");
+    // The implementation should reference env::var or similar for env override
+    assert!(
+        config_rs.contains("env::var") || config_rs.contains("std::env"),
+        "ClientConfig must use std::env to implement env var overrides"
+    );
+}
