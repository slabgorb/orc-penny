+//! Tests for CLI error types and exit code mapping.
+//!
+//! Covers:
+//! - AC-3: Exit codes (0/1/2/3/4)
+//! - CliError variant structure
+//! - Error display safety (CWE-209)
+
+use axiathon_client::CliError;
+
+// ============================================================
+// AC-3: Exit code mapping
+// ============================================================
+
+#[test]
+fn authentication_expired_exits_3() {
+    let err = CliError::AuthenticationExpired;
+    assert_eq!(
+        err.exit_code(),
+        3,
+        "AuthenticationExpired should map to exit code 3 (auth failure)"
+    );
+}
+
+#[test]
+fn unauthorized_exits_4() {
+    let err = CliError::Unauthorized("forbidden".to_string());
+    assert_eq!(
+        err.exit_code(),
+        4,
+        "Unauthorized should map to exit code 4 (authz failure)"
+    );
+}
+
+#[test]
+fn not_found_exits_1() {
+    let err = CliError::NotFound("resource".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "NotFound should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn server_error_exits_1() {
+    let err = CliError::ServerError("internal server error".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ServerError should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn connection_timeout_exits_1() {
+    let err = CliError::ConnectionTimeout;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ConnectionTimeout should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn server_unavailable_exits_1() {
+    let err = CliError::ServerUnavailable;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ServerUnavailable should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn rate_limited_exits_1() {
+    let err = CliError::RateLimited;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "RateLimited should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn config_error_exits_1() {
+    let err = CliError::Config("bad config".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "Config should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn not_implemented_exits_1() {
+    let err = CliError::NotImplemented("query".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "NotImplemented should map to exit code 1 (general error)"
+    );
+}
+
+// ============================================================
+// CliError structure and traits
+// ============================================================
+
+#[test]
+fn cli_error_implements_std_error() {
+    fn assert_error<T: std::error::Error>() {}
+    assert_error::<CliError>();
+}
+
+#[test]
+fn cli_error_implements_send_sync() {
+    // Compile-time check — required for async error propagation
+    fn assert_send_sync<T: Send + Sync>() {}
+    assert_send_sync::<CliError>();
+}
+
+#[test]
+fn cli_error_display_includes_context() {
+    let err = CliError::NotFound("tenant abc-123".to_string());
+    let msg = err.to_string();
+    assert!(
+        msg.contains("tenant abc-123"),
+        "Display should include resource context, got: {msg}"
+    );
+}
+
+#[test]
+fn cli_error_debug_contains_variant_name() {
+    let err = CliError::AuthenticationExpired;
+    let debug = format!("{err:?}");
