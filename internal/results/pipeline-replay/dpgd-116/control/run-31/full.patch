+//! - OutputFormat enum structure
+//! - JSON metadata inclusion
+
+use axiathon_client::{OutputFormat, ResponseFormatter};
+
+// ============================================================
+// AC-4: Output format variants
+// ============================================================
+
+#[test]
+fn output_format_variants_are_distinct() {
+    assert_ne!(OutputFormat::Table, OutputFormat::Json);
+    assert_ne!(OutputFormat::Json, OutputFormat::Csv);
+    assert_ne!(OutputFormat::Table, OutputFormat::Csv);
+}
+
+#[test]
+fn output_format_is_copy() {
+    // Compile-time check — no runtime assertion needed
+    fn assert_copy<T: Copy>() {}
+    assert_copy::<OutputFormat>();
