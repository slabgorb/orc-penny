+}
+
+#[test]
+fn verbose_flag_is_repeatable() {
+    // -v should be repeatable (-vv for debug)
+    // Parse with two -v flags — should not error
+    let result = Cli::try_parse_from(["axiathon", "-vv", "status"]);
+    assert!(
+        result.is_ok(),
+        "-v should be repeatable (-vv for debug). Error: {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn format_flag_accepts_table_json_csv() {
+    for fmt in ["table", "json", "csv"] {
+        let result = Cli::try_parse_from(["axiathon", "--format", fmt, "status"]);
+        assert!(
+            result.is_ok(),
+            "--format {fmt} should be accepted. Error: {:?}",
+            result.err()
+        );
+    }
+}
