@@ -0,0 +1,69 @@
+//! CLI error types with exit code mapping.
+
+use thiserror::Error;
+
+/// CLI-specific error types.
+///
+/// Each variant maps to a specific process exit code via [`CliError::exit_code()`].
+///
+/// **SECURITY:** Display impl is for internal logging only.
+/// Variants that carry internal details (Config, ServerError) use generic
+/// Display messages that do not expose the inner string. The inner string
+/// is available via Debug for structured logging. (CWE-209)
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum CliError {
+    /// Authentication token expired or invalid (HTTP 401)
+    #[error("authentication expired")]
+    AuthenticationExpired,
+
+    /// User lacks required permissions (HTTP 403)
+    #[error("unauthorized")]
+    Unauthorized(String),
+
+    /// Requested resource not found (HTTP 404)
+    #[error("not found: {0}")]
+    NotFound(String),
+
+    /// Server returned 429 Too Many Requests
+    #[error("rate limited")]
+    RateLimited,
+
+    /// Server returned 5xx error — inner string is for logging only
+    #[error("server error")]
+    ServerError(String),
+
+    /// Connection timed out
+    #[error("connection timeout")]
+    ConnectionTimeout,
+
+    /// Server is not reachable
+    #[error("server unavailable")]
+    ServerUnavailable,
+
+    /// Configuration error — inner string is for logging only
+    #[error("configuration error")]
+    Config(String),
+
+    /// Feature not yet implemented
+    #[error("not yet implemented: {0}")]
+    NotImplemented(String),
+}
+
+impl CliError {
+    /// Map error variant to process exit code.
+    ///
+    /// Exit codes per spec:
+    /// - 0 = success (not an error — handled by caller)
+    /// - 1 = general error
+    /// - 2 = usage error (handled by clap automatically)
+    /// - 3 = authentication failure
+    /// - 4 = authorization failure
+    pub fn exit_code(&self) -> i32 {
+        match self {
+            Self::AuthenticationExpired => 3,
+            Self::Unauthorized(_) => 4,
+            _ => 1,
+        }
+    }
+}
