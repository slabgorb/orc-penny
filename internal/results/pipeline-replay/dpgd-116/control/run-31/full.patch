+//! CLI command structure using clap 4.x derive macros.
+
+use crate::output::OutputFormat;
+use clap::{Parser, Subcommand};
+
+/// Axiathon CLI — Operator interface for Axiathon SIEM.
+///
+/// Two-binary architecture: this client binary (`axiathon`) talks to
+/// `axiathon-server` via HTTP. All data flows through `SiemClient`.
+#[derive(Parser, Debug)]
+#[command(name = "axiathon", about = "Axiathon SIEM operator CLI")]
+pub struct Cli {
+    /// Subcommand to execute
+    #[command(subcommand)]
+    pub command: Commands,
+
+    /// Output format for tabular data
+    #[arg(long, short = 'f', global = true, default_value = "table", value_enum)]
+    pub format: OutputFormat,
+
+    /// Increase verbosity (-v info, -vv debug)
+    #[arg(long, short = 'v', global = true, action = clap::ArgAction::Count)]
+    pub verbose: u8,
+
+    /// Suppress all output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL (overrides config file)
+    #[arg(long, global = true, env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Path to config file (default: ~/.config/axiathon/cli.toml)
+    #[arg(long, global = true)]
+    pub config: Option<String>,
+
+    /// Disable color output
+    #[arg(long, global = true)]
+    pub no_color: bool,
+}
+
+/// Top-level command groups following plural-noun + verb pattern.
+#[derive(Subcommand, Debug)]
+pub enum Commands {
+    /// Run queries against the SIEM
+    #[command(after_help = "\
+Examples:
+  axiathon query run 'SELECT * FROM events LIMIT 10'
+  axiathon query --format json run 'SELECT count(*) FROM events'")]
+    Query,
+
+    /// Manage detection rules
+    #[command(after_help = "\
+Examples:
+  axiathon rules list
+  axiathon rules show rule-123")]
+    Rules,
+
+    /// Manage alerts
+    #[command(after_help = "\
+Examples:
+  axiathon alerts list --status open
+  axiathon alerts acknowledge alert-123")]
+    Alerts,
+
+    /// Control data ingestion pipelines
+    #[command(after_help = "\
+Examples:
+  axiathon ingest status
+  axiathon ingest pause source-123")]
+    Ingest,
+
+    /// Manage configuration
+    #[command(after_help = "\
+Examples:
+  axiathon config show
+  axiathon config set key=value")]
+    Config,
+
+    /// Check system status and health
+    #[command(after_help = "\
+Examples:
+  axiathon status
+  axiathon status --component ingestion")]
+    Status,
+
+    /// Manage tenants
+    Tenant,
+
+    /// Authenticate with the server
+    Login,
+
+    /// Generate shell completions
+    Completion {
+        /// Shell to generate completions for
+        #[arg(value_enum)]
+        shell: clap_complete::Shell,
+    },
+
+    /// Initialize first-time setup
+    Init,
+
+    /// Launch the terminal user interface
+    Tui,
+}
