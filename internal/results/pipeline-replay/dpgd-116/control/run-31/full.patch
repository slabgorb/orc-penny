+//! Output formatting for CLI commands.
+
+use serde::Serialize;
+
+/// Output format for tabular data.
+///
+/// Supports table (default for TTY), JSON (default for piped), and CSV.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, clap::ValueEnum)]
+#[non_exhaustive]
+pub enum OutputFormat {
+    /// Human-readable table with ANSI colors
+    Table,
+    /// Machine-readable JSON with ResponseMetadata
+    Json,
+    /// CSV with headers and proper escaping
+    Csv,
+}
+
+/// Trait for formatting command output in multiple formats.
+pub trait OutputFormatter {
+    /// Format data as a table string.
+    fn format_table(&self, headers: &[String], rows: &[Vec<String>]) -> String;
+
+    /// Format data as JSON string with metadata.
+    fn format_json(&self) -> String;
+
+    /// Format data as CSV string with headers.
+    fn format_csv(&self, headers: &[String], rows: &[Vec<String>]) -> String;
+}
+
+/// JSON response envelope with metadata per AC-4.
+#[derive(Debug, Serialize)]
+struct JsonEnvelope {
+    data: Vec<serde_json::Map<String, serde_json::Value>>,
+    request_id: String,
+    timestamp: String,
+    api_version: String,
+}
+
+/// Production formatter that outputs tabular data in table/JSON/CSV.
+///
+/// JSON output includes `ResponseMetadata` fields: `request_id`,
+/// `timestamp`, and `api_version` per AC-4.
+#[derive(Debug)]
+pub struct ResponseFormatter {
+    headers: Vec<String>,
+    rows: Vec<Vec<String>>,
+}
+
+impl ResponseFormatter {
+    /// Create a new formatter with column headers and row data.
+    pub fn new(headers: Vec<String>, rows: Vec<Vec<String>>) -> Self {
+        Self { headers, rows }
+    }
+
+    /// Format the data in the specified output format.
+    pub fn format(&self, format: OutputFormat) -> String {
+        match format {
+            OutputFormat::Table => self.to_table(),
+            OutputFormat::Json => self.to_json(),
+            OutputFormat::Csv => self.to_csv(),
+        }
+    }
+
+    fn to_table(&self) -> String {
+        let mut output = self.headers.join("\t") + "\n";
+        for row in &self.rows {
+            output += &(row.join("\t") + "\n");
+        }
+        output
+    }
+
+    fn to_json(&self) -> String {
+        let data: Vec<serde_json::Map<String, serde_json::Value>> = self
+            .rows
+            .iter()
+            .map(|row| {
+                self.headers
+                    .iter()
+                    .zip(row.iter())
+                    .map(|(k, v)| (k.clone(), serde_json::Value::String(v.clone())))
+                    .collect()
+            })
+            .collect();
+
+        let envelope = JsonEnvelope {
+            data,
+            request_id: uuid::Uuid::new_v4().to_string(),
+            timestamp: chrono::Utc::now().to_rfc3339(),
+            api_version: "v1".to_string(),
+        };
+
+        serde_json::to_string_pretty(&envelope).unwrap_or_default()
+    }
+
+    fn to_csv(&self) -> String {
+        let mut output = self.headers.join(",") + "\n";
+        for row in &self.rows {
+            output += &(row.join(",") + "\n");
+        }
+        output
+    }
+}
