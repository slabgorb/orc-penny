@@ -0,0 +1,199 @@
+//! Tests for SiemClient HTTP wrapper (Story 6.1, AC-7).
+//!
+//! Covers:
+//! - SiemClient wraps reqwest::Client
+//! - Injects X-Tenant-ID and Authorization headers
+//! - Maps HTTP status codes to CliError variants
+//! - Security: no header injection, no token leaking
+
+use axiathon_client::client::SiemClient;
+use axiathon_client::error::CliError;
+
+// ============================================================
+// AC-7: SiemClient construction
+// ============================================================
+
+#[test]
+fn siem_client_new_with_server_url() {
+    let client = SiemClient::new("https://api.example.com", None);
+    assert_eq!(
+        client.server_url(),
+        "https://api.example.com",
+        "SiemClient should store the server URL"
+    );
+}
+
+#[test]
+fn siem_client_new_with_auth_token() {
+    let client = SiemClient::new("https://api.example.com", Some("my-token".into()));
+    assert!(
+        client.has_auth_token(),
+        "SiemClient should know if it has an auth token"
+    );
+}
+
+#[test]
+fn siem_client_new_without_auth_token() {
+    let client = SiemClient::new("https://api.example.com", None);
+    assert!(
+        !client.has_auth_token(),
+        "SiemClient without token should report no auth"
+    );
+}
+
+// ============================================================
+// AC-7: Header injection
+// ============================================================
+
+#[test]
+fn siem_client_injects_tenant_header() {
+    let client = SiemClient::new("https://api.example.com", None);
+    let headers = client.build_headers("tenant-123");
+    let tenant_header = headers.get("X-Tenant-ID");
+    assert_eq!(
+        tenant_header.map(|v| v.to_str().unwrap()),
+        Some("tenant-123"),
+        "Should inject X-Tenant-ID header"
+    );
+}
+
+#[test]
+fn siem_client_injects_auth_header() {
+    let client = SiemClient::new("https://api.example.com", Some("my-token".into()));
+    let headers = client.build_headers("tenant-123");
+    let auth_header = headers.get("Authorization");
+    assert_eq!(
+        auth_header.map(|v| v.to_str().unwrap()),
+        Some("Bearer my-token"),
+        "Should inject Authorization: Bearer <token> header"
+    );
+}
+
+#[test]
+fn siem_client_no_auth_header_when_no_token() {
+    let client = SiemClient::new("https://api.example.com", None);
+    let headers = client.build_headers("tenant-123");
+    assert!(
+        headers.get("Authorization").is_none(),
+        "Should not inject Authorization header when no token"
+    );
+}
+
+// ============================================================
+// AC-7: HTTP status code mapping
+// ============================================================
+
+#[test]
+fn siem_client_maps_401_to_authentication_expired() {
+    let err = SiemClient::map_http_status(401, "");
+    assert!(
+        matches!(err, CliError::AuthenticationExpired(_)),
+        "401 should map to AuthenticationExpired, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_403_to_unauthorized() {
+    let err = SiemClient::map_http_status(403, "");
+    assert!(
+        matches!(err, CliError::Unauthorized(_)),
+        "403 should map to Unauthorized, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_404_to_not_found() {
+    let err = SiemClient::map_http_status(404, "");
+    assert!(
+        matches!(err, CliError::NotFound(_)),
+        "404 should map to NotFound, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_429_to_rate_limited() {
+    let err = SiemClient::map_http_status(429, "");
+    assert!(
+        matches!(err, CliError::RateLimited),
+        "429 should map to RateLimited, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_500_to_server_error() {
+    let err = SiemClient::map_http_status(500, "internal error");
+    assert!(
+        matches!(err, CliError::ServerError(500, _)),
+        "500 should map to ServerError(500, ...), got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_502_to_server_error() {
+    let err = SiemClient::map_http_status(502, "bad gateway");
+    assert!(
+        matches!(err, CliError::ServerError(502, _)),
+        "502 should map to ServerError(502, ...), got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_503_to_server_error() {
+    let err = SiemClient::map_http_status(503, "");
+    assert!(
+        matches!(err, CliError::ServerError(503, _)),
+        "503 should map to ServerError(503, ...), got: {err:?}"
+    );
+}
+
+// ============================================================
+// Security: Header injection prevention
+// ============================================================
+
+#[test]
+fn siem_client_tenant_header_rejects_newlines() {
+    // CWE-113: HTTP header injection via newline in tenant ID
+    let client = SiemClient::new("https://api.example.com", None);
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        client.build_headers("tenant-123\r\nX-Injected: malicious")
+    }));
+    match result {
+        Ok(headers) => {
+            let tenant_val = headers.get("X-Tenant-ID").unwrap().to_str().unwrap();
+            assert!(
+                !tenant_val.contains('\r') && !tenant_val.contains('\n'),
+                "Tenant header should not contain newlines: {tenant_val:?}"
+            );
+        }
+        Err(_) => {
+            // Panicking on invalid header value is also acceptable (reqwest does this)
+        }
+    }
+}
+
+#[test]
+fn siem_client_does_not_log_auth_token() {
+    // Security: Debug output should not expose tokens
+    let client = SiemClient::new("https://api.example.com", Some("secret-token-abc".into()));
+    let debug = format!("{client:?}");
+    assert!(
+        !debug.contains("secret-token-abc"),
+        "Debug output should not expose auth token (CWE-532): {debug}"
+    );
+}
+
+// ============================================================
+// Lang-review #1: no silent error swallowing in SiemClient
+// ============================================================
+
+#[test]
+fn siem_client_map_http_status_does_not_swallow_body() {
+    let err = SiemClient::map_http_status(500, "detailed server error message");
+    let display = format!("{err}");
+    // The error message should preserve enough context for debugging
+    // (though not necessarily the full body — security sanitization applies)
+    assert!(
+        !display.is_empty(),
+        "ServerError display should not be empty"
+    );
+}
