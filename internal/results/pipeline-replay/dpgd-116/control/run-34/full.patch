+//! Tests for shell completion generation (Story 6.1, AC-9).
+//!
+//! Covers:
+//! - axiathon completion <shell> generates completions for bash/zsh/fish/powershell
+//! - Script output to stdout
+//! - All four shells produce non-empty output
+
+use axiathon_client::commands::completion::generate_completions;
+
+// ============================================================
+// AC-9: Shell completion generation
+// ============================================================
+
+#[test]
+fn completion_bash_generates_non_empty_output() {
+    let output = generate_completions("bash");
+    assert!(
+        !output.is_empty(),
+        "Bash completions should produce non-empty output"
+    );
+    // Bash completions typically contain 'complete' or '_axiathon'
+    assert!(
+        output.contains("axiathon") || output.contains("complete"),
+        "Bash completions should reference 'axiathon' or 'complete': {output}"
+    );
+}
+
+#[test]
+fn completion_zsh_generates_non_empty_output() {
+    let output = generate_completions("zsh");
+    assert!(
+        !output.is_empty(),
+        "Zsh completions should produce non-empty output"
+    );
+    assert!(
+        output.contains("axiathon") || output.contains("compdef"),
+        "Zsh completions should reference 'axiathon' or 'compdef'"
+    );
+}
+
+#[test]
+fn completion_fish_generates_non_empty_output() {
+    let output = generate_completions("fish");
+    assert!(
+        !output.is_empty(),
+        "Fish completions should produce non-empty output"
+    );
+    assert!(
+        output.contains("axiathon") || output.contains("complete"),
+        "Fish completions should reference 'axiathon' or 'complete'"
+    );
+}
+
+#[test]
+fn completion_powershell_generates_non_empty_output() {
+    let output = generate_completions("powershell");
+    assert!(
+        !output.is_empty(),
+        "PowerShell completions should produce non-empty output"
+    );
+    assert!(
+        output.contains("axiathon") || output.contains("Register"),
+        "PowerShell completions should reference 'axiathon' or 'Register'"
+    );
+}
+
+#[test]
+fn completion_all_shells_produce_different_output() {
+    let bash = generate_completions("bash");
+    let zsh = generate_completions("zsh");
+    let fish = generate_completions("fish");
+    let ps = generate_completions("powershell");
+
+    // Each shell should produce different completion scripts
+    assert_ne!(bash, zsh, "Bash and Zsh completions should differ");
+    assert_ne!(bash, fish, "Bash and Fish completions should differ");
+    assert_ne!(bash, ps, "Bash and PowerShell completions should differ");
+}
+
+#[test]
+fn completion_includes_all_subcommands() {
+    let bash = generate_completions("bash");
+    // Completions should reference all command groups
+    for cmd in &["query", "rules", "alerts", "status", "config", "init"] {
+        assert!(
+            bash.contains(cmd),
+            "Bash completions should include '{cmd}' subcommand"
+        );
+    }
+}
+
+#[test]
+fn completion_rejects_unknown_shell() {
+    let result = std::panic::catch_unwind(|| {
+        generate_completions("unknown-shell")
+    });
+    match result {
+        Ok(output) => {
+            // If it doesn't panic, it should return empty string for unknown shells
+            assert!(
+                output.is_empty(),
+                "Unknown shell should produce empty output or error"
+            );
+        }
+        Err(_) => {
+            // Panicking on unknown shell is also acceptable
+        }
+    }
+}
diff --git a/crates/axiathon-client/tests/siem_client.rs b/crates/axiathon-client/tests/siem_client.rs
new file mode 100644
index 0000000..df51979
--- /dev/null
