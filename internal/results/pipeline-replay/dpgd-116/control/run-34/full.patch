+    // When no --server flag, it should be None (env var handling is at runtime)
+    assert!(cli.is_ok());
+    // Verify the field exists and supports env var via clap's env attribute
+    use clap::CommandFactory;
+    let cmd = Cli::command();
+    let server_arg = cmd
+        .get_arguments()
+        .find(|a| a.get_id() == "server")
+        .expect("--server argument should exist");
+    let env_var = server_arg.get_env();
+    assert!(
+        env_var.is_some(),
+        "--server should have an env var mapping (AXIATHON_SERVER)"
+    );
+    assert_eq!(
+        env_var.unwrap().to_str().unwrap(),
+        "AXIATHON_SERVER",
+        "--server env var should be AXIATHON_SERVER"
+    );
+}
+
+#[test]
+fn cli_format_flag() {
+    let cli = Cli::try_parse_from(["axiathon", "--format", "json", "status"]);
+    assert!(
+        cli.is_ok(),
+        "--format json should parse: {cli:?}"
+    );
+    let cli = cli.unwrap();
+    assert_eq!(
+        cli.format.as_deref(),
+        Some("json"),
+        "--format should store the format value"
+    );
+}
+
+#[test]
+fn cli_format_accepts_table_json_csv() {
+    for fmt in &["table", "json", "csv"] {
+        let cli = Cli::try_parse_from(["axiathon", "--format", fmt, "status"]);
+        assert!(
+            cli.is_ok(),
+            "--format {fmt} should parse: {cli:?}"
+        );
+    }
+}
+
+#[test]
+fn cli_tenant_flag() {
+    let cli = Cli::try_parse_from(["axiathon", "--tenant", "tenant-123", "status"]);
+    assert!(
+        cli.is_ok(),
+        "--tenant should parse: {cli:?}"
+    );
+    let cli = cli.unwrap();
+    assert_eq!(
+        cli.tenant.as_deref(),
+        Some("tenant-123"),
+        "--tenant should store the tenant ID"
+    );
+}
+
+#[test]
+fn cli_config_flag() {
+    let cli = Cli::try_parse_from(["axiathon", "--config", "/custom/path.toml", "status"]);
+    assert!(
+        cli.is_ok(),
+        "--config should parse: {cli:?}"
+    );
+    let cli = cli.unwrap();
+    assert_eq!(
+        cli.config.as_deref(),
+        Some("/custom/path.toml"),
+        "--config should store the config path"
+    );
+}
+
+#[test]
+fn cli_no_color_flag() {
+    let cli = Cli::try_parse_from(["axiathon", "--no-color", "status"]);
+    assert!(
+        cli.is_ok(),
+        "--no-color should parse: {cli:?}"
+    );
+    let cli = cli.unwrap();
+    assert!(cli.no_color, "--no-color should be true");
+}
+
+#[test]
+fn cli_global_flags_work_with_any_subcommand() {
+    // Global flags should work regardless of which subcommand is used
+    let cli = Cli::try_parse_from([
+        "axiathon", "-vv", "--quiet", "--format", "csv",
+        "--tenant", "t1", "--no-color", "rules", "list",
+    ]);
+    assert!(
+        cli.is_ok(),
+        "All global flags should work with any subcommand: {cli:?}"
+    );
+    let cli = cli.unwrap();
+    assert_eq!(cli.verbose, 2);
+    assert!(cli.quiet);
+    assert!(cli.no_color);
+}
+
+// ============================================================
+// AC-6: Clap declarative (derive macros)
+// ============================================================
+
+#[test]
+fn cli_struct_implements_parser() {
+    // Verify Cli implements clap::Parser (compile-time check)
+    fn assert_parser<T: Parser>() {}
+    assert_parser::<Cli>();
+}
+
+#[test]
+fn commands_enum_implements_subcommand() {
+    // Verify Commands implements clap::Subcommand (compile-time check)
+    fn assert_subcommand<T: clap::Subcommand>() {}
+    assert_subcommand::<Commands>();
+}
diff --git a/crates/axiathon-client/tests/config_loading.rs b/crates/axiathon-client/tests/config_loading.rs
new file mode 100644
index 0000000..147514c
--- /dev/null
+++ b/crates/axiathon-client/tests/config_loading.rs
@@ -0,0 +1,223 @@
+//! Tests for configuration loading (Story 6.1, AC-8).
+//!
+//! Covers:
+//! - ClientConfig loads from ~/.config/axiathon/cli.toml
+//! - Override path via --config
+//! - Env vars AXIATHON_API_URL, AXIATHON_TIMEOUT override file values
+//! - Tokens NOT stored in config file (security)
+//! - Config precedence: CLI flags > env vars > config file > defaults
+
+use axiathon_client::config::ClientConfig;
+use std::path::Path;
+
+// ============================================================
+// AC-8: Config loading from TOML
+// ============================================================
+
+#[test]
+fn config_loads_from_toml_file() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = "https://api.example.com"
+timeout = 30
+"#,
+    )
+    .unwrap();
+
+    let config = ClientConfig::from_file(&config_path).expect("Should load valid TOML config");
+    assert_eq!(
+        config.server_url(),
+        "https://api.example.com",
+        "Config should parse server URL from TOML"
+    );
+    assert_eq!(
+        config.timeout_seconds(),
+        30,
+        "Config should parse timeout from TOML"
+    );
+}
+
+#[test]
+fn config_returns_error_for_missing_file() {
+    let result = ClientConfig::from_file(Path::new("/nonexistent/path/cli.toml"));
+    assert!(
+        result.is_err(),
+        "Missing config file should return error, not panic"
+    );
+}
+
+#[test]
+fn config_returns_error_for_invalid_toml() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(&config_path, "this is not valid [toml = ").unwrap();
+
+    let result = ClientConfig::from_file(&config_path);
+    assert!(
+        result.is_err(),
+        "Invalid TOML should return error, not panic"
+    );
+}
+
+#[test]
+fn config_has_sensible_defaults() {
+    let config = ClientConfig::default();
+    assert!(
+        !config.server_url().is_empty(),
+        "Default server URL should not be empty"
+    );
+    assert!(
+        config.timeout_seconds() > 0,
+        "Default timeout should be positive"
+    );
+}
+
+// ============================================================
+// AC-8: Env var overrides
+// ============================================================
+
+#[test]
+fn config_axiathon_api_url_env_overrides_file() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = "https://from-file.example.com"
+"#,
+    )
+    .unwrap();
+
+    // Simulate env var override
+    let config = ClientConfig::from_file_with_env(
+        &config_path,
+        Some("https://from-env.example.com"),
+        None,
+    )
+    .unwrap();
+
+    assert_eq!(
+        config.server_url(),
+        "https://from-env.example.com",
+        "AXIATHON_API_URL env var should override config file value"
+    );
+}
+
+#[test]
+fn config_axiathon_timeout_env_overrides_file() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = "https://api.example.com"
+timeout = 30
+"#,
+    )
+    .unwrap();
+
+    let config = ClientConfig::from_file_with_env(
+        &config_path,
+        None,
+        Some("60"),
+    )
+    .unwrap();
+
+    assert_eq!(
+        config.timeout_seconds(),
+        60,
+        "AXIATHON_TIMEOUT env var should override config file timeout"
+    );
+}
+
+// ============================================================
+// AC-8: Security — tokens NOT in config
+// ============================================================
+
+#[test]
+fn config_does_not_store_tokens() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = "https://api.example.com"
+token = "should-be-ignored"
+"#,
+    )
+    .unwrap();
+
+    let config = ClientConfig::from_file(&config_path).unwrap();
+    // ClientConfig should NOT have a token field — tokens go in OS keychain
+    assert!(
+        !format!("{config:?}").contains("should-be-ignored"),
+        "Config should not store or expose tokens — they belong in OS keychain"
+    );
+}
+
+// ============================================================
+// AC-8: Default config path
+// ============================================================
+
+#[test]
+fn config_default_path_uses_xdg() {
+    let path = ClientConfig::default_path();
+    let path_str = path.to_string_lossy();
+    // Should use dirs crate to find config dir
+    assert!(
+        path_str.contains("axiathon") && path_str.contains("cli.toml"),
+        "Default config path should contain 'axiathon/cli.toml': {path_str}"
+    );
+}
+
+// ============================================================
+// Lang-review #5: Config validation at trust boundary
+// ============================================================
+
+#[test]
+fn config_rejects_empty_server_url() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = ""
+"#,
+    )
+    .unwrap();
+
+    let result = ClientConfig::from_file(&config_path);
+    assert!(
+        result.is_err(),
+        "Empty server URL should be rejected during config validation"
+    );
+}
+
+#[test]
+fn config_rejects_negative_timeout() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+[server]
+url = "https://api.example.com"
+timeout = -1
+"#,
+    )
+    .unwrap();
+
+    let result = ClientConfig::from_file(&config_path);
+    assert!(
+        result.is_err(),
+        "Negative timeout should be rejected during config validation"
+    );
+}
