+        command: IngestCommands::Status,
+    });
+    let msg = result.message();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Ingest stub should say 'not yet implemented': {msg}"
+    );
+}
+
+#[test]
+fn stub_config_prints_not_implemented() {
+    let result = execute_command(&Commands::Config {
+        command: ConfigCommands::Show,
+    });
+    let msg = result.message();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Config stub should say 'not yet implemented': {msg}"
+    );
+}
+
+#[test]
+fn stub_status_prints_not_implemented() {
+    let result = execute_command(&Commands::Status);
+    let msg = result.message();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Status stub should say 'not yet implemented': {msg}"
+    );
+}
+
+#[test]
+fn stub_tenant_prints_not_implemented() {
+    let result = execute_command(&Commands::Tenant {
+        command: TenantCommands::List,
+    });
+    let msg = result.message();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Tenant stub should say 'not yet implemented': {msg}"
+    );
+}
+
+#[test]
+fn stub_login_prints_not_implemented() {
+    let result = execute_command(&Commands::Login);
+    let msg = result.message();
+    assert!(
+        msg.contains("not yet implemented"),
+        "Login stub should say 'not yet implemented': {msg}"
+    );
+}
+
+#[test]
+fn stub_handlers_reference_story_number() {
+    // Each stub should reference the Story number (e.g., "Story 6.2", "Story 5.5")
+    let result = execute_command(&Commands::Status);
+    let msg = result.message();
+    assert!(
+        msg.contains("Story"),
+        "Stub message should reference the Story number: {msg}"
+    );
+}
