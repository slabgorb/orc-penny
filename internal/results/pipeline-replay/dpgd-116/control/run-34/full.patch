--- /dev/null
+++ b/crates/axiathon-client/src/cli.rs
@@ -0,0 +1,143 @@
+//! CLI argument parsing with clap 4.x derive macros.
+//!
+//! All command groups defined declaratively — no imperative command building.
+//! Command naming follows the plural-noun + verb pattern per architecture doc.
+
+use clap::Parser;
+
+/// Axiathon CLI - SIEM platform management
+#[derive(Parser, Debug)]
+#[command(name = "axiathon", version, about = "Axiathon SIEM platform CLI")]
+pub struct Cli {
+    #[command(subcommand)]
+    pub command: Option<Commands>,
+
+    /// Increase verbosity (-v for info, -vv for debug)
+    #[arg(short, long, action = clap::ArgAction::Count, global = true)]
+    pub verbose: u8,
+
+    /// Suppress non-error output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL (overrides config file)
+    #[arg(long, global = true, env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Output format (table, json, csv)
+    #[arg(long, global = true)]
+    pub format: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Path to config file (overrides default)
+    #[arg(long, global = true)]
+    pub config: Option<String>,
+
+    /// Disable colored output
+    #[arg(long, global = true)]
+    pub no_color: bool,
+}
+
+/// Top-level command groups
+#[derive(clap::Subcommand, Debug)]
+pub enum Commands {
+    /// Query events and logs
+    Query {
+        #[command(subcommand)]
+        command: QueryCommands,
+    },
+    /// Manage detection rules
+    Rules {
+        #[command(subcommand)]
+        command: RulesCommands,
+    },
+    /// Manage alerts
+    Alerts {
+        #[command(subcommand)]
+        command: AlertsCommands,
+    },
+    /// Manage ingestion pipelines
+    Ingest {
+        #[command(subcommand)]
+        command: IngestCommands,
+    },
+    /// Manage configuration
+    Config {
+        #[command(subcommand)]
+        command: ConfigCommands,
+    },
+    /// Show system status
+    Status,
+    /// Manage tenants
+    Tenant {
+        #[command(subcommand)]
+        command: TenantCommands,
+    },
+    /// Authenticate with the server
+    Login,
+    /// Log out and clear credentials
+    Logout,
+    /// Launch terminal UI
+    Tui,
+    /// Generate shell completions
+    Completion {
+        /// Shell to generate completions for (bash, zsh, fish, powershell)
+        shell: String,
+    },
+    /// First-time setup
+    Init,
+}
+
+/// Query subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum QueryCommands {
+    /// Run a query against the event store
+    Run {
+        /// The query string to execute
+        #[arg(long)]
+        query: String,
+    },
+}
+
+/// Rules subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum RulesCommands {
+    /// List detection rules
+    List,
+}
+
+/// Alerts subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum AlertsCommands {
+    /// List alerts
+    List,
+    /// Acknowledge an alert
+    Acknowledge {
+        /// Alert ID to acknowledge
+        id: String,
+    },
+}
+
+/// Ingest subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum IngestCommands {
+    /// Show ingestion pipeline status
+    Status,
+}
+
+/// Config subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum ConfigCommands {
+    /// Show current configuration
+    Show,
+}
+
+/// Tenant subcommands
+#[derive(clap::Subcommand, Debug)]
+pub enum TenantCommands {
+    /// List tenants
+    List,
+}
