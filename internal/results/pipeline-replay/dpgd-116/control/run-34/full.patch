@@ -0,0 +1,121 @@
+//! Client configuration loading from TOML files with env var overrides.
+//!
+//! Config precedence: CLI flags > env vars > config file > defaults.
+//! Tokens are NOT stored in config — they belong in the OS keychain.
+
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+use crate::error::CliError;
+
+/// Raw TOML structure for deserialization. Extra fields (like `token`) are
+/// silently ignored by serde's default behavior — tokens belong in the OS
+/// keychain, not in config files.
+#[derive(Deserialize)]
+struct RawConfig {
+    server: Option<ServerConfig>,
+}
+
+#[derive(Deserialize)]
+struct ServerConfig {
+    url: Option<String>,
+    timeout: Option<i64>,
+}
+
+/// Client configuration loaded from `~/.config/axiathon/cli.toml`.
+#[derive(Debug)]
+pub struct ClientConfig {
+    server_url: String,
+    timeout_seconds: u64,
+}
+
+impl Default for ClientConfig {
+    fn default() -> Self {
+        Self {
+            server_url: "http://localhost:8080".to_string(),
+            timeout_seconds: 30,
+        }
+    }
+}
+
+impl ClientConfig {
+    /// Load configuration from a TOML file.
+    pub fn from_file(path: &Path) -> Result<Self, CliError> {
+        Self::from_file_with_env(path, None, None)
+    }
+
+    /// Load configuration from a TOML file with env var overrides.
+    ///
+    /// `api_url_env` simulates `AXIATHON_API_URL`, `timeout_env` simulates `AXIATHON_TIMEOUT`.
+    pub fn from_file_with_env(
+        path: &Path,
+        api_url_env: Option<&str>,
+        timeout_env: Option<&str>,
+    ) -> Result<Self, CliError> {
+        let contents = std::fs::read_to_string(path)
+            .map_err(|e| CliError::ConfigError(format!("failed to read config file: {e}")))?;
+
+        let raw: RawConfig = toml::from_str(&contents)
+            .map_err(|e| CliError::ConfigError(format!("invalid TOML: {e}")))?;
+
+        let defaults = Self::default();
+
+        let file_url = raw
+            .server
+            .as_ref()
+            .and_then(|s| s.url.clone())
+            .unwrap_or(defaults.server_url);
+
+        let file_timeout = raw
+            .server
+            .as_ref()
+            .and_then(|s| s.timeout)
+            .unwrap_or(defaults.timeout_seconds as i64);
+
+        // Env vars override file values
+        let server_url = api_url_env
+            .map(String::from)
+            .unwrap_or(file_url);
+
+        let timeout_seconds = match timeout_env {
+            Some(t) => t
+                .parse::<i64>()
+                .map_err(|e| CliError::ConfigError(format!("invalid AXIATHON_TIMEOUT: {e}")))?,
+            None => file_timeout,
+        };
+
+        // Validate
+        if server_url.is_empty() {
+            return Err(CliError::ConfigError("server URL cannot be empty".into()));
+        }
+        if timeout_seconds < 0 {
+            return Err(CliError::ConfigError(
+                "timeout cannot be negative".into(),
+            ));
+        }
+
+        Ok(Self {
+            server_url,
+            timeout_seconds: timeout_seconds as u64,
+        })
+    }
+
+    /// Get the default config file path (`~/.config/axiathon/cli.toml`).
+    pub fn default_path() -> PathBuf {
+        dirs::config_dir()
+            .unwrap_or_else(|| PathBuf::from(".config"))
+            .join("axiathon")
+            .join("cli.toml")
+    }
+
+    /// Get the configured server URL.
+    pub fn server_url(&self) -> &str {
+        &self.server_url
+    }
+
+    /// Get the configured timeout in seconds.
+    pub fn timeout_seconds(&self) -> u64 {
+        self.timeout_seconds
+    }
+}
