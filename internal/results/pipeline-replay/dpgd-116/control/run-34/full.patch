index 0000000..4a23ea2
--- /dev/null
+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,77 @@
+//! SiemClient HTTP wrapper for API communication.
+//!
+//! Injects tenant and auth headers, maps HTTP status codes to CliError variants.
+
+use crate::error::CliError;
+
+/// HTTP client wrapper for Axiathon API server communication.
+///
+/// Debug impl intentionally omits auth_token to prevent credential leaking (CWE-532).
+pub struct SiemClient {
+    server_url: String,
+    auth_token: Option<String>,
+}
+
+impl std::fmt::Debug for SiemClient {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SiemClient")
+            .field("server_url", &self.server_url)
+            .field("auth_token", &self.auth_token.as_ref().map(|_| "[REDACTED]"))
+            .finish()
+    }
+}
+
+impl SiemClient {
+    /// Create a new SiemClient with server URL and optional auth token.
+    pub fn new(server_url: &str, auth_token: Option<String>) -> Self {
+        Self {
+            server_url: server_url.to_string(),
+            auth_token,
+        }
+    }
+
+    /// Get the configured server URL.
+    pub fn server_url(&self) -> &str {
+        &self.server_url
+    }
+
+    /// Check if an auth token is configured.
+    pub fn has_auth_token(&self) -> bool {
+        self.auth_token.is_some()
+    }
+
+    /// Build request headers with tenant and auth context.
+    ///
+    /// Injects `X-Tenant-ID` and (if token present) `Authorization: Bearer <token>`.
+    /// reqwest's `HeaderValue` rejects values containing newlines (CWE-113 prevention).
+    pub fn build_headers(&self, tenant_id: &str) -> reqwest::header::HeaderMap {
+        use reqwest::header::{HeaderMap, HeaderValue};
+
+        let mut headers = HeaderMap::new();
+        // HeaderValue::from_str rejects values with \r or \n — CWE-113 prevention
+        headers.insert(
+            "X-Tenant-ID",
+            HeaderValue::from_str(tenant_id).expect("tenant_id contains invalid header characters"),
+        );
+        if let Some(token) = &self.auth_token {
+            let bearer = format!("Bearer {token}");
+            headers.insert(
+                "Authorization",
+                HeaderValue::from_str(&bearer).expect("auth token contains invalid header characters"),
+            );
+        }
+        headers
+    }
+
+    /// Map an HTTP status code to a CliError variant.
+    pub fn map_http_status(status: u16, body: &str) -> CliError {
+        match status {
+            401 => CliError::AuthenticationExpired("authentication expired or invalid".into()),
+            403 => CliError::Unauthorized("insufficient permissions".into()),
+            404 => CliError::NotFound("resource not found".into()),
+            429 => CliError::RateLimited,
+            500..=599 => CliError::ServerError(status, body.to_string()),
+            _ => CliError::General(format!("unexpected HTTP status: {status}")),
+        }
+    }
+}
