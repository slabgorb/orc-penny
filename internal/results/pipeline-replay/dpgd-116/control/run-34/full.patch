index 0000000..9109c9c
--- /dev/null
+++ b/crates/axiathon-client/tests/exit_codes.rs
@@ -0,0 +1,175 @@
+//! Tests for exit code mapping (Story 6.1, AC-3).
+//!
+//! Exit codes:
+//! - 0: success
+//! - 1: general error
+//! - 2: usage error (clap handles automatically)
+//! - 3: authentication failure
+//! - 4: authorization failure
+
+use axiathon_client::error::CliError;
+
+// ============================================================
+// AC-3: Exit code mapping
+// ============================================================
+
+#[test]
+fn exit_code_general_error_is_1() {
+    let err = CliError::General("something went wrong".into());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "General error should map to exit code 1"
+    );
+}
+
+#[test]
+fn exit_code_authentication_expired_is_3() {
+    let err = CliError::AuthenticationExpired("token expired".into());
+    assert_eq!(
+        err.exit_code(),
+        3,
+        "AuthenticationExpired should map to exit code 3"
+    );
+}
+
+#[test]
+fn exit_code_unauthorized_is_4() {
+    let err = CliError::Unauthorized("insufficient permissions".into());
+    assert_eq!(
+        err.exit_code(),
+        4,
+        "Unauthorized should map to exit code 4"
+    );
+}
+
+#[test]
+fn exit_code_not_found_is_1() {
+    let err = CliError::NotFound("resource not found".into());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "NotFound should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn exit_code_rate_limited_is_1() {
+    let err = CliError::RateLimited;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "RateLimited should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn exit_code_server_error_is_1() {
+    let err = CliError::ServerError(500, "internal server error".into());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ServerError should map to exit code 1 (general error)"
+    );
+}
+
+#[test]
+fn exit_code_connection_timeout_is_1() {
+    let err = CliError::ConnectionTimeout;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ConnectionTimeout should map to exit code 1"
+    );
+}
+
+#[test]
+fn exit_code_server_unavailable_is_1() {
+    let err = CliError::ServerUnavailable;
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ServerUnavailable should map to exit code 1"
+    );
+}
+
+#[test]
+fn exit_code_config_error_is_1() {
+    let err = CliError::ConfigError("missing field".into());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ConfigError should map to exit code 1"
+    );
+}
+
+// ============================================================
+// AC-3: Error display — SECURITY (CWE-209)
+// ============================================================
+
+#[test]
+fn error_display_does_not_expose_server_url() {
+    let err = CliError::ServerUnavailable;
+    let display = err.to_string();
+    assert!(
+        !display.contains("http://"),
+        "Error display should not expose server URLs (CWE-209): {display}"
+    );
+    assert!(
+        !display.contains("https://"),
+        "Error display should not expose server URLs (CWE-209): {display}"
+    );
+}
+
+#[test]
+fn error_display_does_not_expose_token() {
+    let err = CliError::AuthenticationExpired("token expired".into());
+    let display = err.to_string();
+    assert!(
+        !display.contains("Bearer"),
+        "Error display should not expose auth tokens (CWE-209): {display}"
+    );
+}
+
+#[test]
+fn error_implements_std_error_send_sync() {
+    fn assert_bounds<T: std::error::Error + Send + Sync + 'static>() {}
+    assert_bounds::<CliError>();
+}
+
+// ============================================================
+// Lang-review #2: non_exhaustive on CliError
+// ============================================================
+
+#[test]
+fn cli_error_is_non_exhaustive() {
+    // CliError should have #[non_exhaustive] to allow adding variants
+    // This test verifies the enum compiles with non_exhaustive —
+    // downstream match statements need a wildcard arm.
+    let err = CliError::General("test".into());
+    let code = match err {
+        CliError::General(_) => 1,
+        // If #[non_exhaustive] is present, this wildcard is required for
+        // external crates. The test verifies the enum is usable with wildcard.
+        _ => 0,
+    };
+    assert_eq!(code, 1);
+}
+
+// ============================================================
+// AC-3: stderr vs stdout separation
+// ============================================================
+
+#[test]
+fn cli_error_has_display_for_stderr() {
+    let err = CliError::General("disk full".into());
+    let display = format!("{err}");
+    assert!(
+        !display.is_empty(),
+        "CliError Display should produce non-empty message for stderr"
+    );
+    assert!(
+        display.contains("disk full"),
+        "CliError Display should include the error description: {display}"
+    );
+}
diff --git a/crates/axiathon-client/tests/output_format.rs b/crates/axiathon-client/tests/output_format.rs
new file mode 100644
index 0000000..94bfeac
--- /dev/null
+++ b/crates/axiathon-client/tests/output_format.rs
@@ -0,0 +1,246 @@
+//! Tests for output formatting (Story 6.1, AC-4).
+//!
+//! Covers:
+//! - OutputFormatter trait with Table/JSON/CSV implementations
+//! - Table auto-detects terminal width, uses ANSI colors
+//! - JSON includes ResponseMetadata (request_id, timestamp, api_version)
+//! - CSV includes headers with proper escaping
+//! - TTY detection: table default for TTY, JSON for piped
+
+use axiathon_client::output::{OutputFormat, OutputFormatter};
+
+// ============================================================
+// AC-4: OutputFormatter trait exists and has required methods
+// ============================================================
+
+#[test]
+fn output_format_table_variant_exists() {
+    let fmt = OutputFormat::Table;
+    assert!(
+        matches!(fmt, OutputFormat::Table),
+        "Table variant should exist"
+    );
+}
+
+#[test]
+fn output_format_json_variant_exists() {
+    let fmt = OutputFormat::Json;
+    assert!(
+        matches!(fmt, OutputFormat::Json),
+        "Json variant should exist"
+    );
+}
+
+#[test]
+fn output_format_csv_variant_exists() {
+    let fmt = OutputFormat::Csv;
+    assert!(
+        matches!(fmt, OutputFormat::Csv),
+        "Csv variant should exist"
+    );
+}
+
+#[test]
+fn output_format_from_str_table() {
+    let fmt: OutputFormat = "table".parse().expect("should parse 'table'");
+    assert!(matches!(fmt, OutputFormat::Table));
+}
+
+#[test]
+fn output_format_from_str_json() {
+    let fmt: OutputFormat = "json".parse().expect("should parse 'json'");
+    assert!(matches!(fmt, OutputFormat::Json));
+}
+
+#[test]
+fn output_format_from_str_csv() {
+    let fmt: OutputFormat = "csv".parse().expect("should parse 'csv'");
+    assert!(matches!(fmt, OutputFormat::Csv));
+}
+
+#[test]
+fn output_format_from_str_rejects_invalid() {
+    let result: Result<OutputFormat, _> = "xml".parse();
+    assert!(
+        result.is_err(),
+        "Invalid format 'xml' should be rejected"
+    );
+}
+
+// ============================================================
+// AC-4: Table formatting
+// ============================================================
+
+#[test]
+fn table_formatter_produces_aligned_columns() {
+    let formatter = OutputFormatter::table();
+    let headers = vec!["Name", "Status", "Count"];
+    let rows = vec![
+        vec!["service-a", "running", "42"],
+        vec!["service-b", "stopped", "0"],
+    ];
+    let output = formatter.format_rows(&headers, &rows);
+    // Table output should contain all headers
+    assert!(output.contains("Name"), "Table should contain 'Name' header");
+    assert!(output.contains("Status"), "Table should contain 'Status' header");
+    assert!(output.contains("Count"), "Table should contain 'Count' header");
+    // Table output should contain all values
+    assert!(output.contains("service-a"), "Table should contain row data");
+    assert!(output.contains("42"), "Table should contain row data");
+}
+
+#[test]
+fn table_formatter_handles_empty_rows() {
+    let formatter = OutputFormatter::table();
+    let headers = vec!["Name", "Status"];
+    let rows: Vec<Vec<&str>> = vec![];
+    let output = formatter.format_rows(&headers, &rows);
+    // Should still produce headers even with no data
+    assert!(output.contains("Name"), "Headers should appear even with no rows");
+}
+
+// ============================================================
+// AC-4: JSON formatting with ResponseMetadata
+// ============================================================
+
+#[test]
+fn json_formatter_includes_request_id() {
+    let formatter = OutputFormatter::json();
+    let data = serde_json::json!({"items": [1, 2, 3]});
+    let output = formatter.format_json(&data);
+    let parsed: serde_json::Value = serde_json::from_str(&output)
+        .expect("JSON output should be valid JSON");
+    assert!(
+        parsed.get("request_id").is_some() || parsed.get("metadata").and_then(|m| m.get("request_id")).is_some(),
+        "JSON output should include request_id in metadata"
+    );
+}
+
+#[test]
+fn json_formatter_includes_timestamp() {
+    let formatter = OutputFormatter::json();
+    let data = serde_json::json!({"items": []});
+    let output = formatter.format_json(&data);
+    let parsed: serde_json::Value = serde_json::from_str(&output)
+        .expect("JSON output should be valid JSON");
+    assert!(
+        parsed.get("timestamp").is_some() || parsed.get("metadata").and_then(|m| m.get("timestamp")).is_some(),
+        "JSON output should include timestamp in metadata"
+    );
+}
+
+#[test]
+fn json_formatter_includes_api_version() {
+    let formatter = OutputFormatter::json();
+    let data = serde_json::json!({"items": []});
+    let output = formatter.format_json(&data);
+    let parsed: serde_json::Value = serde_json::from_str(&output)
+        .expect("JSON output should be valid JSON");
+    assert!(
+        parsed.get("api_version").is_some() || parsed.get("metadata").and_then(|m| m.get("api_version")).is_some(),
+        "JSON output should include api_version in metadata"
+    );
+}
+
+#[test]
+fn json_formatter_preserves_data_structure() {
+    let formatter = OutputFormatter::json();
+    let data = serde_json::json!({"name": "test", "count": 42});
+    let output = formatter.format_json(&data);
+    let parsed: serde_json::Value = serde_json::from_str(&output).unwrap();
+    // Data should be present, either at top level or under "data" key
+    let data_section = parsed.get("data").unwrap_or(&parsed);
+    assert_eq!(
+        data_section.get("name").and_then(|v| v.as_str()),
+        Some("test"),
+        "JSON output should preserve original data"
+    );
+}
+
+// ============================================================
+// AC-4: CSV formatting
+// ============================================================
+
+#[test]
+fn csv_formatter_includes_headers() {
+    let formatter = OutputFormatter::csv();
+    let headers = vec!["Name", "Status", "Count"];
+    let rows = vec![
+        vec!["service-a", "running", "42"],
+    ];
+    let output = formatter.format_rows(&headers, &rows);
+    let first_line = output.lines().next().expect("CSV should have at least one line");
+    assert!(
+        first_line.contains("Name") && first_line.contains("Status") && first_line.contains("Count"),
+        "CSV first line should be headers: {first_line}"
+    );
+}
+
+#[test]
+fn csv_formatter_escapes_commas_in_values() {
+    let formatter = OutputFormatter::csv();
+    let headers = vec!["Name", "Description"];
+    let rows = vec![
+        vec!["service-a", "has, commas, inside"],
+    ];
+    let output = formatter.format_rows(&headers, &rows);
+    // CSV values with commas should be quoted
+    assert!(
+        output.contains("\"has, commas, inside\""),
+        "CSV should quote values containing commas: {output}"
+    );
+}
+
+#[test]
+fn csv_formatter_escapes_quotes_in_values() {
+    let formatter = OutputFormatter::csv();
+    let headers = vec!["Name", "Note"];
+    let rows = vec![
+        vec!["test", "has \"quotes\" inside"],
+    ];
+    let output = formatter.format_rows(&headers, &rows);
+    // CSV values with quotes should have them escaped (doubled)
+    assert!(
+        output.contains("\"\"quotes\"\""),
+        "CSV should escape quotes by doubling: {output}"
+    );
+}
+
+// ============================================================
+// AC-4: TTY detection
+// ============================================================
+
+#[test]
+fn output_format_default_for_tty_is_table() {
+    let fmt = OutputFormat::default_for_tty(true);
+    assert!(
+        matches!(fmt, OutputFormat::Table),
+        "Default for TTY should be Table"
+    );
+}
+
+#[test]
+fn output_format_default_for_non_tty_is_json() {
+    let fmt = OutputFormat::default_for_tty(false);
+    assert!(
+        matches!(fmt, OutputFormat::Json),
+        "Default for piped (non-TTY) should be JSON"
+    );
+}
+
+// ============================================================
+// Security: no-color flag disables ANSI
+// ============================================================
+
+#[test]
+fn table_formatter_no_color_disables_ansi() {
+    let formatter = OutputFormatter::table_no_color();
+    let headers = vec!["Status"];
+    let rows = vec![vec!["running"]];
+    let output = formatter.format_rows(&headers, &rows);
+    // ANSI escape codes start with \x1b[
+    assert!(
+        !output.contains("\x1b["),
+        "No-color table should not contain ANSI escape codes: {output:?}"
+    );
+}
