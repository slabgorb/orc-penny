+//! CLI error types with structured exit code mapping.
+//!
+//! **SECURITY:** Display impl is for operator-facing messages only.
+//! Internal details (server URLs, token prefixes) must not be included
+//! in error messages — CWE-209.
+
+use thiserror::Error;
+
+/// CLI-specific error type with exit code mapping.
+///
+/// Exit codes per architecture doc:
+/// - 0: success
+/// - 1: general error
+/// - 2: usage error (clap handles automatically)
+/// - 3: authentication failure
+/// - 4: authorization failure
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum CliError {
+    /// General CLI error
+    #[error("{0}")]
+    General(String),
+
+    /// Authentication expired or invalid (exit code 3)
+    #[error("{0}")]
+    AuthenticationExpired(String),
+
+    /// Authorization failure — insufficient permissions (exit code 4)
+    #[error("{0}")]
+    Unauthorized(String),
+
+    /// Resource not found
+    #[error("{0}")]
+    NotFound(String),
+
+    /// Rate limited by server
+    #[error("rate limited")]
+    RateLimited,
+
+    /// Server error with HTTP status code
+    #[error("server error ({0})")]
+    ServerError(u16, String),
+
+    /// Connection timed out
+    #[error("connection timed out")]
+    ConnectionTimeout,
+
+    /// Server unavailable (connection refused)
+    #[error("server unavailable")]
+    ServerUnavailable,
+
+    /// Configuration error
+    #[error("{0}")]
+    ConfigError(String),
+}
+
+impl CliError {
+    /// Map error to process exit code.
+    pub fn exit_code(&self) -> i32 {
+        match self {
+            Self::AuthenticationExpired(_) => 3,
+            Self::Unauthorized(_) => 4,
+            _ => 1,
+        }
+    }
+}
