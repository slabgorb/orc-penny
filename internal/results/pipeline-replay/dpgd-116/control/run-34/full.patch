@@ -0,0 +1,141 @@
+//! Output formatting for CLI commands.
+//!
+//! Supports table (comfy-table), JSON (serde_json + metadata), and CSV output.
+//! Table is default for TTY, JSON for piped output.
+
+use std::str::FromStr;
+
+/// Output format selection for CLI commands.
+#[derive(Debug, Clone)]
+#[non_exhaustive]
+pub enum OutputFormat {
+    /// Table output via comfy-table (default for TTY)
+    Table,
+    /// JSON output with ResponseMetadata
+    Json,
+    /// CSV output with headers
+    Csv,
+}
+
+impl OutputFormat {
+    /// Return the default format based on TTY detection.
+    /// Table for interactive terminals, JSON for piped output.
+    pub fn default_for_tty(is_tty: bool) -> Self {
+        if is_tty {
+            Self::Table
+        } else {
+            Self::Json
+        }
+    }
+}
+
+impl FromStr for OutputFormat {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "table" => Ok(Self::Table),
+            "json" => Ok(Self::Json),
+            "csv" => Ok(Self::Csv),
+            other => Err(format!("unknown output format: '{other}' (expected table, json, or csv)")),
+        }
+    }
+}
+
+/// Formatter for CLI command output in table, JSON, or CSV format.
+pub struct OutputFormatter {
+    format: OutputFormat,
+    no_color: bool,
+}
+
+impl OutputFormatter {
+    /// Create a table formatter.
+    pub fn table() -> Self {
+        Self {
+            format: OutputFormat::Table,
+            no_color: false,
+        }
+    }
+
+    /// Create a table formatter with ANSI colors disabled.
+    pub fn table_no_color() -> Self {
+        Self {
+            format: OutputFormat::Table,
+            no_color: true,
+        }
+    }
+
+    /// Create a JSON formatter.
+    pub fn json() -> Self {
+        Self {
+            format: OutputFormat::Json,
+            no_color: false,
+        }
+    }
+
+    /// Create a CSV formatter.
+    pub fn csv() -> Self {
+        Self {
+            format: OutputFormat::Csv,
+            no_color: false,
+        }
+    }
+
+    /// Format tabular data as rows with headers.
+    pub fn format_rows(&self, headers: &[&str], rows: &[Vec<&str>]) -> String {
+        match self.format {
+            OutputFormat::Table => self.format_table(headers, rows),
+            OutputFormat::Csv => self.format_csv(headers, rows),
+            OutputFormat::Json => {
+                let data: Vec<serde_json::Map<String, serde_json::Value>> = rows
+                    .iter()
+                    .map(|row| {
+                        headers
+                            .iter()
+                            .zip(row.iter())
+                            .map(|(h, v)| ((*h).to_string(), serde_json::Value::String((*v).to_string())))
+                            .collect()
+                    })
+                    .collect();
+                self.format_json(&serde_json::json!(data))
+            }
+        }
+    }
+
+    fn format_table(&self, headers: &[&str], rows: &[Vec<&str>]) -> String {
+        use comfy_table::Table;
+
+        let mut table = Table::new();
+        if self.no_color {
+            table.force_no_tty();
+        }
+        table.set_header(headers);
+        for row in rows {
+            table.add_row(row);
+        }
+        table.to_string()
+    }
+
+    fn format_csv(&self, headers: &[&str], rows: &[Vec<&str>]) -> String {
+        let mut wtr = csv::Writer::from_writer(Vec::new());
+        wtr.write_record(headers).expect("CSV header write failed");
+        for row in rows {
+            wtr.write_record(row).expect("CSV row write failed");
+        }
+        wtr.flush().expect("CSV flush failed");
+        String::from_utf8(wtr.into_inner().expect("CSV inner failed")).expect("CSV UTF-8 failed")
+    }
+
+    /// Format JSON data with ResponseMetadata.
+    pub fn format_json(&self, data: &serde_json::Value) -> String {
+        let envelope = serde_json::json!({
+            "data": data,
+            "metadata": {
+                "request_id": uuid::Uuid::now_v7().to_string(),
+                "timestamp": chrono::Utc::now().to_rfc3339(),
+                "api_version": "v1",
+            }
+        });
+        serde_json::to_string_pretty(&envelope).expect("JSON serialization failed")
+    }
+}
