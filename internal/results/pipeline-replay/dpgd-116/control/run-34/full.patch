new file mode 100644
index 0000000..9dd1d88
--- /dev/null
+++ b/crates/axiathon-client/src/commands/completion.rs
@@ -0,0 +1,25 @@
+//! Shell completion generation using clap_complete.
+
+use clap::CommandFactory;
+use clap_complete::{Shell, generate};
+
+use crate::cli::Cli;
+
+/// Generate shell completion script for the given shell.
+///
+/// Supported shells: bash, zsh, fish, powershell.
+/// Returns the completion script as a string.
+pub fn generate_completions(shell: &str) -> String {
+    let shell: Shell = match shell {
+        "bash" => Shell::Bash,
+        "zsh" => Shell::Zsh,
+        "fish" => Shell::Fish,
+        "powershell" => Shell::PowerShell,
+        other => panic!("unsupported shell: {other} (expected bash, zsh, fish, or powershell)"),
+    };
+
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(shell, &mut cmd, "axiathon", &mut buf);
+    String::from_utf8(buf).expect("completion output should be valid UTF-8")
+}
