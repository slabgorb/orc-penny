+#[test]
+fn cli_format_flag_accepts_csv() {
+    let result = Cli::try_parse_from(["axiathon", "--format", "csv", "status"]);
+    assert!(
+        result.is_ok(),
+        "CLI should accept --format csv: {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn cli_format_flag_rejects_invalid() {
+    let result = Cli::try_parse_from(["axiathon", "--format", "xml", "status"]);
+    assert!(result.is_err(), "CLI should reject --format xml");
+}
+
+#[test]
+fn cli_has_verbose_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "verbose");
+    assert!(arg.is_some(), "CLI must have -v/--verbose flag");
+}
+
+#[test]
+fn cli_verbose_flag_is_repeatable() {
+    // -vv should parse without error (repeatable for debug level)
+    let result = Cli::try_parse_from(["axiathon", "-vv", "status"]);
+    assert!(
+        result.is_ok(),
+        "CLI should accept -vv (repeatable verbose): {:?}",
+        result.err()
+    );
+}
+
+#[test]
+fn cli_has_quiet_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "quiet");
+    assert!(arg.is_some(), "CLI must have --quiet flag");
+}
+
+#[test]
+fn cli_has_server_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "server");
+    assert!(arg.is_some(), "CLI must have --server flag");
+}
+
+#[test]
+fn cli_server_flag_reads_env_var() {
+    // --server should support AXIATHON_SERVER env var
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "server").unwrap();
+    let env_var = arg.get_env();
+    assert!(
+        env_var.is_some_and(|e| e == "AXIATHON_SERVER"),
+        "--server must read AXIATHON_SERVER env var, got: {:?}",
+        arg.get_env()
+    );
+}
+
+#[test]
+fn cli_has_tenant_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "tenant");
+    assert!(arg.is_some(), "CLI must have --tenant flag");
+}
+
+#[test]
+fn cli_has_config_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "config");
+    assert!(arg.is_some(), "CLI must have --config flag");
+}
+
+#[test]
+fn cli_has_no_color_flag() {
+    let cmd = Cli::command();
+    let arg = cmd.get_arguments().find(|a| a.get_id() == "no_color" || a.get_id() == "no-color");
+    assert!(arg.is_some(), "CLI must have --no-color flag");
+}
+
+#[test]
+fn cli_global_flags_are_global() {
+    // Global flags must be defined with `global = true` so they work with any subcommand.
+    let cmd = Cli::command();
+    let global_flag_names = ["format", "verbose", "quiet", "server", "tenant", "config"];
+    for name in &global_flag_names {
+        let arg = cmd.get_arguments().find(|a| a.get_id() == *name);
+        assert!(
+            arg.is_some(),
+            "Global flag '{name}' must exist on the top-level command"
+        );
+        assert!(
+            arg.unwrap().is_global_set(),
+            "Flag '{name}' must be defined with global = true"
+        );
+    }
+}
diff --git a/crates/axiathon-client/tests/cli_output_format.rs b/crates/axiathon-client/tests/cli_output_format.rs
