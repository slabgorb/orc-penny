@@ -0,0 +1,150 @@
+//! Tests for client configuration loading (AC-8).
+//!
+//! Verifies:
+//! - ClientConfig loads from ~/.config/axiathon/cli.toml
+//! - --config overrides default path
+//! - Env vars AXIATHON_API_URL, AXIATHON_TIMEOUT override file values
+//! - Tokens are NOT stored in config file (keychain only)
+//! - Config precedence: CLI flags > env vars > config file > defaults
+
+use axiathon_client::config::ClientConfig;
+use std::io::Write;
+
+// ============================================================
+// AC-8: Config loading
+// ============================================================
+
+#[test]
+fn client_config_default_has_sane_values() {
+    let config = ClientConfig::default();
+    // Default API URL should be localhost or similar development default
+    assert!(
+        !config.api_url().is_empty(),
+        "Default API URL must not be empty"
+    );
+    // Default timeout should be reasonable (> 0)
+    assert!(
+        config.timeout_secs() > 0,
+        "Default timeout must be positive"
+    );
+}
+
+#[test]
+fn client_config_loads_from_toml_file() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    let mut file = std::fs::File::create(&config_path).unwrap();
+    write!(
+        file,
+        r#"
+api_url = "https://axiathon.example.com"
+timeout = 30
+"#
+    )
+    .unwrap();
+
+    let config = ClientConfig::from_file(&config_path).unwrap();
+    assert_eq!(config.api_url(), "https://axiathon.example.com");
+    assert_eq!(config.timeout_secs(), 30);
+}
+
+#[test]
+fn client_config_missing_file_returns_error() {
+    let result = ClientConfig::from_file("/nonexistent/path/cli.toml");
+    assert!(result.is_err(), "Missing config file should return error");
+}
+
+#[test]
+fn client_config_invalid_toml_returns_error() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(&config_path, "this is not valid toml {{{{").unwrap();
+
+    let result = ClientConfig::from_file(&config_path);
+    assert!(result.is_err(), "Invalid TOML should return error");
+}
+
+#[test]
+fn client_config_env_var_overrides_file_api_url() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"api_url = "https://from-file.example.com""#,
+    )
+    .unwrap();
+
+    // Test env var override — the config loader should prefer env vars over file
+    let config = ClientConfig::from_file_with_env(
+        &config_path,
+        Some("https://from-env.example.com"),
+        None,
+    )
+    .unwrap();
+    assert_eq!(
+        config.api_url(),
+        "https://from-env.example.com",
+        "AXIATHON_API_URL env var must override config file value"
+    );
+}
+
+#[test]
+fn client_config_env_var_overrides_file_timeout() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(&config_path, r#"timeout = 10"#).unwrap();
+
+    let config = ClientConfig::from_file_with_env(&config_path, None, Some("60")).unwrap();
+    assert_eq!(
+        config.timeout_secs(),
+        60,
+        "AXIATHON_TIMEOUT env var must override config file value"
+    );
+}
+
+#[test]
+fn client_config_default_path_uses_xdg_config() {
+    let path = ClientConfig::default_config_path();
+    // Should resolve to ~/.config/axiathon/cli.toml (or platform equivalent)
+    let path_str = path.to_string_lossy();
+    assert!(
+        path_str.contains("axiathon") && path_str.ends_with("cli.toml"),
+        "Default config path should be under axiathon dir and named cli.toml, got: {path_str}"
+    );
+}
+
+#[test]
+fn client_config_does_not_store_token_field() {
+    // Tokens must be in OS keychain, NOT config file. If someone puts a token
+    // field in the config, it should be ignored (security: credential exposure).
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(
+        &config_path,
+        r#"
+api_url = "https://example.com"
+token = "should-be-ignored"
+"#,
+    )
+    .unwrap();
+
+    let config = ClientConfig::from_file(&config_path).unwrap();
+    // Config struct should not have a token() getter or should ignore the field
+    assert!(
+        !format!("{config:?}").contains("should-be-ignored"),
+        "Config must not load/expose token from file — tokens belong in OS keychain"
+    );
+}
+
+#[test]
+fn client_config_rejects_negative_timeout() {
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("cli.toml");
+    std::fs::write(&config_path, r#"timeout = -1"#).unwrap();
+
+    let result = ClientConfig::from_file(&config_path);
+    assert!(
+        result.is_err(),
+        "Negative timeout should be rejected as invalid configuration"
+    );
+}
