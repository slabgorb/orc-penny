+//! Output formatting: Table (comfy-table), JSON (serde_json + metadata), CSV (csv crate).
+
+pub use crate::cli::OutputFormat;
+
+/// Trait for formatting tabular data into different output formats.
+pub trait OutputFormatter {
+    /// Format headers and rows into a string.
+    fn format(&self, headers: &[String], rows: &[Vec<String>]) -> String;
+}
+
+/// Table output using comfy-table with optional ANSI color.
+pub struct TableFormatter {
+    use_color: bool,
+}
+
+impl TableFormatter {
+    pub fn new(use_color: bool) -> Self {
+        Self { use_color }
+    }
+}
+
+impl OutputFormatter for TableFormatter {
+    fn format(&self, headers: &[String], rows: &[Vec<String>]) -> String {
+        use comfy_table::{presets, Table};
+
+        let mut table = Table::new();
+        table.load_preset(presets::UTF8_FULL);
+
+        if !self.use_color {
+            table.force_no_tty();
+        }
+
+        table.set_header(headers);
+        for row in rows {
+            table.add_row(row);
+        }
+
+        table.to_string()
+    }
+}
+
+/// JSON output with response metadata (request_id, timestamp, api_version).
+#[derive(Default)]
+pub struct JsonFormatter;
+
+impl JsonFormatter {
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl OutputFormatter for JsonFormatter {
+    fn format(&self, headers: &[String], rows: &[Vec<String>]) -> String {
+        let data: Vec<serde_json::Value> = rows
+            .iter()
+            .map(|row| {
+                let obj: serde_json::Map<String, serde_json::Value> = headers
+                    .iter()
+                    .zip(row.iter())
+                    .map(|(h, v)| (h.clone(), serde_json::Value::String(v.clone())))
+                    .collect();
+                serde_json::Value::Object(obj)
+            })
+            .collect();
+
+        let output = serde_json::json!({
+            "data": data,
+            "meta": {
+                "request_id": uuid::Uuid::now_v7().to_string(),
+                "timestamp": chrono::Utc::now().to_rfc3339(),
+                "api_version": "v1",
+            }
+        });
+
+        serde_json::to_string_pretty(&output).expect("JSON serialization should not fail")
+    }
+}
+
+/// CSV output with headers and proper escaping via the csv crate.
+#[derive(Default)]
+pub struct CsvFormatter;
+
+impl CsvFormatter {
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl OutputFormatter for CsvFormatter {
+    fn format(&self, headers: &[String], rows: &[Vec<String>]) -> String {
+        let mut wtr = csv::Writer::from_writer(Vec::new());
+        wtr.write_record(headers).expect("CSV header write should not fail");
+        for row in rows {
+            wtr.write_record(row).expect("CSV row write should not fail");
+        }
+        wtr.flush().expect("CSV flush should not fail");
+        String::from_utf8(wtr.into_inner().expect("CSV inner buffer should not fail"))
+            .expect("CSV output should be valid UTF-8")
+    }
+}
