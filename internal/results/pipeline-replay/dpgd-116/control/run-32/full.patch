@@ -0,0 +1,79 @@
+//! CLI argument parsing with clap derive macros.
+
+use clap::{Parser, Subcommand, ValueEnum};
+use std::path::PathBuf;
+
+/// Axiathon SIEM — operator CLI for managing the Axiathon platform.
+///
+/// Commands follow the plural-noun + verb pattern: `axiathon rules list`.
+/// Use `axiathon <command> --help` for detailed usage of each command.
+#[derive(Debug, Parser)]
+#[command(name = "axiathon", version, about, long_about = None)]
+pub struct Cli {
+    /// Output format for tabular data
+    #[arg(long, global = true, value_enum, default_value_t = OutputFormat::Table)]
+    pub format: OutputFormat,
+
+    /// Increase verbosity (-v info, -vv debug, -vvv trace)
+    #[arg(short, long, global = true, action = clap::ArgAction::Count)]
+    pub verbose: u8,
+
+    /// Suppress non-error output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL (overrides config file and AXIATHON_SERVER env var)
+    #[arg(long, global = true, env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Path to config file (default: ~/.config/axiathon/cli.toml)
+    #[arg(long, global = true)]
+    pub config: Option<PathBuf>,
+
+    /// Disable colored output
+    #[arg(long = "no-color", global = true)]
+    pub no_color: bool,
+
+    #[command(subcommand)]
+    pub command: Commands,
+}
+
+/// Output format for tabular data.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq, ValueEnum)]
+pub enum OutputFormat {
+    #[default]
+    Table,
+    Json,
+    Csv,
+}
+
+/// Top-level command groups.
+#[derive(Debug, Subcommand)]
+pub enum Commands {
+    /// Search and analyze security events
+    Query,
+    /// Manage detection rules
+    Rules,
+    /// View and manage security alerts
+    Alerts,
+    /// Control data ingestion pipelines
+    Ingest,
+    /// Manage CLI and server configuration
+    Config,
+    /// View system health and component status
+    Status,
+    /// Manage tenant settings
+    Tenant,
+    /// Authenticate with the Axiathon server
+    Login,
+    /// Generate shell completions
+    Completion,
+    /// First-time setup and configuration
+    Init,
+    /// Launch the terminal UI dashboard
+    Tui,
+}
