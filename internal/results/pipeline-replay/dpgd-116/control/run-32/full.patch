+//! Client configuration loading from TOML with env var overrides.
+
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+use crate::CliError;
+
+/// Raw TOML structure — used internally for deserialization before validation.
+/// Raw TOML structure. Unknown fields (including `token`) are silently ignored
+/// rather than rejected — operators may have stale fields in their config file.
+/// Tokens are NOT loaded from config (security: credentials belong in OS keychain).
+#[derive(Deserialize)]
+struct RawConfig {
+    api_url: Option<String>,
+    timeout: Option<i64>,
+}
+
+/// Client configuration with validated fields.
+///
+/// Precedence: CLI flags > env vars > config file > defaults.
+/// Tokens are NOT stored in config — they belong in the OS keychain.
+///
+/// Implements `Deserialize` via `#[serde(try_from)]` to enforce validation
+/// on deserialization (Rule #8: Deserialize bypass prevention).
+#[derive(Debug)]
+pub struct ClientConfig {
+    api_url: String,
+    timeout_secs: u64,
+}
+
+impl TryFrom<RawConfig> for ClientConfig {
+    type Error = String;
+
+    fn try_from(raw: RawConfig) -> Result<Self, Self::Error> {
+        let defaults = Self::default();
+
+        let api_url = raw.api_url.unwrap_or(defaults.api_url);
+        if api_url.is_empty() {
+            return Err("api_url cannot be empty".into());
+        }
+
+        let timeout_secs = match raw.timeout {
+            Some(t) if t < 0 => return Err(format!("timeout must be non-negative, got {t}")),
+            Some(t) => t as u64,
+            None => defaults.timeout_secs,
+        };
+
+        Ok(Self {
+            api_url,
+            timeout_secs,
+        })
+    }
+}
+
+impl<'de> serde::Deserialize<'de> for ClientConfig {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        let raw = RawConfig::deserialize(deserializer)?;
+        ClientConfig::try_from(raw).map_err(serde::de::Error::custom)
+    }
+}
+
+impl Default for ClientConfig {
+    fn default() -> Self {
+        Self {
+            api_url: "http://localhost:8080".to_string(),
+            timeout_secs: 30,
+        }
+    }
+}
+
+impl ClientConfig {
+    pub fn api_url(&self) -> &str {
+        &self.api_url
+    }
+
+    pub fn timeout_secs(&self) -> u64 {
+        self.timeout_secs
+    }
+
+    /// Default config file path: ~/.config/axiathon/cli.toml (XDG on Linux/macOS).
+    pub fn default_config_path() -> PathBuf {
+        let config_dir = dirs::config_dir().unwrap_or_else(|| PathBuf::from(".config"));
+        config_dir.join("axiathon").join("cli.toml")
+    }
+
+    /// Load config from a TOML file.
+    pub fn from_file(path: impl AsRef<Path>) -> Result<Self, CliError> {
+        Self::from_file_with_env(path, None, None)
+    }
+
+    /// Load config from a TOML file with optional env var overrides.
+    ///
+    /// Parameters:
+    /// - `api_url_env`: value of AXIATHON_API_URL env var (or None)
+    /// - `timeout_env`: value of AXIATHON_TIMEOUT env var (or None)
+    pub fn from_file_with_env(
+        path: impl AsRef<Path>,
+        api_url_env: Option<&str>,
+        timeout_env: Option<&str>,
+    ) -> Result<Self, CliError> {
+        let contents = std::fs::read_to_string(path.as_ref()).map_err(|e| {
+            CliError::Config(format!("failed to read config file: {e}"))
+        })?;
+
+        let raw: RawConfig = toml::from_str(&contents).map_err(|e| {
+            CliError::Config(format!("invalid TOML in config file: {e}"))
+        })?;
+
+        let defaults = Self::default();
+
+        // File values
+        let mut api_url = raw.api_url.unwrap_or(defaults.api_url);
+        let mut timeout_secs = match raw.timeout {
+            Some(t) if t < 0 => {
+                return Err(CliError::Config(format!(
+                    "timeout must be non-negative, got {t}"
+                )));
+            }
+            Some(t) => t as u64,
+            None => defaults.timeout_secs,
+        };
+
+        // Env var overrides (higher precedence than file)
+        if let Some(url) = api_url_env {
+            api_url = url.to_string();
+        }
+        if let Some(t) = timeout_env {
+            timeout_secs = t.parse::<u64>().map_err(|e| {
+                CliError::Config(format!("invalid AXIATHON_TIMEOUT: {e}"))
+            })?;
+        }
+
+        Ok(Self {
+            api_url,
+            timeout_secs,
+        })
+    }
+}
