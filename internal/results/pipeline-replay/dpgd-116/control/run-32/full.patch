@@ -0,0 +1,159 @@
+//! Tests for SiemClient HTTP wrapper (AC-7).
+//!
+//! Verifies:
+//! - SiemClient wraps reqwest::Client
+//! - Injects X-Tenant-ID and Authorization headers
+//! - Maps HTTP status codes to CliError variants
+//! - Security: no header injection, no credential leakage
+
+use axiathon_client::client::SiemClient;
+use axiathon_client::CliError;
+
+// ============================================================
+// AC-7: SiemClient
+// ============================================================
+
+#[test]
+fn siem_client_new_accepts_base_url_and_token() {
+    let client = SiemClient::new("http://localhost:8080", Some("test-token".to_string()));
+    assert_eq!(client.base_url(), "http://localhost:8080");
+}
+
+#[test]
+fn siem_client_new_accepts_none_token() {
+    // Client should work without a token (for unauthenticated endpoints)
+    let client = SiemClient::new("http://localhost:8080", None);
+    assert_eq!(client.base_url(), "http://localhost:8080");
+}
+
+#[test]
+fn siem_client_sets_tenant_header() {
+    let client = SiemClient::new("http://localhost:8080", Some("token".to_string()));
+    let headers = client.build_headers(Some("tenant-123"));
+    assert_eq!(
+        headers.get("X-Tenant-ID").map(|v| v.to_str().unwrap()),
+        Some("tenant-123"),
+        "SiemClient must inject X-Tenant-ID header"
+    );
+}
+
+#[test]
+fn siem_client_sets_authorization_header() {
+    let client = SiemClient::new("http://localhost:8080", Some("my-bearer-token".to_string()));
+    let headers = client.build_headers(None);
+    let auth_value = headers
+        .get("Authorization")
+        .map(|v| v.to_str().unwrap())
+        .unwrap_or("");
+    assert_eq!(
+        auth_value, "Bearer my-bearer-token",
+        "SiemClient must inject Authorization: Bearer <token> header"
+    );
+}
+
+#[test]
+fn siem_client_no_auth_header_when_no_token() {
+    let client = SiemClient::new("http://localhost:8080", None);
+    let headers = client.build_headers(None);
+    assert!(
+        headers.get("Authorization").is_none(),
+        "SiemClient should not inject Authorization header when no token"
+    );
+}
+
+// ============================================================
+// HTTP status code to CliError mapping
+// ============================================================
+
+#[test]
+fn siem_client_maps_401_to_authentication_expired() {
+    let err = SiemClient::map_http_status(401, "Unauthorized");
+    assert!(
+        matches!(err, CliError::AuthenticationExpired(_)),
+        "401 should map to CliError::AuthenticationExpired, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_403_to_unauthorized() {
+    let err = SiemClient::map_http_status(403, "Forbidden");
+    assert!(
+        matches!(err, CliError::Unauthorized(_)),
+        "403 should map to CliError::Unauthorized, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_404_to_not_found() {
+    let err = SiemClient::map_http_status(404, "Not Found");
+    assert!(
+        matches!(err, CliError::NotFound(_)),
+        "404 should map to CliError::NotFound, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_429_to_rate_limited() {
+    let err = SiemClient::map_http_status(429, "Too Many Requests");
+    assert!(
+        matches!(err, CliError::RateLimited(_)),
+        "429 should map to CliError::RateLimited, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_500_to_server_error() {
+    let err = SiemClient::map_http_status(500, "Internal Server Error");
+    assert!(
+        matches!(err, CliError::ServerError(_)),
+        "500 should map to CliError::ServerError, got: {err:?}"
+    );
+}
+
+#[test]
+fn siem_client_maps_503_to_server_error() {
+    let err = SiemClient::map_http_status(503, "Service Unavailable");
+    assert!(
+        matches!(err, CliError::ServerError(_)),
+        "503 should map to CliError::ServerError, got: {err:?}"
+    );
+}
+
+// ============================================================
+// Security: header injection prevention
+// ============================================================
+
+#[test]
+fn siem_client_tenant_header_rejects_newlines() {
+    // CWE-113: HTTP header injection via tenant ID containing CRLF
+    let client = SiemClient::new("http://localhost:8080", Some("token".to_string()));
+    let result = client.try_build_headers(Some("tenant\r\nX-Injected: evil"));
+    assert!(
+        result.is_err(),
+        "SiemClient must reject tenant IDs containing newlines (header injection)"
+    );
+}
+
+#[test]
+fn siem_client_token_rejects_newlines() {
+    // CWE-113: HTTP header injection via bearer token containing CRLF
+    let result = SiemClient::try_new("http://localhost:8080", Some("token\r\nX-Injected: evil".to_string()));
+    assert!(
+        result.is_err(),
+        "SiemClient must reject tokens containing newlines (header injection)"
+    );
+}
+
+// ============================================================
+// SiemClient debug output does not leak credentials
+// ============================================================
+
+#[test]
+fn siem_client_debug_does_not_leak_token() {
+    let client = SiemClient::new("http://localhost:8080", Some("super-secret-token".to_string()));
+    let debug_output = format!("{client:?}");
+    assert!(
+        !debug_output.contains("super-secret-token"),
+        "SiemClient Debug output must not expose the bearer token"
+    );
+}
