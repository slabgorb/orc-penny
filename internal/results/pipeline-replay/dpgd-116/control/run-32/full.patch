+//! Tests for shell completion generation (AC-9).
+//!
+//! Verifies:
+//! - axiathon completion <shell> generates completions for bash/zsh/fish/powershell
+//! - Uses clap_complete::generate()
+//! - Completions are valid (non-empty, contain expected patterns)
+
+use axiathon_client::Cli;
+use clap::CommandFactory;
+use clap_complete::{generate, Shell};
+
+// ============================================================
+// AC-9: Shell completion
+// ============================================================
+
+#[test]
+fn completion_generates_bash() {
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(Shell::Bash, &mut cmd, "axiathon", &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+    assert!(!output.is_empty(), "Bash completion must not be empty");
+    assert!(
+        output.contains("axiathon"),
+        "Bash completion must reference the binary name"
+    );
+}
+
+#[test]
+fn completion_generates_zsh() {
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(Shell::Zsh, &mut cmd, "axiathon", &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+    assert!(!output.is_empty(), "Zsh completion must not be empty");
+}
+
+#[test]
+fn completion_generates_fish() {
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(Shell::Fish, &mut cmd, "axiathon", &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+    assert!(!output.is_empty(), "Fish completion must not be empty");
+}
+
+#[test]
+fn completion_generates_powershell() {
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(Shell::PowerShell, &mut cmd, "axiathon", &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+    assert!(!output.is_empty(), "PowerShell completion must not be empty");
+}
+
+#[test]
+fn completion_bash_contains_subcommands() {
+    let mut cmd = Cli::command();
+    let mut buf = Vec::new();
+    generate(Shell::Bash, &mut cmd, "axiathon", &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+    // Completions should reference at least some of the command groups
+    assert!(
+        output.contains("query") || output.contains("status") || output.contains("rules"),
+        "Bash completion should include subcommand names"
+    );
+}
