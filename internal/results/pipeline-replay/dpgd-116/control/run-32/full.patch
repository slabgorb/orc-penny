+//! Tests for CLI global flags (AC-5).
+//!
+//! Verifies:
+//! - --format table|json|csv flag exists and accepts valid values
+//! - -v is repeatable (-vv for debug)
+//! - --quiet suppresses output
+//! - --server supports AXIATHON_SERVER env var
+//! - --tenant, --config, --no-color flags exist
+//! - All global flags are defined with `global = true`
+
+use axiathon_client::Cli;
+use clap::{CommandFactory, Parser};
+
+// ============================================================
+// AC-5: Global flags
+// ============================================================
+
+#[test]
+fn cli_has_format_flag() {
+    let cmd = Cli::command();
+    let arg = cmd
+        .get_arguments()
+        .find(|a| a.get_id() == "format");
