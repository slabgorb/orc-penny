index 0000000..f5ff168
--- /dev/null
+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,103 @@
+//! SiemClient HTTP wrapper for communicating with axiathon-server.
+
+use reqwest::header::{HeaderMap, HeaderValue};
+
+use crate::CliError;
+
+/// HTTP client wrapper that injects tenant and auth headers on every request.
+///
+/// Wraps `reqwest::Client` and provides header injection, URL construction,
+/// and HTTP status-to-error mapping.
+pub struct SiemClient {
+    base_url: String,
+    token: Option<String>,
+    _http: reqwest::Client,
+}
+
+// Custom Debug to avoid leaking the bearer token in logs/panics.
+impl std::fmt::Debug for SiemClient {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SiemClient")
+            .field("base_url", &self.base_url)
+            .field("token", &self.token.as_ref().map(|_| "[REDACTED]"))
+            .finish()
+    }
+}
+
+impl SiemClient {
+    /// Create a new SiemClient. Panics if the token contains invalid header characters.
+    /// For fallible construction, use `try_new()`.
+    pub fn new(base_url: &str, token: Option<String>) -> Self {
+        Self::try_new(base_url, token).expect("SiemClient::new failed — use try_new for fallible construction")
+    }
+
+    /// Fallible constructor that validates inputs at the trust boundary.
+    pub fn try_new(base_url: &str, token: Option<String>) -> Result<Self, CliError> {
+        if base_url.is_empty() {
+            return Err(CliError::Config("base URL cannot be empty".into()));
+        }
+        if let Some(ref t) = token {
+            if t.contains('\r') || t.contains('\n') {
+                return Err(CliError::Config(
+                    "bearer token contains invalid characters (CWE-113: header injection)".into(),
+                ));
+            }
+            // Validate the token can be used as a header value
+            HeaderValue::from_str(&format!("Bearer {t}")).map_err(|_| {
+                CliError::Config("bearer token contains non-ASCII characters".into())
+            })?;
+        }
+        Ok(Self {
+            base_url: base_url.to_string(),
+            token,
+            _http: reqwest::Client::new(),
+        })
+    }
+
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    /// Build headers for a request. Panics on invalid tenant ID.
+    /// For fallible construction, use `try_build_headers()`.
+    pub fn build_headers(&self, tenant_id: Option<&str>) -> HeaderMap {
+        self.try_build_headers(tenant_id)
+            .expect("build_headers failed — use try_build_headers for fallible construction")
+    }
+
+    /// Build request headers with tenant and auth injection.
+    /// Rejects tenant IDs containing newlines (CWE-113 prevention).
+    pub fn try_build_headers(&self, tenant_id: Option<&str>) -> Result<HeaderMap, CliError> {
+        let mut headers = HeaderMap::new();
+        if let Some(tid) = tenant_id {
+            if tid.contains('\r') || tid.contains('\n') {
+                return Err(CliError::Config(
+                    "tenant ID contains invalid characters (CWE-113: header injection)".into(),
+                ));
+            }
+            let value = HeaderValue::from_str(tid).map_err(|_| {
+                CliError::Config("tenant ID contains non-ASCII characters".into())
+            })?;
+            headers.insert("X-Tenant-ID", value);
+        }
+        if let Some(ref token) = self.token {
+            let value = HeaderValue::from_str(&format!("Bearer {token}")).map_err(|_| {
+                CliError::Config("bearer token cannot be encoded as header value".into())
+            })?;
+            headers.insert("Authorization", value);
+        }
+        Ok(headers)
+    }
+
+    /// Map an HTTP status code to a CliError variant.
+    pub fn map_http_status(status: u16, message: &str) -> CliError {
+        match status {
+            401 => CliError::AuthenticationExpired(message.to_string()),
+            403 => CliError::Unauthorized(message.to_string()),
+            404 => CliError::NotFound(message.to_string()),
+            429 => CliError::RateLimited(message.to_string()),
+            500..=599 => CliError::ServerError(message.to_string()),
+            _ => CliError::General(format!("HTTP {status}: {message}")),
+        }
+    }
+}
