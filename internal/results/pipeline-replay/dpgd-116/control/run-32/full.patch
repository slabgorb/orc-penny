+//! Tests for CLI command structure and help rendering (AC-1, AC-2, AC-6).
+//!
+//! Verifies:
+//! - All required command groups exist in top-level help
+//! - Every subcommand renders help without panic
+//! - Clap derive macros are used (declarative only)
+//! - Plural noun command naming convention
+
+use axiathon_client::Cli;
+use clap::CommandFactory;
+
+// ============================================================
+// AC-1: Top-level command groups
+// ============================================================
+
+#[test]
+fn cli_has_query_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "query"),
+        "CLI must have 'query' command group"
+    );
+}
+
+#[test]
+fn cli_has_rules_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "rules"),
+        "CLI must have 'rules' (plural) command group per architecture doc"
+    );
+}
+
+#[test]
+fn cli_has_alerts_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "alerts"),
+        "CLI must have 'alerts' (plural) command group per architecture doc"
+    );
+}
+
+#[test]
+fn cli_has_ingest_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "ingest"),
+        "CLI must have 'ingest' command group"
+    );
+}
+
+#[test]
+fn cli_has_config_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "config"),
+        "CLI must have 'config' command group"
+    );
+}
+
+#[test]
+fn cli_has_status_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "status"),
+        "CLI must have 'status' command group"
+    );
+}
+
+#[test]
+fn cli_has_tenant_command_group() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "tenant"),
+        "CLI must have 'tenant' command group"
+    );
+}
+
+#[test]
+fn cli_has_login_command() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "login"),
+        "CLI must have 'login' command"
+    );
+}
+
+#[test]
+fn cli_has_completion_command() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "completion"),
+        "CLI must have 'completion' command"
+    );
+}
+
+#[test]
+fn cli_has_init_command() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "init"),
+        "CLI must have 'init' command"
+    );
+}
+
+#[test]
+fn cli_has_tui_command() {
+    let cmd = Cli::command();
+    assert!(
+        cmd.get_subcommands().any(|s| s.get_name() == "tui"),
+        "CLI must have 'tui' command"
+    );
+}
+
+#[test]
+fn cli_does_not_have_server_commands() {
+    // Server commands belong in axiathon-server binary, not axiathon-client
+    let cmd = Cli::command();
+    assert!(
+        !cmd.get_subcommands().any(|s| s.get_name() == "server"),
+        "CLI must NOT have 'server' commands — those belong in axiathon-server binary"
+    );
+}
+
+#[test]
+fn cli_all_required_command_groups_present() {
+    let cmd = Cli::command();
+    let names: Vec<&str> = cmd.get_subcommands().map(clap::Command::get_name).collect();
+    let required = [
+        "query", "rules", "alerts", "ingest", "config", "status", "tenant", "login", "completion",
+        "init",
+    ];
+    for group in &required {
+        assert!(
+            names.contains(group),
+            "Missing required command group '{group}'. Found: {names:?}"
+        );
+    }
+}
+
+// ============================================================
+// AC-2: Subcommand help rendering
+// ============================================================
+
+#[test]
+fn cli_help_renders_without_panic() {
+    let cmd = Cli::command();
+    let mut buf = Vec::new();
+    // render_help should not panic
+    cmd.clone().write_help(&mut buf).unwrap();
+    let help_text = String::from_utf8(buf).unwrap();
+    assert!(!help_text.is_empty(), "Help text should not be empty");
+}
+
+#[test]
+fn cli_each_subcommand_help_renders_without_panic() {
+    let cmd = Cli::command();
+    for sub in cmd.get_subcommands() {
+        let mut buf = Vec::new();
+        sub.clone()
+            .write_help(&mut buf)
+            .unwrap_or_else(|e| panic!("Help for '{}' failed: {e}", sub.get_name()));
+        let help_text = String::from_utf8(buf).unwrap();
+        assert!(
+            !help_text.is_empty(),
+            "Help for '{}' should not be empty",
+            sub.get_name()
+        );
+    }
+}
+
+#[test]
+fn cli_subcommands_have_about_text() {
+    let cmd = Cli::command();
+    for sub in cmd.get_subcommands() {
+        let name = sub.get_name();
+        // Skip built-in help subcommand
+        if name == "help" {
+            continue;
+        }
+        assert!(
+            sub.get_about().is_some() || sub.get_long_about().is_some(),
+            "Command '{name}' must have about/long_about text for user-facing help"
+        );
+    }
+}
+
+// ============================================================
+// AC-6: Clap declarative (derive macros only)
+// ============================================================
+
+#[test]
+fn cli_uses_derive_macros() {
+    // If Cli implements CommandFactory (from #[derive(Parser)]), this compiles.
+    // This is a compile-time assertion — if Cli doesn't use derive macros,
+    // the import at the top of this file would fail.
+    let cmd = Cli::command();
+    assert!(
+        !cmd.get_name().is_empty(),
+        "CLI must have a name (derived from Parser)"
+    );
+}
+
+// ============================================================
+// Command naming convention: plural nouns
+// ============================================================
+
+#[test]
+fn cli_uses_plural_noun_command_names() {
+    // Architecture doc mandates plural nouns: "rules" not "rule", "alerts" not "alert"
+    let cmd = Cli::command();
+    let names: Vec<&str> = cmd.get_subcommands().map(clap::Command::get_name).collect();
+    assert!(
+        !names.contains(&"rule"),
+        "Command should be 'rules' (plural), not 'rule'"
+    );
+    assert!(
+        !names.contains(&"alert"),
+        "Command should be 'alerts' (plural), not 'alert'"
+    );
+}
