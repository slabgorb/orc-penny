@@ -0,0 +1,131 @@
+//! Tests for CLI exit codes (AC-3).
+//!
+//! Verifies:
+//! - CliError enum has exit_code() method
+//! - Exit code mapping: 0=success, 1=error, 2=usage, 3=auth, 4=authz
+//! - Errors print to stderr, normal output to stdout
+
+use axiathon_client::CliError;
+
+// ============================================================
+// AC-3: Exit codes
+// ============================================================
+
+#[test]
+fn cli_error_general_exit_code_is_1() {
+    let err = CliError::General("something failed".to_string());
+    assert_eq!(err.exit_code(), 1, "General errors should exit with code 1");
+}
+
+#[test]
+fn cli_error_authentication_expired_exit_code_is_3() {
+    let err = CliError::AuthenticationExpired("token expired".to_string());
+    assert_eq!(
+        err.exit_code(),
+        3,
+        "AuthenticationExpired should exit with code 3"
+    );
+}
+
+#[test]
+fn cli_error_unauthorized_exit_code_is_4() {
+    let err = CliError::Unauthorized("forbidden".to_string());
+    assert_eq!(
+        err.exit_code(),
+        4,
+        "Unauthorized/authz failure should exit with code 4"
+    );
+}
+
+#[test]
+fn cli_error_not_found_exit_code_is_1() {
+    let err = CliError::NotFound("resource missing".to_string());
+    assert_eq!(err.exit_code(), 1, "NotFound should exit with code 1");
+}
+
+#[test]
+fn cli_error_rate_limited_exit_code_is_1() {
+    let err = CliError::RateLimited("too many requests".to_string());
+    assert_eq!(err.exit_code(), 1, "RateLimited should exit with code 1");
+}
+
+#[test]
+fn cli_error_server_error_exit_code_is_1() {
+    let err = CliError::ServerError("internal server error".to_string());
+    assert_eq!(err.exit_code(), 1, "ServerError should exit with code 1");
+}
+
+#[test]
+fn cli_error_connection_timeout_exit_code_is_1() {
+    let err = CliError::ConnectionTimeout("timed out".to_string());
+    assert_eq!(err.exit_code(), 1, "ConnectionTimeout should exit with code 1");
+}
+
+#[test]
+fn cli_error_server_unavailable_exit_code_is_1() {
+    let err = CliError::ServerUnavailable("connection refused".to_string());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "ServerUnavailable should exit with code 1"
+    );
+}
+
+#[test]
+fn cli_error_config_exit_code_is_1() {
+    let err = CliError::Config("bad config".to_string());
+    assert_eq!(err.exit_code(), 1, "Config error should exit with code 1");
+}
+
+// ============================================================
+// CliError trait implementations
+// ============================================================
+
+#[test]
+fn cli_error_implements_std_error() {
+    fn assert_error<T: std::error::Error>() {}
+    assert_error::<CliError>();
+}
+
+#[test]
+fn cli_error_implements_display() {
+    let err = CliError::General("test message".to_string());
+    let msg = err.to_string();
+    assert!(
+        !msg.is_empty(),
+        "CliError Display must produce a non-empty message"
+    );
+}
+
+#[test]
+fn cli_error_display_does_not_leak_internal_details_for_server_error() {
+    // CWE-209: server error details should not be exposed to the user
+    let err = CliError::ServerError("Internal: database connection pool exhausted at 10.0.0.1:5432".to_string());
+    let msg = err.to_string();
+    assert!(!msg.is_empty());
+    // The display should include the user-facing context
+    assert!(
+        msg.contains("server") || msg.contains("Server"),
+        "Server error display should mention 'server', got: {msg}"
+    );
+}
+
+// ============================================================
+// CliError is non-exhaustive
+// ============================================================
+
+#[test]
+fn cli_error_is_non_exhaustive() {
+    // This test verifies that CliError can be matched with a wildcard arm,
+    // which is required if #[non_exhaustive] is set. If non_exhaustive is removed,
+    // the wildcard arm becomes unnecessary and clippy will flag it — but the test
+    // itself would still pass. The real enforcement is the lang-review checklist.
+    let err = CliError::General("test".to_string());
+    let code = match err {
+        CliError::General(_) => 1,
+        CliError::AuthenticationExpired(_) => 3,
+        CliError::Unauthorized(_) => 4,
+        _ => 99, // Required if #[non_exhaustive] — future variants handled
+    };
+    assert_eq!(code, 1);
+}
