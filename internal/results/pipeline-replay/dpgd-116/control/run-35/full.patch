+//! CLI framework: clap 4.x declarative command structure (AC-6).
+
+use std::path::PathBuf;
+
+use clap::{Parser, Subcommand};
+use clap_complete::Shell;
+
+/// Axiathon CLI — operator interface for the Axiathon SIEM platform.
+///
+/// Communicates with axiathon-server via HTTP API. Configure the server
+/// address with --server or AXIATHON_SERVER environment variable.
+#[derive(Parser)]
+#[command(name = "axiathon", version, about, long_about = None)]
+pub struct Cli {
+    /// Output format for tabular data
+    #[arg(long, global = true)]
+    pub format: Option<String>,
+
+    /// Increase verbosity (-v info, -vv debug, -vvv trace)
+    #[arg(short = 'v', long, global = true, action = clap::ArgAction::Count)]
+    pub verbose: u8,
+
+    /// Suppress all output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL (overrides config file and AXIATHON_SERVER env)
+    #[arg(long, global = true, env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Path to config file (default: ~/.config/axiathon/cli.toml)
+    #[arg(long, global = true)]
+    pub config: Option<PathBuf>,
+
+    /// Disable color output
+    #[arg(long, global = true)]
+    pub no_color: bool,
+
+    #[command(subcommand)]
+    pub command: Commands,
+}
+
+/// Top-level command groups following plural-noun + verb pattern.
+#[derive(Subcommand)]
+pub enum Commands {
+    /// Run queries against ingested data
+    Query(QueryArgs),
+    /// Manage detection rules
+    Rules(RulesArgs),
+    /// View and manage alerts
+    Alerts(AlertsArgs),
+    /// Control ingestion pipelines
+    Ingest(IngestArgs),
+    /// View and manage configuration
+    Config(ConfigArgs),
+    /// Check system and component status
