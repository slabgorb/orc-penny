+//! First-time setup (AC-1).
+
+use crate::error::CliError;
+
+/// Run first-time setup: create config directory and default config file.
+pub fn run_init() -> Result<(), CliError> {
+    let config_path = crate::config::ClientConfig::default_config_path();
+    if let Some(parent) = config_path.parent() {
+        std::fs::create_dir_all(parent)
+            .map_err(|e| CliError::Config(format!("failed to create config directory: {e}")))?;
+    }
+    eprintln!("Axiathon CLI initialized. Config: {}", config_path.display());
+    Ok(())
+}
