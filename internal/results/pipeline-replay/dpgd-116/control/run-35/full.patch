@@ -0,0 +1,57 @@
+//! CLI error types with structured exit code mapping.
+
+use thiserror::Error;
+
+/// CLI error enum mapping domain errors to operator-facing messages and exit codes.
+///
+/// **SECURITY:** `ServerError` Display intentionally omits the response body to prevent
+/// CWE-209 (Generation of Error Message Containing Sensitive Information). Internal
+/// server details are for logs, not end users.
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum CliError {
+    #[error("error: {0}")]
+    General(String),
+
+    #[error("authentication expired — run `axiathon login` to re-authenticate")]
+    AuthenticationExpired,
+
+    #[error("unauthorized: {0}")]
+    Unauthorized(String),
+
+    #[error("not found: {0}")]
+    NotFound(String),
+
+    /// **SECURITY:** Display shows only HTTP status code, not the response body.
+    /// The body may contain internal error details (connection strings, stack traces).
+    /// CWE-209: Generation of Error Message Containing Sensitive Information.
+    #[error("server error (HTTP {0})")]
+    ServerError(u16, String),
+
+    #[error("connection timed out — check server address and network")]
+    ConnectionTimeout,
+
+    #[error("server unavailable — check that axiathon-server is running")]
+    ServerUnavailable,
+
+    #[error("rate limited — wait and retry")]
+    RateLimited,
+
+    #[error("config error: {0}")]
+    Config(String),
+
+    #[error("not yet implemented (Story {0})")]
+    NotImplemented(String),
+}
+
+impl CliError {
+    /// Map error to process exit code.
+    /// 0=success, 1=error, 2=usage (clap), 3=auth failure, 4=authz failure.
+    pub fn exit_code(&self) -> i32 {
+        match self {
+            Self::AuthenticationExpired => 3,
+            Self::Unauthorized(_) => 4,
+            _ => 1,
+        }
+    }
+}
