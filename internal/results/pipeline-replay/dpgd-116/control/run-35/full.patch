@@ -0,0 +1,190 @@
+//! Integration tests for output formatting (Story 6.1).
+//!
+//! Covers:
+//! - AC-4: Output format (table/json/csv)
+//! - OutputFormatter trait with Table/JSON/CSV implementations
+//! - JSON ResponseMetadata (request_id, timestamp, api_version)
+//! - CSV header escaping
+//! - TTY auto-detection behavior
+
+use axiathon_client::output::{OutputFormat, OutputFormatter};
+
+// ============================================================
+// AC-4: OutputFormatter trait exists and has implementations
+// ============================================================
+
+#[test]
+fn output_format_table_variant_exists() {
+    let fmt = OutputFormat::Table;
+    assert!(matches!(fmt, OutputFormat::Table));
+}
+
+#[test]
+fn output_format_json_variant_exists() {
+    let fmt = OutputFormat::Json;
+    assert!(matches!(fmt, OutputFormat::Json));
+}
+
+#[test]
+fn output_format_csv_variant_exists() {
+    let fmt = OutputFormat::Csv;
+    assert!(matches!(fmt, OutputFormat::Csv));
+}
+
+#[test]
+fn output_format_from_str_table() {
+    let fmt: OutputFormat = "table".parse().expect("should parse 'table'");
+    assert!(matches!(fmt, OutputFormat::Table));
+}
+
+#[test]
+fn output_format_from_str_json() {
+    let fmt: OutputFormat = "json".parse().expect("should parse 'json'");
+    assert!(matches!(fmt, OutputFormat::Json));
+}
+
+#[test]
+fn output_format_from_str_csv() {
+    let fmt: OutputFormat = "csv".parse().expect("should parse 'csv'");
+    assert!(matches!(fmt, OutputFormat::Csv));
+}
+
+#[test]
+fn output_format_from_str_invalid_returns_err() {
+    let result = "xml".parse::<OutputFormat>();
+    assert!(result.is_err(), "Unsupported format 'xml' should return Err");
+}
+
+// ============================================================
+// OutputFormatter trait contract
+// ============================================================
+
+/// OutputFormatter must be object-safe (usable as dyn trait).
+/// Compile-time assertion: the function signature enforces object safety.
+#[test]
+fn output_formatter_is_object_safe() {
+    #[allow(dead_code)]
+    fn assert_object_safe(_: &dyn OutputFormatter) {}
+}
+
+// ============================================================
+// JSON output includes ResponseMetadata
+// ============================================================
+
+#[test]
+fn json_output_includes_request_id() {
+    use axiathon_client::output::ResponseMetadata;
+    let meta = ResponseMetadata::new();
+    assert!(
+        !meta.request_id.is_empty(),
+        "ResponseMetadata must generate a non-empty request_id"
+    );
+}
+
+#[test]
+fn json_output_includes_timestamp() {
+    use axiathon_client::output::ResponseMetadata;
+    let meta = ResponseMetadata::new();
+    assert!(
+        !meta.timestamp.is_empty(),
+        "ResponseMetadata must generate a non-empty timestamp"
+    );
+}
+
+#[test]
+fn json_output_includes_api_version() {
+    use axiathon_client::output::ResponseMetadata;
+    let meta = ResponseMetadata::new();
+    assert!(
+        !meta.api_version.is_empty(),
+        "ResponseMetadata must include api_version"
+    );
+}
+
+#[test]
+fn response_metadata_serializes_to_json() {
+    use axiathon_client::output::ResponseMetadata;
+    let meta = ResponseMetadata::new();
+    let json = serde_json::to_value(&meta).expect("ResponseMetadata should serialize");
+    assert!(json.get("request_id").is_some(), "JSON must have request_id");
+    assert!(json.get("timestamp").is_some(), "JSON must have timestamp");
+    assert!(
+        json.get("api_version").is_some(),
+        "JSON must have api_version"
+    );
+}
+
+// ============================================================
+// Table output uses comfy-table
+// ============================================================
+
+/// Table formatter should produce non-empty output for non-empty data
+#[test]
+fn table_formatter_produces_output() {
+    use axiathon_client::output::TableFormatter;
+
+    let formatter = TableFormatter::new();
+    let headers = vec!["Name".to_string(), "Status".to_string()];
+    let rows = vec![vec!["test".to_string(), "ok".to_string()]];
+    let output = formatter.format_rows(&headers, &rows);
+    assert!(
+        !output.is_empty(),
+        "Table formatter should produce non-empty output"
+    );
+    assert!(
+        output.contains("Name"),
+        "Table output should contain column headers"
+    );
+    assert!(
+        output.contains("test"),
+        "Table output should contain row data"
+    );
+}
+
+// ============================================================
+// CSV output uses csv crate with proper escaping
+// ============================================================
+
+#[test]
+fn csv_formatter_includes_headers() {
+    use axiathon_client::output::CsvFormatter;
+
+    let formatter = CsvFormatter::new();
+    let headers = vec!["Name".to_string(), "Value".to_string()];
+    let rows = vec![vec!["test".to_string(), "123".to_string()]];
+    let output = formatter.format_rows(&headers, &rows);
+    assert!(
+        output.starts_with("Name,") || output.starts_with("Name\t") || output.starts_with("\"Name\""),
+        "CSV output must start with headers, got: {output}"
+    );
+}
+
+#[test]
+fn csv_formatter_escapes_commas_in_values() {
+    use axiathon_client::output::CsvFormatter;
+
+    let formatter = CsvFormatter::new();
+    let headers = vec!["Description".to_string()];
+    let rows = vec![vec!["value, with comma".to_string()]];
+    let output = formatter.format_rows(&headers, &rows);
+    // CSV spec requires quoting values that contain commas
+    assert!(
+        output.contains("\"value, with comma\""),
+        "CSV must quote values containing commas, got: {output}"
+    );
+}
+
+#[test]
+fn csv_formatter_escapes_quotes_in_values() {
+    use axiathon_client::output::CsvFormatter;
+
+    let formatter = CsvFormatter::new();
+    let headers = vec!["Data".to_string()];
+    let rows = vec![vec!["say \"hello\"".to_string()]];
+    let output = formatter.format_rows(&headers, &rows);
+    // CSV spec requires doubling quotes inside quoted fields
+    assert!(
+        output.contains("\"\"hello\"\"") || output.contains("\"say \"\"hello\"\"\""),
+        "CSV must escape embedded quotes, got: {output}"
+    );
+}
