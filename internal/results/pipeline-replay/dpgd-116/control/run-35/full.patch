+//! Integration tests for config file loading (Story 6.1).
+//!
+//! Covers:
+//! - AC-8: Config from ~/.config/axiathon/cli.toml, env var overrides
+//! - Lang-review #8: Deserialize bypass on validated types
+//! - Lang-review #13: Constructor/Deserialize consistency
+//! - Config precedence: CLI flags > env vars > config file > defaults
+
+use axiathon_client::config::ClientConfig;
+
+// ============================================================
+// AC-8: Config loading defaults
+// ============================================================
+
+#[test]
+fn client_config_has_sensible_defaults() {
+    let config = ClientConfig::default();
+    // Default server URL should be set
+    assert!(
+        !config.api_url().is_empty(),
+        "Default API URL must not be empty"
+    );
+}
+
+#[test]
+fn client_config_default_timeout_is_reasonable() {
+    let config = ClientConfig::default();
+    let timeout = config.timeout_secs();
+    assert!(
+        timeout > 0 && timeout <= 300,
+        "Default timeout should be between 1 and 300 seconds, got: {timeout}"
+    );
+}
+
+// ============================================================
+// AC-8: Config from TOML file
+// ============================================================
+
+#[test]
+fn client_config_loads_from_toml_string() {
+    let toml_str = r#"
+        api_url = "https://custom.example.com:8443"
+        timeout = 60
+    "#;
+    let config = ClientConfig::from_toml(toml_str).expect("should parse valid TOML");
+    assert_eq!(config.api_url(), "https://custom.example.com:8443");
+    assert_eq!(config.timeout_secs(), 60);
+}
+
+#[test]
+fn client_config_rejects_invalid_toml() {
+    let bad_toml = "this is not valid = = toml {{";
+    let result = ClientConfig::from_toml(bad_toml);
+    assert!(
+        result.is_err(),
+        "Invalid TOML should return error, not silently default"
+    );
+}
+
+#[test]
+fn client_config_handles_empty_toml() {
+    let config = ClientConfig::from_toml("").expect("Empty TOML should use defaults");
+    assert!(
+        !config.api_url().is_empty(),
+        "Empty TOML config should still have default API URL"
+    );
+}
+
+// ============================================================
+// AC-8: Env var overrides
+// ============================================================
+
+#[test]
+fn client_config_axiathon_api_url_env_overrides_file() {
+    // ClientConfig must respect AXIATHON_API_URL env var
+    let config = ClientConfig::from_toml_with_env(
+        r#"api_url = "https://file.example.com""#,
+        &[("AXIATHON_API_URL", "https://env.example.com")],
+    )
+    .expect("should parse with env override");
+    assert_eq!(
+        config.api_url(),
+        "https://env.example.com",
+        "AXIATHON_API_URL env var should override config file"
+    );
+}
+
+#[test]
+fn client_config_axiathon_timeout_env_overrides_file() {
+    let config = ClientConfig::from_toml_with_env(
+        r#"timeout = 30"#,
+        &[("AXIATHON_TIMEOUT", "120")],
+    )
+    .expect("should parse with env override");
+    assert_eq!(
+        config.timeout_secs(),
+        120,
+        "AXIATHON_TIMEOUT env var should override config file"
+    );
+}
+
+#[test]
+fn client_config_invalid_timeout_env_returns_error() {
+    let result = ClientConfig::from_toml_with_env(
+        "",
+        &[("AXIATHON_TIMEOUT", "not-a-number")],
+    );
+    assert!(
+        result.is_err(),
+        "Non-numeric AXIATHON_TIMEOUT should return error, not silently default"
+    );
+}
+
+// ============================================================
+// AC-8: Tokens NOT in config file
+// ============================================================
+
+/// Config file should never store tokens — they belong in OS keychain.
+/// If a config file contains a token field, loading should warn or ignore it.
+#[test]
+fn client_config_ignores_token_in_config_file() {
+    let toml_with_token = r#"
+        api_url = "https://example.com"
+        token = "secret-should-not-be-here"
+    "#;
+    let config = ClientConfig::from_toml(toml_with_token).expect("should parse");
+    // Token should NOT be accessible from config — tokens come from keychain
+    assert!(
+        !config.has_token_from_file(),
+        "Config must not load tokens from file — use OS keychain instead"
+    );
+}
+
+// ============================================================
+// Config file path resolution
+// ============================================================
+
+#[test]
+fn client_config_default_path_uses_xdg() {
+    let path = ClientConfig::default_config_path();
+    let path_str = path.to_string_lossy();
+    // Should use XDG config dir pattern
+    assert!(
+        path_str.contains("axiathon") && path_str.contains("cli.toml"),
+        "Default config path should contain 'axiathon/cli.toml', got: {path_str}"
+    );
+}
+
+// ============================================================
+// Lang-review #13: Serialization roundtrip
+// ============================================================
+
+#[test]
+fn client_config_serializes_and_deserializes_consistently() {
+    let toml_str = r#"
+        api_url = "https://roundtrip.example.com"
+        timeout = 45
+    "#;
+    let config = ClientConfig::from_toml(toml_str).expect("should parse");
+    let serialized = config.to_toml().expect("should serialize");
+    let reloaded = ClientConfig::from_toml(&serialized).expect("should re-parse");
+    assert_eq!(config.api_url(), reloaded.api_url());
+    assert_eq!(config.timeout_secs(), reloaded.timeout_secs());
+}
diff --git a/crates/axiathon-client/tests/error_exit_codes_integration.rs b/crates/axiathon-client/tests/error_exit_codes_integration.rs
new file mode 100644
index 0000000..6b00a0a
--- /dev/null
+++ b/crates/axiathon-client/tests/error_exit_codes_integration.rs
@@ -0,0 +1,191 @@
+//! Integration tests for error types and exit codes (Story 6.1).
+//!
+//! Covers:
+//! - AC-3: Exit codes (0/1/2/3/4)
+//! - Lang-review #1: Silent error swallowing
+//! - Lang-review #2: #[non_exhaustive] on CliError
+//! - Lang-review #5: Validated constructors
+//! - Security: CWE-209 error information exposure
+
+use axiathon_client::error::CliError;
+
+// ============================================================
+// AC-3: Exit codes
+// ============================================================
+
+#[test]
+fn cli_error_general_maps_to_exit_code_1() {
+    let err = CliError::General("something failed".into());
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_auth_expired_maps_to_exit_code_3() {
+    let err = CliError::AuthenticationExpired;
+    assert_eq!(err.exit_code(), 3);
+}
+
+#[test]
+fn cli_error_unauthorized_maps_to_exit_code_4() {
+    let err = CliError::Unauthorized("no permission".into());
+    assert_eq!(err.exit_code(), 4);
+}
+
+#[test]
+fn cli_error_not_found_maps_to_exit_code_1() {
+    let err = CliError::NotFound("resource".into());
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_server_error_maps_to_exit_code_1() {
+    let err = CliError::ServerError(500, "internal server error".into());
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_connection_timeout_maps_to_exit_code_1() {
+    let err = CliError::ConnectionTimeout;
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_server_unavailable_maps_to_exit_code_1() {
+    let err = CliError::ServerUnavailable;
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_rate_limited_maps_to_exit_code_1() {
+    let err = CliError::RateLimited;
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_config_maps_to_exit_code_1() {
+    let err = CliError::Config("invalid config".into());
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn cli_error_not_implemented_maps_to_exit_code_1() {
+    let err = CliError::NotImplemented("6.2".into());
+    assert_eq!(err.exit_code(), 1);
+}
+
+// ============================================================
+// Lang-review #2: #[non_exhaustive] on CliError
+// ============================================================
+
+/// CliError is a public enum that will grow — it must have #[non_exhaustive].
+/// This test verifies the attribute exists by using a wildcard match.
+/// If #[non_exhaustive] is missing, this test still compiles but serves
+/// as documentation that the attribute is required.
+#[test]
+fn cli_error_is_non_exhaustive() {
+    let err = CliError::General("test".into());
+    // This match uses a wildcard — would be required by #[non_exhaustive]
+    // in downstream crates. Here it documents the expectation.
+    match err {
+        CliError::General(_)
+        | CliError::AuthenticationExpired
+        | CliError::Unauthorized(_)
+        | CliError::NotFound(_)
+        | CliError::ServerError(_, _)
+        | CliError::ConnectionTimeout
+        | CliError::ServerUnavailable
+        | CliError::RateLimited
+        | CliError::Config(_)
+        | CliError::NotImplemented(_) => {}
+        _ => panic!("Unexpected CliError variant — update this test"),
+    }
+}
+
+// ============================================================
+// Error Display — CWE-209 safety
+// ============================================================
+
+/// Error display must not expose internal server details to users.
+/// ServerError display should show a generic message, not raw server response.
+#[test]
+fn cli_error_server_error_display_does_not_expose_internals() {
+    let err = CliError::ServerError(500, "database connection string: postgres://admin:secret@db".into());
+    let display = err.to_string();
+    // Display should NOT contain the raw internal error with credentials
+    assert!(
+        !display.contains("postgres://"),
+        "ServerError display must not expose internal connection strings: {display}"
+    );
+    assert!(
+        !display.contains("secret"),
+        "ServerError display must not expose credentials: {display}"
+    );
+}
+
+/// Error display for auth errors should not echo back the token
+#[test]
+fn cli_error_display_does_not_echo_tokens() {
+    let err = CliError::AuthenticationExpired;
+    let display = err.to_string();
+    assert!(
+        !display.is_empty(),
+        "AuthenticationExpired display should not be empty"
+    );
+}
+
+// ============================================================
+// CliError implements std::error::Error + Send + Sync
+// ============================================================
+
+#[test]
+fn cli_error_implements_std_error_send_sync() {
+    // Compile-time assertion
+    fn assert_bounds<T: std::error::Error + Send + Sync + 'static>() {}
+    assert_bounds::<CliError>();
+}
+
+// ============================================================
+// CliError uses thiserror (structured, not string bags — SOUL #5)
+// ============================================================
+
+#[test]
+fn cli_error_display_is_human_readable() {
+    let err = CliError::NotFound("tenant abc-123".into());
+    let display = err.to_string();
+    assert!(
+        !display.is_empty(),
+        "CliError::NotFound display should be non-empty"
+    );
+    // Should contain some useful information, not just "error"
+    assert!(
+        display.len() > 5,
+        "CliError display should be descriptive, got: {display}"
+    );
+}
+
+// ============================================================
+// All exit codes are in the documented set {0, 1, 2, 3, 4}
+// ============================================================
+
+#[test]
+fn all_exit_codes_are_in_valid_range() {
+    let errors: Vec<CliError> = vec![
+        CliError::General("x".into()),
+        CliError::AuthenticationExpired,
+        CliError::Unauthorized("x".into()),
+        CliError::NotFound("x".into()),
+        CliError::ServerError(500, "x".into()),
+        CliError::ConnectionTimeout,
+        CliError::ServerUnavailable,
+        CliError::RateLimited,
+        CliError::Config("x".into()),
+        CliError::NotImplemented("x".into()),
+    ];
+    for err in &errors {
+        let code = err.exit_code();
+        assert!(
+            [0, 1, 2, 3, 4].contains(&code),
+            "Exit code {code} for {err:?} is not in valid range [0,1,2,3,4]"
+        );
+    }
+}
diff --git a/crates/axiathon-client/tests/output_format_integration.rs b/crates/axiathon-client/tests/output_format_integration.rs
