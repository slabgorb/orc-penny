+//! Client configuration loading (AC-8).
+//!
+//! Config from ~/.config/axiathon/cli.toml with env var overrides.
+//! Tokens are never stored in config files — they come from OS keychain.
+
+use std::path::PathBuf;
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::CliError;
+
+/// Client configuration. Loaded from TOML with env var overrides.
+/// Tokens are intentionally excluded — they belong in OS keychain, not files.
+#[derive(Debug, Serialize, Deserialize)]
+pub struct ClientConfig {
+    #[serde(default = "default_api_url")]
+    api_url: String,
+
+    #[serde(default = "default_timeout")]
+    timeout: u64,
+}
+
+fn default_api_url() -> String {
+    "http://localhost:8080".to_string()
+}
+
+fn default_timeout() -> u64 {
+    30
+}
+
+impl Default for ClientConfig {
+    fn default() -> Self {
+        Self {
+            api_url: default_api_url(),
+            timeout: default_timeout(),
+        }
+    }
+}
+
+impl ClientConfig {
+    pub fn api_url(&self) -> &str {
+        &self.api_url
+    }
+
+    pub fn timeout_secs(&self) -> u64 {
+        self.timeout
+    }
+
+    /// Tokens are never loaded from config files — always returns false.
+    /// Tokens come from OS keychain or AXIATHON_API_TOKEN env var.
+    pub fn has_token_from_file(&self) -> bool {
+        false
+    }
+
+    /// Default config file path using XDG base directories.
+    pub fn default_config_path() -> PathBuf {
+        dirs::config_dir()
+            .unwrap_or_else(|| PathBuf::from(".config"))
+            .join("axiathon")
+            .join("cli.toml")
+    }
+
+    /// Parse config from a TOML string. Missing fields use defaults.
+    pub fn from_toml(toml_str: &str) -> Result<Self, CliError> {
+        toml::from_str(toml_str).map_err(|e| CliError::Config(e.to_string()))
+    }
+
+    /// Parse config from TOML with explicit env var overrides.
+    /// Env vars take precedence over file values (AC-8).
+    pub fn from_toml_with_env(
+        toml_str: &str,
+        env: &[(&str, &str)],
+    ) -> Result<Self, CliError> {
+        let mut config = Self::from_toml(toml_str)?;
+
+        for &(key, value) in env {
+            match key {
+                "AXIATHON_API_URL" => {
+                    config.api_url = value.to_string();
+                }
+                "AXIATHON_TIMEOUT" => {
+                    config.timeout = value.parse().map_err(|_| {
+                        CliError::Config(format!(
+                            "AXIATHON_TIMEOUT must be a valid integer, got: {value}"
+                        ))
+                    })?;
+                }
+                _ => {}
+            }
+        }
+
+        Ok(config)
+    }
+
+    /// Serialize config to TOML string.
+    pub fn to_toml(&self) -> Result<String, CliError> {
+        toml::to_string(self).map_err(|e| CliError::Config(e.to_string()))
+    }
+}
