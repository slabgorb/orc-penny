+//! Output formatting: table, JSON, CSV (AC-4).
+
+use serde::Serialize;
+
+/// Output format selection.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum OutputFormat {
+    Table,
+    Json,
+    Csv,
+}
+
+impl OutputFormat {
+    pub fn as_str(&self) -> &str {
+        match self {
+            Self::Table => "table",
+            Self::Json => "json",
+            Self::Csv => "csv",
+        }
+    }
+}
+
+impl std::str::FromStr for OutputFormat {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "table" => Ok(Self::Table),
+            "json" => Ok(Self::Json),
+            "csv" => Ok(Self::Csv),
+            other => Err(format!("unsupported output format: {other}")),
+        }
+    }
+}
+
+/// Trait for formatting tabular output. Object-safe for dynamic dispatch.
+pub trait OutputFormatter {
+    fn format_rows(&self, headers: &[String], rows: &[Vec<String>]) -> String;
+}
+
+/// JSON response metadata included with all JSON output (AC-4).
+#[derive(Debug, Clone, Serialize)]
+pub struct ResponseMetadata {
+    pub request_id: String,
+    pub timestamp: String,
+    pub api_version: String,
+}
+
+impl ResponseMetadata {
+    pub fn new() -> Self {
+        Self {
+            request_id: uuid::Uuid::new_v4().to_string(),
+            timestamp: chrono::Utc::now().to_rfc3339(),
+            api_version: "v1".to_string(),
+        }
+    }
+}
+
+impl Default for ResponseMetadata {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Table formatter using comfy-table for terminal-width-aware display.
+pub struct TableFormatter;
+
+impl TableFormatter {
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl Default for TableFormatter {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl OutputFormatter for TableFormatter {
+    fn format_rows(&self, headers: &[String], rows: &[Vec<String>]) -> String {
+        let mut table = comfy_table::Table::new();
+        table.set_header(headers);
+        for row in rows {
+            table.add_row(row);
+        }
+        table.to_string()
+    }
+}
+
+/// CSV formatter using the csv crate for RFC 4180-compliant output.
+pub struct CsvFormatter;
+
+impl CsvFormatter {
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl Default for CsvFormatter {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl OutputFormatter for CsvFormatter {
+    fn format_rows(&self, headers: &[String], rows: &[Vec<String>]) -> String {
+        let mut wtr = csv::Writer::from_writer(Vec::new());
+        // csv crate handles quoting/escaping per RFC 4180
+        wtr.write_record(headers)
+            .expect("CSV header write should not fail on Vec");
+        for row in rows {
+            wtr.write_record(row)
+                .expect("CSV row write should not fail on Vec");
+        }
+        wtr.flush().expect("CSV flush should not fail on Vec");
+        String::from_utf8(wtr.into_inner().expect("CSV into_inner should not fail on Vec"))
+            .expect("CSV output should be valid UTF-8")
+    }
+}
