+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,90 @@
+//! SiemClient HTTP wrapper (AC-7).
+//!
+//! Wraps HTTP communication with the axiathon-server API. Injects
+//! X-Tenant-ID and Authorization headers. Maps HTTP status codes to
+//! CliError variants.
+
+use http::header::HeaderMap;
+use http::HeaderValue;
+
+use axiathon_core::TenantId;
+
+use crate::error::CliError;
+
+/// HTTP client wrapper for axiathon-server API communication.
+/// Fields are private to enforce builder-pattern construction.
+pub struct SiemClient {
+    base_url: String,
+    token: Option<String>,
+    tenant: Option<TenantId>,
+}
+
+impl SiemClient {
+    pub fn new(base_url: impl Into<String>) -> Self {
+        Self {
+            base_url: base_url.into(),
+            token: None,
+            tenant: None,
+        }
+    }
+
+    pub fn with_token(mut self, token: impl Into<String>) -> Self {
+        self.token = Some(token.into());
+        self
+    }
+
+    pub fn with_tenant(mut self, tenant: TenantId) -> Self {
+        self.tenant = Some(tenant);
+        self
+    }
+
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    pub fn has_token(&self) -> bool {
+        self.token.is_some()
+    }
+
+    pub fn has_tenant(&self) -> bool {
+        self.tenant.is_some()
+    }
+
+    /// Build HTTP headers for a request. Injects tenant and auth headers
+    /// when configured.
+    ///
+    /// Returns Err if header values contain invalid characters (CWE-113
+    /// header injection prevention).
+    pub fn build_headers(&self) -> Result<HeaderMap, CliError> {
+        let mut headers = HeaderMap::new();
+
+        if let Some(tenant) = &self.tenant {
+            let value = HeaderValue::from_str(tenant.as_str()).map_err(|e| {
+                CliError::General(format!("invalid tenant ID for HTTP header: {e}"))
+            })?;
+            headers.insert("X-Tenant-ID", value);
+        }
+
+        if let Some(token) = &self.token {
+            let bearer = format!("Bearer {token}");
+            let value = HeaderValue::from_str(&bearer).map_err(|e| {
+                CliError::General(format!("invalid token for HTTP header: {e}"))
+            })?;
+            headers.insert("Authorization", value);
+        }
+
+        Ok(headers)
+    }
+
+    /// Map an HTTP status code to a CliError variant (AC-7).
+    pub fn map_http_status(status: u16, body: &str) -> CliError {
+        match status {
+            401 => CliError::AuthenticationExpired,
+            403 => CliError::Unauthorized(body.to_string()),
+            404 => CliError::NotFound(body.to_string()),
+            429 => CliError::RateLimited,
+            500..=599 => CliError::ServerError(status, body.to_string()),
+            _ => CliError::General(format!("unexpected HTTP status: {status}")),
+        }
+    }
+}
