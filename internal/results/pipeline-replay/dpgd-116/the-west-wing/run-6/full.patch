+// ============================================================
+// Security: CWE-209 — Error messages must not expose internal details
+// ============================================================
+
+/// CliError Display should NOT expose server internal details in user-facing output.
+/// Internal details are for logs only (SOUL.md principle #5).
+#[test]
+fn cli_error_display_does_not_expose_internal_paths() {
+    let err = CliError::ServerError("internal server error at /api/v1/internal/debug".into());
+    let display = err.to_string();
+    // User-facing display should be generic, not leak internal paths
+    // The raw internal message should be logged, not displayed
+    assert!(
+        !display.contains("/api/v1/internal/debug"),
+        "CWE-209: CliError Display should not expose internal server paths to users, got: {display}"
+    );
+}
+
+/// CliError from HTTP 500 should give a generic message, not echo the server response body.
+#[test]
+fn cli_error_from_5xx_does_not_echo_response_body() {
+    let err = CliError::from_http_status(500, "stack trace: at line 42 in auth.rs");
+    let display = err.to_string();
+    assert!(
+        !display.contains("stack trace") && !display.contains("auth.rs"),
+        "CWE-209: ServerError should not echo raw server response to user, got: {display}"
+    );
+}
