@@ -0,0 +1,118 @@
+//! Client configuration: TOML loading, env var overrides, XDG paths.
+//!
+//! Config precedence: CLI flags > env vars > config file > defaults.
+//! Tokens are NOT stored in config — they go in OS keychain.
+
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+/// Raw config for deserialization — validates via TryFrom before becoming ClientConfig.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RawClientConfig {
+    server_url: String,
+    timeout_seconds: u64,
+}
+
+/// Client configuration loaded from ~/.config/axiathon/cli.toml.
+///
+/// Fields are private with getters to enforce validation invariants.
+/// Deserialization routes through `RawClientConfig` + `TryFrom` to ensure
+/// server_url is non-empty and timeout_seconds is positive.
+#[derive(Debug, Deserialize)]
+#[serde(try_from = "RawClientConfig")]
+pub struct ClientConfig {
+    server_url: String,
+    timeout_seconds: u64,
+}
+
+impl TryFrom<RawClientConfig> for ClientConfig {
+    type Error = String;
+
+    fn try_from(raw: RawClientConfig) -> Result<Self, Self::Error> {
+        if raw.server_url.is_empty() {
+            return Err("server_url cannot be empty".into());
+        }
+        if raw.timeout_seconds == 0 {
+            return Err("timeout_seconds must be greater than 0".into());
+        }
+        Ok(Self {
+            server_url: raw.server_url,
+            timeout_seconds: raw.timeout_seconds,
+        })
+    }
+}
+
+impl ClientConfig {
+    /// Get the server URL.
+    pub fn server_url(&self) -> &str {
+        &self.server_url
+    }
+
+    /// Get the timeout in seconds.
+    pub fn timeout_seconds(&self) -> u64 {
+        self.timeout_seconds
+    }
+
+    /// Default config file path using dirs crate (XDG convention).
+    pub fn default_path() -> PathBuf {
+        dirs::config_dir()
+            .unwrap_or_else(|| PathBuf::from(".config"))
+            .join("axiathon")
+            .join("cli.toml")
+    }
+
+    /// Load config from a specific file path.
+    pub fn load_from_path(path: &Path) -> Result<Self, crate::error::CliError> {
+        let content = std::fs::read_to_string(path)
+            .map_err(|e| crate::error::CliError::Config(format!("failed to read config: {e}")))?;
+        toml::from_str(&content)
+            .map_err(|e| crate::error::CliError::Config(format!("invalid config: {e}")))
+    }
+
+    /// Create config from explicit values.
+    pub fn from_values(server_url: &str, timeout_seconds: u64) -> Self {
+        Self {
+            server_url: server_url.to_string(),
+            timeout_seconds,
+        }
+    }
+
+    /// Apply env var overrides to this config (mutating).
+    pub fn apply_env_overrides(&mut self, server_url: &str, timeout: Option<u64>) {
+        self.server_url = server_url.to_string();
+        if let Some(t) = timeout {
+            self.timeout_seconds = t;
+        }
+    }
+
+    /// Apply env var overrides, returning a new config.
+    pub fn with_env_override(mut self, server_url: &str, timeout: Option<u64>) -> Self {
+        self.server_url = server_url.to_string();
+        if let Some(t) = timeout {
+            self.timeout_seconds = t;
+        }
+        self
+    }
+
+    /// Apply CLI flag overrides, returning a new config.
+    pub fn with_cli_override(mut self, server_url: Option<&str>, timeout: Option<u64>) -> Self {
+        if let Some(url) = server_url {
+            self.server_url = url.to_string();
+        }
+        if let Some(t) = timeout {
+            self.timeout_seconds = t;
+        }
+        self
+    }
+}
+
+impl Default for ClientConfig {
+    fn default() -> Self {
+        Self {
+            server_url: "http://localhost:8080".to_string(),
+            timeout_seconds: 30,
+        }
+    }
+}
