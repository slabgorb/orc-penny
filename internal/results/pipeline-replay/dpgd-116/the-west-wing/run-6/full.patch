@@ -0,0 +1,85 @@
+//! CLI error types with exit code mapping.
+//!
+//! Each variant maps to a specific exit code:
+//! - 0: success (no error)
+//! - 1: general error
+//! - 2: usage error
+//! - 3: authentication failure
+//! - 4: authorization failure
+
+use thiserror::Error;
+
+/// CLI error type. Maps HTTP status codes and operational errors to exit codes.
+///
+/// **SECURITY:** Display output is for user-facing stderr. Do NOT include
+/// internal server details, stack traces, or raw response bodies. Log those
+/// separately via tracing. The String payload in ServerError is for internal
+/// logging only — Display deliberately outputs a generic message.
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum CliError {
+    #[error("not found: {0}")]
+    NotFound(String),
+
+    /// Internal detail in the String is for logging only — Display is generic.
+    #[error("server error")]
+    ServerError(String),
+
+    #[error("connection timed out")]
+    ConnectionTimeout,
+
+    #[error("server unavailable")]
+    ServerUnavailable,
+
+    #[error("rate limited — retry later")]
+    RateLimited,
+
+    #[error("authentication expired — run 'axiathon login'")]
+    AuthenticationExpired,
+
+    #[error("unauthorized: {0}")]
+    Unauthorized(String),
+
+    #[error("usage error: {0}")]
+    Usage(String),
+
+    #[error("config error: {0}")]
+    Config(String),
+
+    #[error("not yet implemented: {0}")]
+    NotImplemented(String),
+}
+
+impl CliError {
+    /// Map this error to a process exit code.
+    pub fn exit_code(&self) -> i32 {
+        match self {
+            Self::AuthenticationExpired => 3,
+            Self::Unauthorized(_) => 4,
+            Self::Usage(_) => 2,
+            Self::NotFound(_)
+            | Self::ServerError(_)
+            | Self::ConnectionTimeout
+            | Self::ServerUnavailable
+            | Self::RateLimited
+            | Self::Config(_)
+            | Self::NotImplemented(_) => 1,
+        }
+    }
+
+    /// Map an HTTP status code to a CliError variant.
+    ///
+    /// **SECURITY (CWE-209):** The response body is NOT included in user-facing
+    /// error messages. Server internals (stack traces, paths) must not leak to
+    /// operators. The body parameter is available for structured logging only.
+    pub fn from_http_status(status: u16, _body: &str) -> Self {
+        match status {
+            401 => Self::AuthenticationExpired,
+            403 => Self::Unauthorized("insufficient permissions".into()),
+            404 => Self::NotFound("resource not found".into()),
+            429 => Self::RateLimited,
+            500..=599 => Self::ServerError("server encountered an error".into()),
+            _ => Self::ServerError(format!("unexpected HTTP status: {status}")),
+        }
+    }
+}
