@@ -0,0 +1,84 @@
+//! CLI argument parsing with clap 4.x derive macros.
+//!
+//! Top-level `Cli` struct and `Commands` enum define the command structure.
+//! All global flags use `global = true` so they work with any subcommand.
+
+use clap::{Parser, Subcommand};
+
+use crate::output::OutputFormat;
+
+/// Axiathon CLI — operator command-line interface.
+#[derive(Debug, Parser)]
+#[command(name = "axiathon", about = "Axiathon SIEM operator CLI")]
+pub struct Cli {
+    /// Output format
+    #[arg(long, global = true, default_value = "table")]
+    pub format: OutputFormat,
+
+    /// Increase verbosity (-v, -vv, -vvv)
+    #[arg(short, long, action = clap::ArgAction::Count, global = true)]
+    pub verbose: u8,
+
+    /// Suppress output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL (overrides config and AXIATHON_SERVER env var)
+    #[arg(long, global = true, env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Path to config file (default: ~/.config/axiathon/cli.toml)
+    #[arg(long, global = true)]
+    pub config: Option<String>,
+
+    /// Disable ANSI color output
+    #[arg(long, global = true)]
+    pub no_color: bool,
+
+    #[command(subcommand)]
+    pub command: Commands,
+}
+
+/// Available command groups. Uses plural nouns per architecture doc.
+#[derive(Debug, Subcommand)]
+#[non_exhaustive]
+pub enum Commands {
+    /// Run OCSF queries
+    #[command(after_help = "Examples:\n  axiathon query run 'SELECT * FROM events LIMIT 10'\n  axiathon query run --format json 'SELECT src_ip FROM events'")]
+    Query,
+    /// Manage detection rules
+    #[command(after_help = "Examples:\n  axiathon rules list\n  axiathon rules enable RULE-001\n  axiathon rules export --format json")]
+    Rules,
+    /// Manage and triage alerts
+    #[command(after_help = "Examples:\n  axiathon alerts list --severity high\n  axiathon alerts acknowledge ALERT-001\n  axiathon alerts export --format csv")]
+    Alerts,
+    /// Control ingestion pipelines
+    #[command(after_help = "Examples:\n  axiathon ingest status\n  axiathon ingest pause --source syslog")]
+    Ingest,
+    /// Manage CLI and server configuration
+    #[command(after_help = "Examples:\n  axiathon config show\n  axiathon config set server_url https://api.example.com")]
+    Config,
+    /// Check system and component status
+    #[command(after_help = "Examples:\n  axiathon status\n  axiathon status --component ingestion")]
+    Status,
+    /// Manage tenants
+    #[command(after_help = "Examples:\n  axiathon tenant list\n  axiathon tenant show TENANT-001")]
+    Tenant,
+    /// Authenticate with the server
+    #[command(after_help = "Examples:\n  axiathon login\n  axiathon login --server https://api.example.com")]
+    Login,
+    /// End the current session
+    Logout,
+    /// Launch the terminal UI
+    Tui,
+    /// Generate shell completions
+    #[command(after_help = "Examples:\n  axiathon completion bash > ~/.bash_completion.d/axiathon\n  axiathon completion zsh > ~/.zfunc/_axiathon")]
+    Completion,
+    /// First-time setup
+    #[command(after_help = "Examples:\n  axiathon init\n  axiathon init --server https://api.example.com")]
+    Init,
+}
diff --git a/crates/axiathon-client/src/client.rs b/crates/axiathon-client/src/client.rs
new file mode 100644
index 0000000..e2d02dc
--- /dev/null
+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,76 @@
+//! SiemClient HTTP wrapper.
+//!
+//! Wraps reqwest::Client to inject tenant and auth headers on every request.
+//! Maps HTTP status codes to CliError variants.
+
+use reqwest::header::{HeaderMap, HeaderValue};
+
+/// HTTP client wrapper for Axiathon API communication.
+/// Injects X-Tenant-ID and Authorization headers on all requests.
+/// Token is stored privately — accessible only through header injection.
+pub struct SiemClient {
+    base_url: String,
+    tenant: Option<String>,
+    token: Option<String>,
+    _inner: reqwest::Client,
+}
+
+impl SiemClient {
+    /// Create a new SiemClient. Does not validate header values.
+    /// Use `try_new` for untrusted input.
+    pub fn new(base_url: &str, tenant: Option<&str>, token: Option<&str>) -> Self {
+        Self {
+            base_url: base_url.to_string(),
+            tenant: tenant.map(String::from),
+            token: token.map(String::from),
+            _inner: reqwest::Client::new(),
+        }
+    }
+
+    /// Create a new SiemClient with header value validation.
+    /// Rejects values containing CRLF sequences (CWE-113: Improper
+    /// Neutralization of CRLF Sequences in HTTP Headers).
+    pub fn try_new(
+        base_url: &str,
+        tenant: Option<&str>,
+        token: Option<&str>,
+    ) -> Result<Self, crate::error::CliError> {
+        if let Some(t) = tenant {
+            if t.contains('\r') || t.contains('\n') {
+                return Err(crate::error::CliError::Config(
+                    "tenant ID contains invalid CRLF characters".into(),
+                ));
+            }
+        }
+        if let Some(t) = token {
+            if t.contains('\r') || t.contains('\n') {
+                return Err(crate::error::CliError::Config(
+                    "auth token contains invalid CRLF characters".into(),
+                ));
+            }
+        }
+        Ok(Self::new(base_url, tenant, token))
+    }
+
+    /// Get the base URL.
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    /// Build default headers including tenant and auth.
+    pub fn default_headers(&self) -> HeaderMap {
+        let mut headers = HeaderMap::new();
+        if let Some(tenant) = &self.tenant {
+            if let Ok(val) = HeaderValue::from_str(tenant) {
+                headers.insert("X-Tenant-ID", val);
+            }
+        }
+        if let Some(token) = &self.token {
+            let bearer = format!("Bearer {token}");
+            if let Ok(val) = HeaderValue::from_str(&bearer) {
+                headers.insert(reqwest::header::AUTHORIZATION, val);
+            }
+        }
+        headers
+    }
+}
