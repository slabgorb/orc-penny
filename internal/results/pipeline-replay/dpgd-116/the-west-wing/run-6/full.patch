@@ -0,0 +1,96 @@
+//! Output formatting: table, JSON, CSV.
+//!
+//! `OutputFormatter` provides consistent formatting across all command groups.
+//! Table is default for TTY, JSON for piped output.
+
+use std::io::IsTerminal;
+
+use clap::ValueEnum;
+
+/// Output format selection.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, ValueEnum)]
+pub enum OutputFormat {
+    Table,
+    Json,
+    Csv,
+}
+
+impl OutputFormat {
+    /// Detect the appropriate default format based on terminal status.
+    /// Returns Table for TTY, Json for piped output.
+    pub fn detect() -> Self {
+        if std::io::stdout().is_terminal() {
+            Self::Table
+        } else {
+            Self::Json
+        }
+    }
+}
+
+/// Formats command output in the selected format.
+pub struct OutputFormatter {
+    format: OutputFormat,
+    no_color: bool,
+}
+
+impl OutputFormatter {
+    pub fn new(format: OutputFormat, no_color: bool) -> Self {
+        Self { format, no_color }
+    }
+
+    /// Get the output format.
+    pub fn format(&self) -> OutputFormat {
+        self.format
+    }
+
+    /// Format tabular data as a table string using comfy-table.
+    pub fn format_table(&self, headers: &[&str], rows: &[Vec<String>]) -> String {
+        use comfy_table::Table;
+
+        let mut table = Table::new();
+        if self.no_color {
+            table.force_no_tty();
+        }
+        table.set_header(headers);
+        for row in rows {
+            table.add_row(row);
+        }
+        table.to_string()
+    }
+
+    /// Format data as JSON with ResponseMetadata (request_id, timestamp, api_version).
+    pub fn format_json(&self, data: &serde_json::Value) -> String {
+        use std::time::{SystemTime, UNIX_EPOCH};
+
+        let timestamp = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_secs();
+
+        let wrapper = serde_json::json!({
+            "data": data,
+            "metadata": {
+                "request_id": format!("req-{timestamp}"),
+                "timestamp": timestamp,
+                "api_version": "v1"
+            }
+        });
+        serde_json::to_string_pretty(&wrapper).unwrap_or_default()
+    }
+
+    /// Format tabular data as CSV with headers and proper escaping.
+    pub fn format_csv(&self, headers: &[&str], rows: &[Vec<String>]) -> String {
+        let mut writer = csv::Writer::from_writer(vec![]);
+        writer
+            .write_record(headers)
+            .expect("CSV header write should not fail");
+        for row in rows {
+            writer
+                .write_record(row)
+                .expect("CSV row write should not fail");
+        }
+        writer.flush().expect("CSV flush should not fail");
+        String::from_utf8(writer.into_inner().expect("CSV inner should not fail"))
+            .expect("CSV should be valid UTF-8")
+    }
+}
diff --git a/crates/axiathon-client/tests/cli_structure_tests.rs b/crates/axiathon-client/tests/cli_structure_tests.rs
new file mode 100644
index 0000000..c8a5941
--- /dev/null
+++ b/crates/axiathon-client/tests/cli_structure_tests.rs
@@ -0,0 +1,417 @@
+//! Tests for CLI command structure, help rendering, global flags, shell completion, and stubs.
+//!
+//! Covers:
+//! - AC-1: Top-level command groups
+//! - AC-2: Subcommand help rendering
+//! - AC-5: Global flags
+//! - AC-6: Clap derive macros (declarative only)
+//! - AC-9: Shell completion generation
+//! - AC-10: Stub handlers
+//!
+//! Rule enforcement:
+//! - #2 non_exhaustive on public enums that will grow
+//! - #9 private fields on security-critical types
+
+// These imports verify the public API surface of axiathon-client.
+// They will fail to compile until the types are defined and exported.
+use axiathon_client::cli::{Cli, Commands};
+use axiathon_client::error::CliError;
+
+use clap::Parser;
+
+// ============================================================
+// AC-1: Top-level command groups
+// ============================================================
+
+/// `axiathon --help` must list all expected command groups.
+/// Architecture doc specifies plural nouns: rules, alerts (not rule, alert).
+#[test]
+fn cli_has_all_command_groups() {
+    // We test the Commands enum variants by attempting to parse each subcommand.
+    let expected_commands = [
+        "query", "rules", "alerts", "ingest", "config", "status", "tenant", "login", "logout",
+        "tui", "completion", "init",
+    ];
+    // Verify each variant exists in the Commands enum by attempting to parse
+    // each as a subcommand. This is a structural test — it catches missing variants.
+    for cmd in expected_commands {
+        let result = Cli::try_parse_from(["axiathon", cmd]);
+        assert!(
+            result.is_ok() || result.as_ref().unwrap_err().kind() != clap::error::ErrorKind::InvalidSubcommand,
+            "Command group '{cmd}' should be recognized as a valid subcommand, got: {:?}",
+            result.unwrap_err()
+        );
+    }
+}
+
+/// Verify `server` commands are NOT in the client binary (they belong to axiathon-server).
+#[test]
+fn cli_does_not_have_server_commands() {
+    let result = Cli::try_parse_from(["axiathon", "server"]);
+    assert!(
+        result.is_err(),
+        "'server' should NOT be a valid subcommand in the client binary"
+    );
+    assert_eq!(
+        result.unwrap_err().kind(),
+        clap::error::ErrorKind::InvalidSubcommand,
+        "'server' should be an InvalidSubcommand error"
+    );
+}
+
+/// Commands use plural nouns per architecture doc.
+#[test]
+fn cli_uses_plural_noun_commands() {
+    // "rules" not "rule"
+    let rules_result = Cli::try_parse_from(["axiathon", "rules"]);
+    let rule_result = Cli::try_parse_from(["axiathon", "rule"]);
+    assert!(
+        rule_result.is_err(),
+        "'rule' (singular) should NOT be valid — use 'rules'"
+    );
+    // "rules" should be valid or at least not InvalidSubcommand
+    assert!(
+        rules_result.is_ok()
+            || rules_result.as_ref().unwrap_err().kind() != clap::error::ErrorKind::InvalidSubcommand,
+        "'rules' should be a recognized command"
+    );
+
+    // "alerts" not "alert"
+    let alerts_result = Cli::try_parse_from(["axiathon", "alerts"]);
+    let alert_result = Cli::try_parse_from(["axiathon", "alert"]);
+    assert!(
+        alert_result.is_err(),
+        "'alert' (singular) should NOT be valid — use 'alerts'"
+    );
+    assert!(
+        alerts_result.is_ok()
+            || alerts_result.as_ref().unwrap_err().kind() != clap::error::ErrorKind::InvalidSubcommand,
+        "'alerts' should be a recognized command"
+    );
+}
+
+// ============================================================
+// AC-2: Subcommand help rendering
+// ============================================================
+
+/// Every command group must render --help without panic.
+/// Each should show help text and not produce an error.
+#[test]
+fn all_subcommand_help_renders_without_panic() {
+    let commands = [
+        "query", "rules", "alerts", "ingest", "config", "status", "tenant", "login",
+        "completion", "init",
+    ];
+    for cmd in commands {
+        let result = Cli::try_parse_from(["axiathon", cmd, "--help"]);
+        // clap returns ErrorKind::DisplayHelp when --help is passed
+        match result {
+            Ok(_) => {} // Some commands may parse --help as a flag
+            Err(e) => {
+                assert_eq!(
+                    e.kind(),
+                    clap::error::ErrorKind::DisplayHelp,
+                    "'{cmd} --help' should display help, not error: {e}"
+                );
+            }
+        }
+    }
+}
+
+/// Subcommand help should include usage examples via after_help.
+#[test]
+fn subcommand_help_includes_examples() {
+    let commands = ["query", "rules", "alerts", "status"];
+    for cmd in commands {
+        let result = Cli::try_parse_from(["axiathon", cmd, "--help"]);
+        if let Err(e) = result {
+            let help_text = e.to_string();
+            assert!(
+                help_text.contains("Example") || help_text.contains("example") || help_text.contains("EXAMPLES"),
+                "'{cmd} --help' should include usage examples (after_help), got:\n{help_text}"
+            );
+        }
+    }
+}
+
+// ============================================================
+// AC-5: Global flags
+// ============================================================
+
+/// --format flag accepts table, json, csv.
+#[test]
+fn global_format_flag_accepts_valid_values() {
+    for fmt in ["table", "json", "csv"] {
+        let result = Cli::try_parse_from(["axiathon", "--format", fmt, "status"]);
+        assert!(
+            result.is_ok(),
+            "--format {fmt} should be accepted, got: {:?}",
+            result.unwrap_err()
+        );
+    }
+}
+
+/// --format rejects invalid values.
+#[test]
+fn global_format_flag_rejects_invalid_value() {
+    let result = Cli::try_parse_from(["axiathon", "--format", "xml", "status"]);
+    assert!(result.is_err(), "--format xml should be rejected");
+}
+
+/// -v is repeatable for verbosity levels (-v, -vv, -vvv).
+#[test]
+fn verbose_flag_is_repeatable() {
+    let cli = Cli::parse_from(["axiathon", "-v", "status"]);
+    assert_eq!(cli.verbose, 1);
+
+    let cli = Cli::parse_from(["axiathon", "-vv", "status"]);
+    assert_eq!(cli.verbose, 2);
+
+    let cli = Cli::parse_from(["axiathon", "-vvv", "status"]);
+    assert_eq!(cli.verbose, 3);
+}
+
+/// --quiet flag suppresses output.
+#[test]
+fn quiet_flag_is_recognized() {
+    let cli = Cli::parse_from(["axiathon", "--quiet", "status"]);
+    assert!(cli.quiet, "--quiet should set quiet to true");
+}
+
+/// --server flag with env var fallback (AXIATHON_SERVER).
+#[test]
+fn server_flag_accepts_url() {
+    let cli = Cli::parse_from(["axiathon", "--server", "https://api.example.com", "status"]);
+    assert_eq!(
+        cli.server.as_deref(),
+        Some("https://api.example.com"),
+        "--server should store the URL"
+    );
+}
+
+/// --server reads from AXIATHON_SERVER env var when not provided on CLI.
+#[test]
+fn server_flag_reads_env_var() {
+    // This test verifies the env var integration exists in the clap definition.
+    // We can't set env vars safely in parallel tests, so we verify the Cli struct
+    // has the server field with env attribute by checking it defaults to None.
+    let cli = Cli::parse_from(["axiathon", "status"]);
+    // Without --server and without env var, should be None
+    assert!(
+        cli.server.is_none(),
+        "server should default to None when not provided"
+    );
+}
+
+/// --tenant flag is global (works before any subcommand).
+#[test]
+fn tenant_flag_is_global() {
+    let cli = Cli::parse_from(["axiathon", "--tenant", "acme-corp", "status"]);
+    assert_eq!(
+        cli.tenant.as_deref(),
+        Some("acme-corp"),
+        "--tenant should be accessible as a global flag"
+    );
+}
+
+/// --config flag overrides default config path.
+#[test]
+fn config_flag_overrides_default_path() {
+    let cli = Cli::parse_from(["axiathon", "--config", "/tmp/custom.toml", "status"]);
+    assert_eq!(
+        cli.config.as_deref(),
+        Some("/tmp/custom.toml"),
+        "--config should store the custom path"
+    );
+}
+
+/// --no-color flag disables ANSI output.
+#[test]
+fn no_color_flag_is_recognized() {
+    let cli = Cli::parse_from(["axiathon", "--no-color", "status"]);
+    assert!(cli.no_color, "--no-color should set no_color to true");
+}
+
+/// Global flags must work with any subcommand (global = true in clap).
+#[test]
+fn global_flags_work_with_any_subcommand() {
+    // All global flags together with a different subcommand
+    let result = Cli::try_parse_from([
+        "axiathon",
+        "--format",
+        "json",
+        "-vv",
+        "--quiet",
+        "--server",
+        "https://example.com",
+        "--tenant",
+        "test-tenant",
+        "--no-color",
+        "query",
+    ]);
+    assert!(
+        result.is_ok(),
+        "All global flags should work with 'query' subcommand, got: {:?}",
+        result.unwrap_err()
+    );
+}
+
+// ============================================================
+// AC-6: Clap derive macros (declarative only)
+// ============================================================
+
+/// Cli struct must derive clap::Parser (compile-time check).
+#[test]
+fn cli_derives_parser() {
+    // This is a compile-time test — if Cli doesn't derive Parser, the import fails.
+    fn assert_parser<T: Parser>() {}
+    assert_parser::<Cli>();
+}
+
+/// Commands enum must derive clap::Subcommand (compile-time check).
+#[test]
+fn commands_derives_subcommand() {
+    fn assert_subcommand<T: clap::Subcommand>() {}
+    assert_subcommand::<Commands>();
+}
+
+// ============================================================
+// AC-9: Shell completion generation
+// ============================================================
+
+/// `axiathon completion bash` should produce valid bash completion script.
+#[test]
+fn completion_bash_generates_script() {
+    use axiathon_client::commands::completion::generate_completion;
+    use clap_complete::Shell;
+
+    let output = generate_completion(Shell::Bash);
+    assert!(
+        !output.is_empty(),
+        "Bash completion script should not be empty"
+    );
+    assert!(
+        output.contains("complete") || output.contains("_axiathon"),
+        "Bash completion should contain shell completion directives"
+    );
+}
+
+/// `axiathon completion zsh` should produce valid zsh completion script.
+#[test]
+fn completion_zsh_generates_script() {
+    use axiathon_client::commands::completion::generate_completion;
+    use clap_complete::Shell;
+
+    let output = generate_completion(Shell::Zsh);
+    assert!(!output.is_empty(), "Zsh completion script should not be empty");
+}
+
+/// `axiathon completion fish` should produce valid fish completion script.
+#[test]
+fn completion_fish_generates_script() {
+    use axiathon_client::commands::completion::generate_completion;
+    use clap_complete::Shell;
+
+    let output = generate_completion(Shell::Fish);
+    assert!(
+        !output.is_empty(),
+        "Fish completion script should not be empty"
+    );
+}
+
+/// `axiathon completion powershell` should produce valid PowerShell completion script.
+#[test]
+fn completion_powershell_generates_script() {
+    use axiathon_client::commands::completion::generate_completion;
+    use clap_complete::Shell;
+
+    let output = generate_completion(Shell::PowerShell);
+    assert!(
+        !output.is_empty(),
+        "PowerShell completion script should not be empty"
+    );
+}
+
+// ============================================================
+// AC-10: Stub handlers
+// ============================================================
+
+/// Unimplemented commands should indicate they are not yet implemented.
+#[test]
+fn stub_handler_returns_not_implemented_message() {
+    use axiathon_client::commands::stubs::handle_stub;
+
+    let result = handle_stub("query");
+    assert!(result.is_err(), "Stub handler should return an error");
+    let err = result.unwrap_err();
+    let msg = err.to_string().to_lowercase();
+    assert!(
+        msg.contains("not yet implemented") || msg.contains("not implemented"),
+        "Stub error should mention 'not yet implemented', got: {msg}"
+    );
+}
+
+/// Stub handlers should reference the implementing story ID.
+#[test]
+fn stub_handler_references_story_id() {
+    use axiathon_client::commands::stubs::handle_stub;
+
+    // Query stub should reference Story 5.5
+    let result = handle_stub("query");
+    let msg = result.unwrap_err().to_string();
+    assert!(
+        msg.contains("Story") || msg.contains("story") || msg.contains("5.5"),
+        "Stub handler should reference the implementing story, got: {msg}"
+    );
+}
+
+/// Stub handlers should map to exit code 1.
+#[test]
+fn stub_handler_maps_to_exit_code_1() {
+    use axiathon_client::commands::stubs::handle_stub;
+
+    let err = handle_stub("query").unwrap_err();
+    // CliError should have an exit_code() method
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "Stub handlers should exit with code 1"
+    );
+}
+
+// ============================================================
+// Rule enforcement: #2 non_exhaustive on Commands enum
+// ============================================================
+
+/// Commands enum should be #[non_exhaustive] since new command groups will be added.
+/// This is a compile-time property — we verify by checking that a wildcard arm is
+/// required when matching. If Commands is non_exhaustive, external crates must
+/// include a wildcard.
+#[test]
+fn commands_enum_is_non_exhaustive() {
+    // If Commands has #[non_exhaustive], this match requires a wildcard arm.
+    // We verify this structurally by ensuring we can construct at least one variant
+    // and that matching works. The actual compile-time enforcement is that downstream
+    // crates cannot exhaustively match without a wildcard.
+    let cli = Cli::try_parse_from(["axiathon", "status"]);
+    assert!(
+        cli.is_ok() || cli.as_ref().unwrap_err().kind() != clap::error::ErrorKind::InvalidSubcommand,
+        "status should be a recognized command variant"
+    );
+}
+
+// ============================================================
+// Rule enforcement: #9 private fields with getters
+// ============================================================
+
+/// CliError fields should not be directly accessible — use methods.
+/// This is a design test: CliError should not expose internal details publicly.
+#[test]
+fn cli_error_has_exit_code_method() {
+    // Verify the exit_code() method exists and returns correct codes
+    let auth_err = CliError::AuthenticationExpired;
+    assert_eq!(auth_err.exit_code(), 3);
+
+    let authz_err = CliError::Unauthorized("no permission".into());
+    assert_eq!(authz_err.exit_code(), 4);
+}
diff --git a/crates/axiathon-client/tests/client_config_tests.rs b/crates/axiathon-client/tests/client_config_tests.rs
new file mode 100644
index 0000000..6404822
--- /dev/null
+++ b/crates/axiathon-client/tests/client_config_tests.rs
@@ -0,0 +1,373 @@
+//! Tests for SiemClient HTTP wrapper and config file loading.
+//!
+//! Covers:
+//! - AC-7: SiemClient with header injection and HTTP error mapping
+//! - AC-8: Config file loading from ~/.config/axiathon/cli.toml
+//!
+//! Rule enforcement:
+//! - #1 silent error swallowing — SiemClient must not use .ok() on HTTP errors
+//! - #5 validated constructors — ClientConfig validates required fields
+//! - #8 Deserialize bypass — ClientConfig with serde must validate on deser
+//! - #9 private fields — SiemClient token/credentials are private
+//! - #10 tenant context — SiemClient injects X-Tenant-ID header
+//! - #11 workspace dependency compliance (tested via Cargo.toml)
+//! - #13 constructor/deserialize consistency for ClientConfig
+
+use axiathon_client::client::SiemClient;
+use axiathon_client::config::ClientConfig;
+use axiathon_client::error::CliError;
+
+// ============================================================
+// AC-7: SiemClient HTTP wrapper
+// ============================================================
+
+/// SiemClient should inject X-Tenant-ID header on requests.
+#[test]
+fn siem_client_injects_tenant_header() {
+    let client = SiemClient::new("https://api.example.com", Some("test-tenant"), None);
+    let headers = client.default_headers();
+    assert_eq!(
+        headers.get("X-Tenant-ID").map(|v| v.to_str().unwrap()),
+        Some("test-tenant"),
+        "SiemClient should inject X-Tenant-ID header"
+    );
+}
+
+/// SiemClient should inject Authorization Bearer header when token is provided.
+#[test]
+fn siem_client_injects_auth_bearer_header() {
+    let client =
+        SiemClient::new("https://api.example.com", None, Some("my-secret-token"));
+    let headers = client.default_headers();
+    assert_eq!(
+        headers.get("Authorization").map(|v| v.to_str().unwrap()),
+        Some("Bearer my-secret-token"),
+        "SiemClient should inject Authorization: Bearer header"
+    );
+}
+
+/// SiemClient should handle missing tenant and token gracefully (no headers).
+#[test]
+fn siem_client_without_tenant_or_token() {
+    let client = SiemClient::new("https://api.example.com", None, None);
+    let headers = client.default_headers();
+    assert!(
+        headers.get("X-Tenant-ID").is_none(),
+        "No X-Tenant-ID when tenant not provided"
+    );
+    assert!(
+        headers.get("Authorization").is_none(),
+        "No Authorization when token not provided"
+    );
+}
+
+/// SiemClient base_url should be stored and accessible.
+#[test]
+fn siem_client_stores_base_url() {
+    let client = SiemClient::new("https://api.example.com", None, None);
+    assert_eq!(client.base_url(), "https://api.example.com");
+}
+
+/// SiemClient should reject header injection attempts in tenant ID.
+/// CWE-113: Improper Neutralization of CRLF Sequences in HTTP Headers.
+#[test]
+fn siem_client_rejects_header_injection_in_tenant() {
+    let malicious_tenant = "evil\r\nX-Injected: true";
+    let result = SiemClient::try_new("https://api.example.com", Some(malicious_tenant), None);
+    assert!(
+        result.is_err(),
+        "CWE-113: SiemClient should reject CRLF injection in tenant ID"
+    );
+}
+
+/// SiemClient should reject header injection attempts in token.
+#[test]
+fn siem_client_rejects_header_injection_in_token() {
+    let malicious_token = "token\r\nX-Injected: true";
+    let result = SiemClient::try_new("https://api.example.com", None, Some(malicious_token));
+    assert!(
+        result.is_err(),
+        "CWE-113: SiemClient should reject CRLF injection in auth token"
+    );
+}
+
+/// SiemClient token field must not be publicly accessible (rule #9).
+/// Token is a credential — it should only be used internally for header injection.
+#[test]
+fn siem_client_token_is_not_directly_accessible() {
+    // This is a design test. SiemClient should NOT have a public `token` field.
+    // The token should only be used through default_headers().
+    // If this test compiles, the getter/field check is structural.
+    let client = SiemClient::new("https://api.example.com", None, Some("secret"));
+    // Verify we can get headers (the intended API) but not the raw token
+    let headers = client.default_headers();
+    assert!(headers.get("Authorization").is_some());
+}
+
+/// SiemClient should map HTTP status codes to CliError correctly.
+#[tokio::test]
+async fn siem_client_maps_http_errors() {
+    // This test verifies the error mapping table from AC-7:
+    // 401 -> AuthenticationExpired
+    // 403 -> Unauthorized
+    // 404 -> NotFound
+    // 429 -> RateLimited
+    // 5xx -> ServerError
+    // timeout -> ConnectionTimeout
+    // connection refused -> ServerUnavailable
+
+    // We test the mapping function directly (no real HTTP needed)
+    assert!(matches!(
+        CliError::from_http_status(401, ""),
+        CliError::AuthenticationExpired
+    ));
+    assert!(matches!(
+        CliError::from_http_status(403, ""),
+        CliError::Unauthorized(_)
+    ));
+    assert!(matches!(
+        CliError::from_http_status(404, ""),
+        CliError::NotFound(_)
+    ));
+    assert!(matches!(
+        CliError::from_http_status(429, ""),
+        CliError::RateLimited
+    ));
+    assert!(matches!(
+        CliError::from_http_status(500, ""),
+        CliError::ServerError(_)
+    ));
+}
+
+// ============================================================
+// AC-8: Config file loading
+// ============================================================
+
+/// ClientConfig should load from a TOML file.
+#[test]
+fn client_config_loads_from_toml_string() {
+    let toml_str = r#"
+        server_url = "https://axiathon.example.com"
+        timeout_seconds = 30
+    "#;
+    let config: ClientConfig =
+        toml::from_str(toml_str).expect("Valid TOML should deserialize to ClientConfig");
+    assert_eq!(config.server_url(), "https://axiathon.example.com");
+    assert_eq!(config.timeout_seconds(), 30);
+}
+
+/// ClientConfig should have sensible defaults.
+#[test]
+fn client_config_has_defaults() {
+    let config = ClientConfig::default();
+    assert!(
+        !config.server_url().is_empty(),
+        "Default server_url should not be empty"
+    );
+    assert!(
+        config.timeout_seconds() > 0,
+        "Default timeout should be positive"
+    );
+}
+
+/// ClientConfig default config path should be ~/.config/axiathon/cli.toml.
+#[test]
+fn client_config_default_path() {
+    let path = ClientConfig::default_path();
+    let path_str = path.to_string_lossy();
+    assert!(
+        path_str.contains("axiathon") && path_str.contains("cli.toml"),
+        "Default config path should be under axiathon dir with cli.toml, got: {path_str}"
+    );
+}
+
+/// ClientConfig should merge env var overrides.
+/// AXIATHON_API_URL should override server_url from config file.
+#[test]
+fn client_config_env_var_overrides_file() {
+    let toml_str = r#"
+        server_url = "https://from-file.example.com"
+        timeout_seconds = 30
+    "#;
+    let mut config: ClientConfig = toml::from_str(toml_str).unwrap();
+    // Simulate env var override
+    config.apply_env_overrides("https://from-env.example.com", None);
+    assert_eq!(
+        config.server_url(),
+        "https://from-env.example.com",
+        "Env var AXIATHON_API_URL should override config file server_url"
+    );
+}
+
+/// AXIATHON_TIMEOUT env var should override timeout from config file.
+#[test]
+fn client_config_timeout_env_override() {
+    let toml_str = r#"
+        server_url = "https://example.com"
+        timeout_seconds = 30
+    "#;
+    let mut config: ClientConfig = toml::from_str(toml_str).unwrap();
+    let current_url = config.server_url().to_string();
+    config.apply_env_overrides(&current_url, Some(60));
+    assert_eq!(
+        config.timeout_seconds(),
+        60,
+        "Env var AXIATHON_TIMEOUT should override config file timeout"
+    );
+}
+
+/// Config file should NOT contain tokens — tokens go in OS keychain.
+/// This test verifies the config schema rejects a token field.
+#[test]
+fn client_config_rejects_token_in_config_file() {
+    let toml_str = r#"
+        server_url = "https://example.com"
+        timeout_seconds = 30
+        token = "this-should-not-be-here"
+    "#;
+    // If ClientConfig uses deny_unknown_fields, this should fail.
+    // If not, the token field should at least be ignored (not stored).
+    let config: Result<ClientConfig, _> = toml::from_str(toml_str);
+    if let Ok(config) = config {
+        // If parsing succeeds, verify token is not accessible
+        // ClientConfig should not have a token() getter
+        let _ = config.server_url(); // Should still work
+        // The key assertion: no token accessor on ClientConfig
+    }
+    // Either way, tokens should never be loaded from the config file
+}
+
+/// ClientConfig should use dirs crate for XDG paths.
+#[test]
+fn client_config_path_uses_xdg_convention() {
+    let path = ClientConfig::default_path();
+    let path_str = path.to_string_lossy();
+    // On Linux/macOS, should be under .config
+    // On macOS specifically, dirs crate uses ~/Library/Application Support
+    // or ~/.config depending on configuration
+    assert!(
+        path_str.contains(".config") || path_str.contains("Application Support"),
+        "Config path should follow XDG convention, got: {path_str}"
+    );
+}
+
+/// Config loading with --config flag should override default path.
+#[test]
+fn client_config_loads_from_custom_path() {
+    use std::io::Write;
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("custom.toml");
+    {
+        let mut f = std::fs::File::create(&config_path).unwrap();
+        writeln!(
+            f,
+            r#"server_url = "https://custom.example.com"
+timeout_seconds = 45"#
+        )
+        .unwrap();
+    }
+    let config = ClientConfig::load_from_path(&config_path)
+        .expect("Should load config from custom path");
+    assert_eq!(config.server_url(), "https://custom.example.com");
+    assert_eq!(config.timeout_seconds(), 45);
+}
+
+/// Config loading should return a useful error for malformed TOML.
+#[test]
+fn client_config_rejects_malformed_toml() {
+    use std::io::Write;
+    let dir = tempfile::tempdir().unwrap();
+    let config_path = dir.path().join("bad.toml");
+    {
+        let mut f = std::fs::File::create(&config_path).unwrap();
+        writeln!(f, "this is not valid = toml {{{{").unwrap();
+    }
+    let result = ClientConfig::load_from_path(&config_path);
+    assert!(
+        result.is_err(),
+        "Malformed TOML should return an error, not silently use defaults"
+    );
+}
+
+/// Config loading should return a useful error for missing file.
+#[test]
+fn client_config_missing_file_returns_error() {
+    let result = ClientConfig::load_from_path(std::path::Path::new("/nonexistent/path/cli.toml"));
+    assert!(
+        result.is_err(),
+        "Missing config file should return an error"
+    );
+}
+
+// ============================================================
+// Rule enforcement: #13 constructor/deserialize consistency
+// ============================================================
+
+/// If ClientConfig validates server_url on construction, deserialization must also validate.
+#[test]
+fn client_config_deserialize_rejects_empty_server_url() {
+    let toml_str = r#"
+        server_url = ""
+        timeout_seconds = 30
+    "#;
+    let result: Result<ClientConfig, _> = toml::from_str(toml_str);
+    assert!(
+        result.is_err(),
+        "Deserializing ClientConfig with empty server_url should fail"
+    );
+}
+
+/// ClientConfig should reject zero or negative timeout.
+#[test]
+fn client_config_deserialize_rejects_zero_timeout() {
+    let toml_str = r#"
+        server_url = "https://example.com"
+        timeout_seconds = 0
+    "#;
+    let result: Result<ClientConfig, _> = toml::from_str(toml_str);
+    assert!(
+        result.is_err(),
+        "Deserializing ClientConfig with timeout_seconds=0 should fail"
+    );
+}
+
+// ============================================================
+// Rule enforcement: Config precedence (CLI > env > file > defaults)
+// ============================================================
+
+/// Verify the config precedence chain: CLI flags > env vars > config file > defaults.
+#[test]
+fn config_precedence_cli_overrides_env_overrides_file() {
+    let file_config = ClientConfig::from_values("https://file.example.com", 30);
+    let env_config = file_config.with_env_override("https://env.example.com", Some(45));
+    let cli_config = env_config.with_cli_override(Some("https://cli.example.com"), Some(60));
+    assert_eq!(
+        cli_config.server_url(),
+        "https://cli.example.com",
+        "CLI flag should take highest precedence"
+    );
+    assert_eq!(
+        cli_config.timeout_seconds(),
+        60,
+        "CLI flag should override env and file timeout"
+    );
+}
+
+// ============================================================
+// Workspace dependency compliance (rule #11)
+// ============================================================
+
+/// Verify axiathon-client Cargo.toml uses workspace = true for shared deps.
+/// This is a structural test — read the Cargo.toml and check.
+#[test]
+fn cargo_toml_uses_workspace_dependencies() {
+    let cargo_toml = include_str!("../Cargo.toml");
+    let shared_deps = ["clap", "serde", "serde_json", "tokio", "thiserror", "tracing"];
+    for dep in shared_deps {
+        assert!(
+            cargo_toml.contains(&format!("{dep} = {{ workspace = true"))
+                || cargo_toml.contains(&format!("{dep} = {{workspace = true")),
+            "Dependency '{dep}' should use {{ workspace = true }} in Cargo.toml"
+        );
+    }
+}
diff --git a/crates/axiathon-client/tests/error_output_tests.rs b/crates/axiathon-client/tests/error_output_tests.rs
new file mode 100644
index 0000000..db788a9
--- /dev/null
+++ b/crates/axiathon-client/tests/error_output_tests.rs
@@ -0,0 +1,361 @@
+//! Tests for exit codes, error mapping, and output formatting.
+//!
+//! Covers:
+//! - AC-3: Exit codes (0/1/2/3/4)
+//! - AC-4: Output formatting (table/json/csv)
+//!
+//! Rule enforcement:
+//! - #1 silent error swallowing — CliError must not use .ok() on user-controlled input
+//! - #2 non_exhaustive on CliError enum
+//! - #5 validated constructors — CliError exit_code() must handle all variants
+//! - #6 test quality — every assertion tests a meaningful property
+
+use axiathon_client::error::CliError;
+use axiathon_client::output::{OutputFormat, OutputFormatter};
+
+// ============================================================
+// AC-3: Exit codes
+// ============================================================
+
+/// Exit code 0 = success (not directly on CliError, but on successful operations).
+#[test]
+fn exit_code_success_is_zero() {
+    // Success is indicated by absence of error — no CliError variant.
+    // This test documents the contract that success = exit(0).
+    // The main.rs dispatches: Ok(()) -> exit(0).
+    assert_eq!(0i32, 0, "Success exit code should be 0 (documented contract)");
+    // The real test is that CliError variants all return non-zero exit codes.
+}
+
+/// Exit code 1 = general error.
+#[test]
+fn exit_code_general_error_is_one() {
+    let errors = [
+        CliError::NotFound("resource".into()),
+        CliError::ServerError("internal".into()),
+        CliError::ConnectionTimeout,
+        CliError::ServerUnavailable,
+    ];
+    for err in &errors {
+        assert_eq!(
+            err.exit_code(),
+            1,
+            "General error '{err}' should have exit code 1"
+        );
+    }
+}
+
+/// Exit code 2 = usage error (clap handles this automatically, but CliError may also).
+#[test]
+fn exit_code_usage_error_is_two() {
+    // clap auto-maps usage errors to exit code 2.
+    // CliError may also have a Usage variant for programmatic usage errors.
+    let err = CliError::Usage("invalid argument combination".into());
+    assert_eq!(err.exit_code(), 2, "Usage error should have exit code 2");
+}
+
+/// Exit code 3 = authentication failure.
+#[test]
+fn exit_code_auth_failure_is_three() {
+    let err = CliError::AuthenticationExpired;
+    assert_eq!(
+        err.exit_code(),
+        3,
+        "AuthenticationExpired should have exit code 3"
+    );
+}
+
+/// Exit code 4 = authorization failure.
+#[test]
+fn exit_code_authz_failure_is_four() {
+    let err = CliError::Unauthorized("insufficient permissions".into());
+    assert_eq!(
+        err.exit_code(),
+        4,
+        "Unauthorized should have exit code 4"
+    );
+}
+
+/// All CliError variants must have an explicit exit_code mapping.
+/// This catches the case where a new variant is added but exit_code() doesn't handle it.
+#[test]
+fn every_cli_error_variant_has_nonzero_exit_code() {
+    let all_errors: Vec<CliError> = vec![
+        CliError::NotFound("test".into()),
+        CliError::ServerError("test".into()),
+        CliError::ConnectionTimeout,
+        CliError::ServerUnavailable,
+        CliError::RateLimited,
+        CliError::AuthenticationExpired,
+        CliError::Unauthorized("test".into()),
+        CliError::Usage("test".into()),
+        CliError::Config("test".into()),
+        CliError::NotImplemented("test".into()),
+    ];
+    for err in &all_errors {
+        let code = err.exit_code();
+        assert!(
+            code > 0 && code <= 4,
+            "CliError '{err}' should have exit code in 1..=4, got {code}"
+        );
+    }
+}
+
+/// CliError must implement Display for stderr output.
+#[test]
+fn cli_error_display_is_meaningful() {
+    let err = CliError::NotFound("tenant abc-123".into());
+    let display = err.to_string();
+    assert!(
+        !display.is_empty(),
+        "CliError Display should produce non-empty output"
+    );
+    // Display should mention what went wrong, not just an error code
+    assert!(
+        display.contains("not found") || display.contains("Not found") || display.contains("tenant"),
+        "CliError::NotFound display should describe the error, got: {display}"
+    );
+}
+
+/// CliError must implement std::error::Error + Send + Sync.
+#[test]
+fn cli_error_implements_error_send_sync() {
+    fn assert_bounds<T: std::error::Error + Send + Sync + 'static>() {}
+    assert_bounds::<CliError>();
+}
+
+/// CliError should print to stderr, not stdout.
+/// This is a behavioral contract — errors go to stderr so piped output is clean.
+#[test]
+fn cli_error_not_implemented_maps_to_exit_code_one() {
+    let err = CliError::NotImplemented("query (Story 5.5)".into());
+    assert_eq!(
+        err.exit_code(),
+        1,
+        "NotImplemented should have exit code 1"
+    );
+}
+
+/// Rate-limited error should map to exit code 1.
+#[test]
+fn cli_error_rate_limited_maps_to_exit_code_one() {
+    let err = CliError::RateLimited;
+    assert_eq!(err.exit_code(), 1, "RateLimited should have exit code 1");
+}
+
+/// Config error should map to exit code 1.
+#[test]
+fn cli_error_config_maps_to_exit_code_one() {
+    let err = CliError::Config("missing server URL".into());
+    assert_eq!(err.exit_code(), 1, "Config error should have exit code 1");
+}
+
+// ============================================================
+// AC-3: CliError HTTP status code mapping (from AC-7)
+// ============================================================
+
+/// HTTP 401 -> CliError::AuthenticationExpired (exit code 3).
+#[test]
+fn http_401_maps_to_authentication_expired() {
+    let err = CliError::from_http_status(401, "Unauthorized");
+    assert!(
+        matches!(err, CliError::AuthenticationExpired),
