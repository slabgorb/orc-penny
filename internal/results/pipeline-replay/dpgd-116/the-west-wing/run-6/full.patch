+    let data = vec![
+        vec!["1".to_string(), "Hello, World".to_string(), "active".to_string()],
+        vec!["2".to_string(), "Foo \"Bar\"".to_string(), "inactive".to_string()],
+    ];
+    let output = formatter.format_csv(&["ID", "Name", "Status"], &data);
+    // First line should be headers
+    let first_line = output.lines().next().expect("CSV should have at least one line");
+    assert!(
+        first_line.contains("ID") && first_line.contains("Name") && first_line.contains("Status"),
