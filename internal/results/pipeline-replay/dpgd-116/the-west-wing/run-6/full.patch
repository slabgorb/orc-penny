+//! Stub handlers for unimplemented commands.
+//!
+//! Each stub returns CliError::NotImplemented with the implementing story reference.
+
+use crate::error::CliError;
+
+/// Handle a stub command that is not yet implemented.
+/// Returns CliError::NotImplemented with the story reference.
+pub fn handle_stub(command: &str) -> Result<(), CliError> {
+    let story = match command {
+        "query" => "Story 5.5",
+        "rules" => "Story 6.4",
+        "alerts" => "Story 6.5",
+        "ingest" => "Story 6.4",
+        "config" => "Story 6.3",
+        "status" => "Story 6.2",
+        "tenant" => "Story 9.1",
+        "login" | "logout" => "Story 9.1",
+        "tui" => "Epic 4",
+        _ => "a future story",
+    };
+    Err(CliError::NotImplemented(format!(
+        "{command} ({story})"
+    )))
+}
