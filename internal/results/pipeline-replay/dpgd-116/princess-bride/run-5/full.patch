index 0000000..76f757a
--- /dev/null
+++ b/crates/axiathon-client/src/client.rs
@@ -0,0 +1,150 @@
+//! SiemClient — HTTP wrapper for communicating with axiathon-server.
+//!
+//! Wraps reqwest::Client with automatic header injection (X-Tenant-ID,
+//! Authorization: Bearer) and HTTP status code to CliError mapping.
+
+use crate::error::CliError;
+
+/// HTTP client wrapper for axiathon-server API communication.
+///
+/// Fields are private to prevent post-construction mutation of
+/// security-critical authentication and tenant isolation data.
+pub struct SiemClient {
+    base_url: String,
+    token: Option<String>,
+    tenant_id: Option<String>,
+    http_client: reqwest::Client,
+}
+
+impl SiemClient {
+    /// Create a new SiemClient targeting the given server URL.
+    ///
+    /// Validates that base_url is non-empty (CWE-20: input validation
+    /// at trust boundary — URL comes from CLI flag, env var, or config).
+    pub fn new(base_url: impl Into<String>) -> Result<Self, CliError> {
+        let base_url = base_url.into();
+        if base_url.is_empty() {
+            return Err(CliError::Config("server URL cannot be empty".into()));
+        }
+        Ok(Self {
+            base_url,
+            token: None,
+            tenant_id: None,
+            http_client: reqwest::Client::new(),
+        })
+    }
+
+    /// Set the authentication token (Bearer).
+    pub fn with_token(mut self, token: impl Into<String>) -> Self {
+        self.token = Some(token.into());
+        self
+    }
+
+    /// Set the tenant ID for X-Tenant-ID header injection.
+    pub fn with_tenant(mut self, tenant_id: impl Into<String>) -> Self {
+        self.tenant_id = Some(tenant_id.into());
+        self
+    }
+
+    /// Get the base URL.
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    /// Get the configured token, if any.
+    pub fn token(&self) -> Option<&str> {
+        self.token.as_deref()
+    }
+
+    /// Get the configured tenant ID, if any.
+    pub fn tenant_id(&self) -> Option<&str> {
+        self.tenant_id.as_deref()
+    }
+
+    /// Build a request with standard headers (Authorization, X-Tenant-ID).
+    fn prepare_request(&self, builder: reqwest::RequestBuilder) -> reqwest::RequestBuilder {
+        let mut req = builder;
+        if let Some(token) = &self.token {
+            req = req.header("Authorization", format!("Bearer {token}"));
+        }
+        if let Some(tenant_id) = &self.tenant_id {
+            req = req.header("X-Tenant-ID", tenant_id.as_str());
+        }
+        req
+    }
+
+    /// Perform a GET request to the given API path.
+    ///
+    /// Injects X-Tenant-ID and Authorization headers automatically.
+    /// Maps HTTP status codes to CliError variants per AC-7.
+    pub async fn get(&self, path: &str) -> Result<serde_json::Value, CliError> {
+        let url = format!("{}{path}", self.base_url);
+        let req = self.prepare_request(self.http_client.get(&url));
+
+        let response = req.send().await.map_err(|e| Self::map_reqwest_error(&e))?;
+        let status = response.status().as_u16();
+        let body = response
+            .text()
+            .await
+            .map_err(|e| CliError::General(format!("failed to read response body: {e}")))?;
+
+        Self::map_status_code(status, &body)?;
+        serde_json::from_str(&body)
+            .map_err(|e| CliError::General(format!("invalid JSON response: {e}")))
+    }
+
+    /// Perform a POST request to the given API path.
+    pub async fn post(
+        &self,
+        path: &str,
+        body: &serde_json::Value,
+    ) -> Result<serde_json::Value, CliError> {
+        let url = format!("{}{path}", self.base_url);
+        let req = self.prepare_request(self.http_client.post(&url).json(body));
+
+        let response = req.send().await.map_err(|e| Self::map_reqwest_error(&e))?;
+        let status = response.status().as_u16();
+        let resp_body = response
+            .text()
+            .await
+            .map_err(|e| CliError::General(format!("failed to read response body: {e}")))?;
+
+        Self::map_status_code(status, &resp_body)?;
+        serde_json::from_str(&resp_body)
+            .map_err(|e| CliError::General(format!("invalid JSON response: {e}")))
+    }
+
+    /// Map an HTTP status code to the appropriate CliError variant.
+    ///
+    /// Per AC-7:
+    /// - 200-299 → Ok
+    /// - 401 → AuthenticationExpired
+    /// - 403 → Unauthorized
+    /// - 404 → NotFound
+    /// - 429 → RateLimited
+    /// - 500-599 → ServerError
+    pub fn map_status_code(status: u16, body: &str) -> Result<(), CliError> {
+        match status {
+            200..=299 => Ok(()),
+            401 => Err(CliError::AuthenticationExpired),
+            403 => Err(CliError::Unauthorized(body.to_string())),
+            404 => Err(CliError::NotFound(body.to_string())),
+            429 => Err(CliError::RateLimited),
+            500..=599 => Err(CliError::ServerError(body.to_string())),
+            _ => Err(CliError::General(format!(
+                "unexpected HTTP status: {status}"
+            ))),
+        }
+    }
+
+    /// Map reqwest transport errors to CliError variants.
+    fn map_reqwest_error(err: &reqwest::Error) -> CliError {
+        if err.is_timeout() {
+            CliError::ConnectionTimeout
+        } else if err.is_connect() {
+            CliError::ServerUnavailable
+        } else {
+            CliError::General(format!("HTTP request failed: {err}"))
+        }
+    }
+}
