@@ -0,0 +1,73 @@
+//! Client configuration loading from TOML file with env var overrides.
+//!
+//! Config precedence: CLI flags > env vars > config file > defaults.
+//! Tokens are stored in OS keychain, NOT in the config file.
+
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+use crate::error::CliError;
+
+/// Client configuration loaded from ~/.config/axiathon/cli.toml.
+///
+/// Fields are public for deserialization and direct access.
+/// Construction should use `load()` or `default()`.
+/// No token field — tokens belong in OS keychain, not config files.
+#[derive(Debug, Clone, Default, Deserialize)]
+pub struct ClientConfig {
+    /// API server URL
+    pub api_url: Option<String>,
+    /// Request timeout in seconds
+    pub timeout_secs: Option<u64>,
+    /// Default tenant ID
+    pub default_tenant: Option<String>,
+    /// Default output format
+    pub default_format: Option<String>,
+}
+
+impl ClientConfig {
+    /// Load configuration from the given path, or the default path if None.
+    ///
+    /// Applies env var overrides:
+    /// - AXIATHON_API_URL overrides api_url
+    /// - AXIATHON_TIMEOUT overrides timeout_secs
+    pub fn load(path: Option<&Path>) -> Result<Self, CliError> {
+        let config_path = match path {
+            Some(p) => p.to_path_buf(),
+            None => match Self::default_config_path() {
+                Some(p) => p,
+                None => return Ok(Self::default()),
+            },
+        };
+
+        let mut config = if config_path.exists() {
+            let content = std::fs::read_to_string(&config_path)
+                .map_err(|e| CliError::Config(format!("failed to read config: {e}")))?;
+            toml::from_str(&content)
+                .map_err(|e| CliError::Config(format!("invalid TOML: {e}")))?
+        } else {
+            Self::default()
+        };
+
+        // Env var overrides (reading env vars is safe; only set_var/remove_var are unsafe)
+        if let Ok(url) = std::env::var("AXIATHON_API_URL") {
+            config.api_url = Some(url);
+        }
+        if let Ok(timeout) = std::env::var("AXIATHON_TIMEOUT") {
+            if let Ok(secs) = timeout.parse::<u64>() {
+                config.timeout_secs = Some(secs);
+            }
+        }
+
+        Ok(config)
+    }
+
+    /// Returns the default config file path: ~/.config/axiathon/cli.toml
+    ///
+    /// Uses the `dirs` crate for XDG-compliant directory resolution.
+    pub fn default_config_path() -> Option<PathBuf> {
+        dirs::config_dir().map(|d| d.join("axiathon").join("cli.toml"))
+    }
+}
+
