+//! Integration tests for axiathon-client CLI framework.
+//!
+//! Story 6.1: CLI Framework & Structure
+//!
+//! Covers all 10 acceptance criteria and applicable lang-review rules.
+
+use axiathon_client::cli::{Cli, Commands, OutputFormat};
+use axiathon_client::client::SiemClient;
+use axiathon_client::config::ClientConfig;
+use axiathon_client::error::CliError;
+use axiathon_client::output::{DefaultFormatter, OutputFormatter, ResponseMetadata};
+use clap::{CommandFactory, Parser};
+
+// ============================================================
+// AC-1: Top-level command groups
+// ============================================================
+
+#[test]
+fn ac1_help_lists_all_command_groups() {
+    let cmd = Cli::command();
+    let subcommand_names: Vec<&str> = cmd
+        .get_subcommands()
+        .map(clap::Command::get_name)
+        .collect();
+
+    let expected = [
+        "query", "rules", "alerts", "ingest", "config",
+        "status", "tenant", "login", "logout", "tui",
+        "completion", "init",
+    ];
+
+    for name in &expected {
+        assert!(
+            subcommand_names.contains(name),
+            "Missing command group '{name}' in CLI. Found: {subcommand_names:?}"
+        );
+    }
+}
+
+#[test]
+fn ac1_uses_plural_nouns_for_command_groups() {
+    let cmd = Cli::command();
+    let names: Vec<&str> = cmd
+        .get_subcommands()
+        .map(clap::Command::get_name)
+        .collect();
+
+    assert!(names.contains(&"rules"), "Should be 'rules' not 'rule'");
+    assert!(names.contains(&"alerts"), "Should be 'alerts' not 'alert'");
+}
+
+#[test]
+fn ac1_no_server_commands_in_client_binary() {
+    let cmd = Cli::command();
+    let names: Vec<&str> = cmd
+        .get_subcommands()
+        .map(clap::Command::get_name)
+        .collect();
+
+    assert!(
+        !names.contains(&"server"),
+        "Server commands should not be in the client binary"
+    );
+    assert!(
+        !names.contains(&"migrate"),
+        "Migration commands should not be in the client binary"
+    );
+}
+
+#[test]
+fn ac1_parse_query_command() {
+    let cli = Cli::try_parse_from(["axiathon", "query", "run", "src_ip = 10.0.0.1"]);
+    assert!(cli.is_ok(), "Should parse 'axiathon query run <query>': {cli:?}");
