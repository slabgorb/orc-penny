+#[test]
+fn ac2_query_help_has_examples() {
+    let cmd = Cli::command();
+    let query_cmd = cmd
+        .get_subcommands()
+        .find(|sc| sc.get_name() == "query")
+        .expect("query subcommand should exist");
+
+    let after_help = query_cmd
+        .get_after_help()
+        .expect("query should have after_help with examples");
+    let help_text = after_help.to_string();
+    assert!(
+        help_text.contains("Examples"),
+        "query help should contain 'Examples', got: {help_text}"
