+}
+
+#[test]
+fn ac2_rules_help_has_examples() {
+    let cmd = Cli::command();
+    let rules_cmd = cmd
+        .get_subcommands()
+        .find(|sc| sc.get_name() == "rules")
+        .expect("rules subcommand should exist");
+
+    let after_help = rules_cmd
+        .get_after_help()
+        .expect("rules should have after_help with examples");
+    let help_text = after_help.to_string();
+    assert!(
+        help_text.contains("Examples"),
+        "rules help should contain 'Examples', got: {help_text}"
+    );
+}
+
+#[test]
+fn ac2_all_command_groups_have_about_text() {
+    let cmd = Cli::command();
+    for subcmd in cmd.get_subcommands() {
+        let name = subcmd.get_name();
+        if name == "help" {
+            continue;
+        }
+        let about = subcmd.get_about();
+        assert!(
+            about.is_some(),
+            "Command '{name}' should have about text"
+        );
+        assert!(
+            !about.unwrap().to_string().is_empty(),
+            "Command '{name}' about text should not be empty"
+        );
+    }
+}
+
+#[test]
+fn ac2_subcommand_help_does_not_panic() {
+    let subcommands = [
+        "query", "rules", "alerts", "ingest", "config",
+        "status", "tenant", "login", "completion", "init",
+    ];
+    for subcmd in &subcommands {
+        let result = Cli::try_parse_from(["axiathon", subcmd, "--help"]);
+        assert!(
+            result.is_err(),
+            "{subcmd} --help should return DisplayHelp"
+        );
