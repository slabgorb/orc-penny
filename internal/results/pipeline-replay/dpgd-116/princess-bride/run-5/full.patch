+//! Command argument types for all CLI command groups.
+//!
+//! Each command group follows the plural-noun + verb pattern:
+//! `axiathon rules list`, `axiathon alerts acknowledge <id>`.
+
+use clap::{Args, Subcommand};
+use clap_complete::Shell;
+
+// --- Query ---
+
+#[derive(Args, Debug)]
+pub struct QueryArgs {
+    #[command(subcommand)]
+    pub command: Option<QueryCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum QueryCommand {
+    /// Execute a query
+    Run {
+        /// Query string
+        query: String,
+    },
+}
+
+// --- Rules ---
+
+#[derive(Args, Debug)]
+pub struct RulesArgs {
+    #[command(subcommand)]
+    pub command: Option<RulesCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum RulesCommand {
+    /// List all detection rules
+    List,
+    /// Get a specific rule
+    Get {
+        /// Rule ID
+        id: String,
+    },
+}
+
+// --- Alerts ---
+
+#[derive(Args, Debug)]
+pub struct AlertsArgs {
+    #[command(subcommand)]
+    pub command: Option<AlertsCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum AlertsCommand {
+    /// List alerts
+    List,
+    /// Acknowledge an alert
+    Acknowledge {
+        /// Alert ID
+        id: String,
+    },
+}
+
+// --- Ingest ---
+
+#[derive(Args, Debug)]
+pub struct IngestArgs {
+    #[command(subcommand)]
+    pub command: Option<IngestCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum IngestCommand {
+    /// Show ingestion status
+    Status,
+    /// Pause a source
+    Pause {
+        /// Source ID
+        id: String,
+    },
+    /// Resume a source
+    Resume {
+        /// Source ID
+        id: String,
+    },
+}
+
+// --- Config ---
+
+#[derive(Args, Debug)]
+pub struct ConfigArgs {
+    #[command(subcommand)]
+    pub command: Option<ConfigCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum ConfigCommand {
+    /// List all configuration values
+    List,
+    /// Get a configuration value
+    Get {
+        /// Config key
+        key: String,
+    },
+    /// Set a configuration value
+    Set {
+        /// Config key
+        key: String,
+        /// Config value
+        value: String,
+    },
+}
+
+// --- Status ---
+
+#[derive(Args, Debug)]
+pub struct StatusArgs {
+    /// Optional component to get detailed status for
+    pub component: Option<String>,
+}
+
+// --- Tenant ---
+
+#[derive(Args, Debug)]
+pub struct TenantArgs {
+    #[command(subcommand)]
+    pub command: Option<TenantCommand>,
+}
+
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum TenantCommand {
+    /// List tenants
+    List,
+    /// Get tenant details
+    Get {
+        /// Tenant ID
+        id: String,
+    },
+}
+
+// --- Login ---
+
+#[derive(Args, Debug)]
+pub struct LoginArgs {
+    /// Server URL to authenticate with
+    #[arg(long)]
+    pub server: Option<String>,
+}
+
+// --- Completion ---
+
+#[derive(Args, Debug)]
+pub struct CompletionArgs {
+    /// Shell to generate completions for
+    pub shell: Shell,
+}
+
+// --- Init ---
+
+#[derive(Args, Debug)]
+pub struct InitArgs {
+    /// Server URL for initial configuration
+    #[arg(long)]
+    pub server: Option<String>,
+}
