+//! Output formatting: table, JSON, and CSV.
+//!
+//! Table is default for TTY, JSON for piped output.
+//! Uses `std::io::IsTerminal` for TTY detection (not deprecated `atty`).
+
+use comfy_table::{ContentArrangement, Table};
+use serde::Serialize;
+
+use crate::cli::OutputFormat;
+use crate::error::CliError;
+
+/// Metadata included in JSON output responses.
+#[derive(Debug, Clone, Serialize)]
+pub struct ResponseMetadata {
+    /// Unique request identifier
+    pub request_id: String,
+    /// ISO 8601 timestamp
+    pub timestamp: String,
+    /// API version string
+    pub api_version: String,
+}
+
+/// Trait for formatting command output in table, JSON, or CSV.
+pub trait OutputFormatter {
+    /// Format data as a human-readable table with ANSI colors.
+    fn format_table(
+        &self,
+        headers: &[&str],
+        rows: &[Vec<String>],
+    ) -> Result<String, CliError>;
+
+    /// Format data as JSON with optional response metadata.
+    fn format_json(
+        &self,
+        data: &serde_json::Value,
+        meta: Option<&ResponseMetadata>,
+    ) -> Result<String, CliError>;
+
+    /// Format data as CSV with headers and proper escaping.
+    fn format_csv(
+        &self,
+        headers: &[&str],
+        rows: &[Vec<String>],
+    ) -> Result<String, CliError>;
+
+    /// Auto-select format based on OutputFormat enum.
+    fn format(
+        &self,
+        data: &serde_json::Value,
+        headers: &[&str],
+        rows: &[Vec<String>],
+        format: &OutputFormat,
+        meta: Option<&ResponseMetadata>,
+    ) -> Result<String, CliError>;
+}
+
+/// Default output formatter implementation.
+///
+/// - Table: comfy-table with dynamic width
+/// - JSON: serde_json with pretty printing and metadata
+/// - CSV: csv crate with proper escaping
+pub struct DefaultFormatter {
+    _private: (),
+}
+
+impl Default for DefaultFormatter {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl DefaultFormatter {
+    /// Create a new DefaultFormatter.
+    pub fn new() -> Self {
+        Self { _private: () }
+    }
+}
+
+impl OutputFormatter for DefaultFormatter {
+    fn format_table(
+        &self,
+        headers: &[&str],
+        rows: &[Vec<String>],
+    ) -> Result<String, CliError> {
+        let mut table = Table::new();
+        table.set_content_arrangement(ContentArrangement::Dynamic);
+        table.set_header(headers);
+        for row in rows {
+            table.add_row(row);
+        }
+        Ok(table.to_string())
+    }
+
+    fn format_json(
+        &self,
+        data: &serde_json::Value,
+        meta: Option<&ResponseMetadata>,
+    ) -> Result<String, CliError> {
+        let mut output = serde_json::Map::new();
+        output.insert("data".to_string(), data.clone());
+        if let Some(meta) = meta {
+            output.insert(
+                "request_id".to_string(),
+                serde_json::Value::String(meta.request_id.clone()),
+            );
+            output.insert(
+                "timestamp".to_string(),
+                serde_json::Value::String(meta.timestamp.clone()),
+            );
+            output.insert(
+                "api_version".to_string(),
+                serde_json::Value::String(meta.api_version.clone()),
+            );
+        }
+        serde_json::to_string_pretty(&output)
+            .map_err(|e| CliError::General(format!("JSON serialization failed: {e}")))
+    }
+
+    fn format_csv(
+        &self,
+        headers: &[&str],
+        rows: &[Vec<String>],
+    ) -> Result<String, CliError> {
+        let mut wtr = csv::Writer::from_writer(Vec::new());
+        wtr.write_record(headers)
+            .map_err(|e| CliError::General(format!("CSV write failed: {e}")))?;
+        for row in rows {
+            wtr.write_record(row)
+                .map_err(|e| CliError::General(format!("CSV write failed: {e}")))?;
+        }
+        let bytes = wtr
+            .into_inner()
+            .map_err(|e| CliError::General(format!("CSV flush failed: {e}")))?;
+        String::from_utf8(bytes)
+            .map_err(|e| CliError::General(format!("CSV encoding failed: {e}")))
+    }
+
+    fn format(
+        &self,
+        data: &serde_json::Value,
+        headers: &[&str],
+        rows: &[Vec<String>],
+        format: &OutputFormat,
+        meta: Option<&ResponseMetadata>,
+    ) -> Result<String, CliError> {
+        match format {
+            OutputFormat::Table => self.format_table(headers, rows),
+            OutputFormat::Json => self.format_json(data, meta),
+            OutputFormat::Csv => self.format_csv(headers, rows),
+        }
+    }
+}
