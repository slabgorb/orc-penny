@@ -0,0 +1,131 @@
+//! CLI argument parsing with clap 4.x derive macros.
+//!
+//! All command groups are defined declaratively using `#[derive(Parser)]`
+//! and `#[derive(Subcommand)]`. No imperative command building.
+
+use clap::{Parser, Subcommand, ValueEnum};
+
+use crate::commands;
+
+/// Output format for tabular data.
+#[derive(Debug, Clone, Copy, ValueEnum)]
+pub enum OutputFormat {
+    /// Human-readable table with ANSI colors
+    Table,
+    /// JSON with response metadata
+    Json,
+    /// CSV with headers
+    Csv,
+}
+
+/// Axiathon SIEM - Security Information and Event Management CLI
+#[derive(Parser, Debug)]
+#[command(
+    name = "axiathon",
+    version,
+    about = "Axiathon SIEM - Security Information and Event Management CLI",
+    long_about = None
+)]
+pub struct Cli {
+    #[command(subcommand)]
+    pub command: Commands,
+
+    /// Increase verbosity (-v, -vv, -vvv)
+    #[arg(short, long, global = true, action = clap::ArgAction::Count)]
+    pub verbose: u8,
+
+    /// Suppress all output
+    #[arg(long, global = true)]
+    pub quiet: bool,
+
+    /// Server URL
+    #[arg(long, global = true, value_name = "URL", env = "AXIATHON_SERVER")]
+    pub server: Option<String>,
+
+    /// Tenant ID for multi-tenant operations
+    #[arg(long, global = true)]
+    pub tenant: Option<String>,
+
+    /// Output format (table, json, csv)
+    #[arg(long, global = true, value_enum, default_value = "table")]
+    pub format: OutputFormat,
+
+    /// Path to config file [default: ~/.config/axiathon/cli.toml]
+    #[arg(long, global = true)]
+    pub config: Option<std::path::PathBuf>,
+
+    /// Disable colored output
+    #[arg(long, global = true)]
+    pub no_color: bool,
+}
+
+/// Top-level command groups following plural-noun + verb pattern.
+#[derive(Subcommand, Debug)]
+#[non_exhaustive]
+pub enum Commands {
+    /// Search and query security events
+    #[command(
+        after_help = "Examples:\n  axiathon query run 'src_ip = 10.0.0.1'\n  axiathon query run --format json 'severity >= high'"
+    )]
+    Query(commands::QueryArgs),
+
+    /// Manage detection rules
+    #[command(
+        after_help = "Examples:\n  axiathon rules list\n  axiathon rules get RULE-001"
+    )]
+    Rules(commands::RulesArgs),
+
+    /// Manage security alerts
+    #[command(
+        after_help = "Examples:\n  axiathon alerts list --severity high\n  axiathon alerts acknowledge ALERT-001"
+    )]
+    Alerts(commands::AlertsArgs),
+
+    /// Control ingestion pipelines
+    #[command(
+        after_help = "Examples:\n  axiathon ingest status\n  axiathon ingest pause source-001"
+    )]
+    Ingest(commands::IngestArgs),
+
+    /// Manage configuration
+    #[command(
+        after_help = "Examples:\n  axiathon config list\n  axiathon config get server.url"
+    )]
+    Config(commands::ConfigArgs),
+
+    /// System status and health checks
+    #[command(
+        after_help = "Examples:\n  axiathon status\n  axiathon status detection"
+    )]
+    Status(commands::StatusArgs),
+
+    /// Manage tenants
+    #[command(
+        after_help = "Examples:\n  axiathon tenant list\n  axiathon tenant get TENANT-001"
+    )]
+    Tenant(commands::TenantArgs),
+
+    /// Authenticate with Axiathon server
+    #[command(
+        after_help = "Examples:\n  axiathon login\n  axiathon login --server https://axiathon.example.com"
+    )]
+    Login(commands::LoginArgs),
+
+    /// End the current session
+    Logout,
+
+    /// Launch terminal user interface
+    Tui,
+
+    /// Generate shell completion scripts
+    #[command(
+        after_help = "Examples:\n  axiathon completion bash > ~/.bash_completion.d/axiathon\n  axiathon completion zsh > ~/.zfunc/_axiathon"
+    )]
+    Completion(commands::CompletionArgs),
+
+    /// First-time setup and configuration
+    #[command(
+        after_help = "Examples:\n  axiathon init\n  axiathon init --server https://axiathon.example.com"
+    )]
+    Init(commands::InitArgs),
+}
