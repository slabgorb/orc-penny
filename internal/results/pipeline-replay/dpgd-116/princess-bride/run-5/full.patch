+    assert!(result.is_err(), "--help should cause clap error (not a real error)");
+    let err = result.unwrap_err();
+    assert_eq!(
+        err.kind(),
+        clap::error::ErrorKind::DisplayHelp,
+        "Should be DisplayHelp, not a real error"
+    );
+}
