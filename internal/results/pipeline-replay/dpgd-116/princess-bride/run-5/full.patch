@@ -0,0 +1,70 @@
+//! CLI error types with exit code mapping.
+
+use thiserror::Error;
+
+/// CLI error type mapping to process exit codes.
+///
+/// **SECURITY:** Display output is for internal logging only. Do not echo
+/// user input back in error messages sent to clients (CWE-209). The Display
+/// impl intentionally includes internal details for debugging.
+#[derive(Debug, Error)]
+#[non_exhaustive]
+pub enum CliError {
+    /// General error (exit code 1)
+    #[error("error: {0}")]
+    General(String),
+
+    /// Authentication expired or invalid (exit code 3)
+    #[error("authentication expired")]
+    AuthenticationExpired,
+
+    /// Authorization failure — insufficient permissions (exit code 4)
+    #[error("unauthorized: {0}")]
+    Unauthorized(String),
+
+    /// Resource not found (exit code 1)
+    #[error("not found: {0}")]
+    NotFound(String),
+
+    /// Rate limited by server (exit code 1)
+    #[error("rate limited")]
+    RateLimited,
+
+    /// Server returned 5xx error (exit code 1)
+    #[error("server error: {0}")]
+    ServerError(String),
+
+    /// Connection timed out (exit code 1)
+    #[error("connection timeout")]
+    ConnectionTimeout,
+
+    /// Server unreachable — connection refused (exit code 1)
+    #[error("server unavailable")]
+    ServerUnavailable,
+
+    /// Configuration error (exit code 1)
+    #[error("config error: {0}")]
+    Config(String),
+
+    /// Command not yet implemented (exit code 1)
+    #[error("not yet implemented (Story {0})")]
+    NotImplemented(String),
+}
+
+impl CliError {
+    /// Map error variants to process exit codes.
+    ///
+    /// Exit codes per architecture spec:
+    /// - 0 = success (no error — not represented here)
+    /// - 1 = general error
+    /// - 2 = usage error (handled by clap, not CliError)
+    /// - 3 = authentication failure
+    /// - 4 = authorization failure
+    pub fn exit_code(&self) -> i32 {
+        match self {
+            Self::AuthenticationExpired => 3,
+            Self::Unauthorized(_) => 4,
+            _ => 1,
+        }
+    }
+}
