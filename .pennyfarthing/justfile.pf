# Pennyfarthing framework recipes — auto-generated by pf init
# DO NOT EDIT — overwritten on every pf init
# Add project recipes to ./justfile instead
#
# Requires `root := justfile_directory()` in the parent justfile.

# Run pf CLI command via the project-local shim
# Usage: just pf doctor, just pf sprint status, just pf settings show
pf *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "{{args}}" ]]; then
        "{{root}}/.pennyfarthing/bin/pf" --help || true
    else
        "{{root}}/.pennyfarthing/bin/pf" {{args}}
    fi

# Start WheelHub server (API + WebSocket + OTEL ingestion)
wheelhub:
    just pf launch wheelhub

# Launch TUI panel viewer (starts WheelHub if needed)
tui:
    just pf launch tui --foreground

# Launch Claude with OTEL pre-configured for WheelHub/BikeRack
claude:
    #!/usr/bin/env bash
    set -euo pipefail

    # Get port from WheelHub (starts it if needed)
    PORT=$(just pf launch wheelhub 2>/dev/null | tail -1)
    if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
        PORT=""
    fi

    if [[ -n "$PORT" ]]; then
        echo "[just claude] OTEL configured → http://localhost:$PORT" >&2
        export CLAUDE_CODE_ENABLE_TELEMETRY="1"
        export OTEL_EXPORTER_OTLP_PROTOCOL="http/json"
        export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:$PORT"
        export OTEL_LOGS_EXPORTER="otlp"
        export OTEL_METRICS_EXPORTER="otlp"
    else
        echo "[just claude] No WheelHub/BikeRack running — launching without OTEL" >&2
        echo "[just claude] Start one first: just wheelhub" >&2
    fi

    exec claude

# Launch tmux dev layout (Claude + TUI in split panes)
# Usage: just tmux-dev [layout] [split]
#   layout: bottom (default), top, right, left — where to place the TUI
#   split:  TUI pane size % (default: 50 for top/bottom, 35 for right/left)
tmux-dev layout="bottom" split="":
    exec "{{root}}/tmux-dev" "{{layout}}" {{split}}

# Launch tmux dev layout for a specific directory
tmux layout="bottom" split="" dir=invocation_directory():
    "{{root}}/tmux-dev" "{{layout}}" {{split}} "{{dir}}"
